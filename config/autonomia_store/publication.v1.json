{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "managedService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "name", "description", "logoUrl", "status"],
      "properties": {
        "id": { "$ref": "#/definitions/uuid" },
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "logoUrl": {
          "type": ["string", "null"],
          "pattern": "^https://",
          "format": "uri"
        },
        "status": { "enum": ["active", "inactive"] }
      }
    },
    "serviceDraftRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "group", "target", "idempotencyKey"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "description": { "type": ["string", "null"], "maxLength": 2000 },
        "logoUrl": {
          "type": ["string", "null"],
          "pattern": "^https://",
          "format": "uri"
        },
        "group": { "enum": ["feature", "agent"] },
        "target": { "$ref": "#/definitions/target" },
        "idempotencyKey": {
          "type": "string",
          "minLength": 12,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9._:-]+$"
        }
      }
    },
    "publicationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "target", "status", "displayOrder"],
      "properties": {
        "group": { "enum": ["feature", "agent"] },
        "target": { "$ref": "#/definitions/target" },
        "status": { "enum": ["active", "inactive"] },
        "displayOrder": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceCatalogItemId",
        "group",
        "target",
        "status",
        "displayOrder"
      ],
      "properties": {
        "serviceCatalogItemId": { "$ref": "#/definitions/uuid" },
        "group": { "enum": ["feature", "agent"] },
        "target": { "$ref": "#/definitions/target" },
        "status": { "enum": ["active", "inactive"] },
        "displayOrder": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    },
    "publicationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "namespace", "publication", "service"],
      "properties": {
        "contractVersion": { "const": 1 },
        "namespace": { "$ref": "#/definitions/namespace" },
        "publication": { "$ref": "#/definitions/publication" },
        "service": { "$ref": "#/definitions/managedService" }
      }
    },
    "serviceDraftResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "namespace", "service"],
      "properties": {
        "contractVersion": { "const": 1 },
        "namespace": { "$ref": "#/definitions/namespace" },
        "service": { "$ref": "#/definitions/managedService" }
      }
    },
    "managedServicesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "namespace", "data"],
      "properties": {
        "contractVersion": { "const": 1 },
        "namespace": { "$ref": "#/definitions/namespace" },
        "data": {
          "type": "array",
          "items": { "$ref": "#/definitions/managedService" }
        }
      }
    }
  }
}
