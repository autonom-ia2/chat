<!DOCTYPE html>
<html lang="<%= I18n.locale.to_s.tr('_', '-') %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= t('tracked_link_kit.title', name: @tracked_link.name) %></title>
  <style>
    :root { color-scheme: light dark; --ink: #14213a; --muted: #5b6b82; --line: #e3e8f0; --bg: #f5f7fb; --card: #fff; --accent: #1f6feb; --navy: #0d2344; }
    @media (prefers-color-scheme: dark) { :root { --ink: #e7ecf5; --muted: #9aa8bd; --line: #26344d; --bg: #0b1324; --card: #121c31; --accent: #6aa5ff; } }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, sans-serif; }
    header { background: var(--navy); color: #fff; padding: 40px 16px 32px; }
    main, header > div { max-width: 760px; margin: 0 auto; }
    main { padding: 24px 16px 64px; display: grid; gap: 16px; }
    h1 { margin: 0 0 8px; font-size: 28px; line-height: 1.2; }
    header p { margin: 0; color: #d3def0; }
    section { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 20px; display: grid; gap: 10px; }
    h2 { margin: 0; font-size: 18px; }
    p { margin: 0; color: var(--muted); }
    ul { margin: 0; padding-left: 20px; }
    pre { margin: 0; max-height: 360px; overflow: auto; background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 14px; font: 12.5px/1.5 ui-monospace, Menlo, monospace; white-space: pre; }
    code { font: 14px ui-monospace, Menlo, monospace; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 2px 8px; }
    button { justify-self: start; min-height: 44px; padding: 0 18px; border: 0; border-radius: 12px; background: var(--accent); color: #fff; font: 600 15px inherit; cursor: pointer; }
    button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  </style>
</head>
<body>
  <header><div>
    <h1><%= t('tracked_link_kit.title', name: @tracked_link.name) %></h1>
    <p><%= t('tracked_link_kit.lead') %></p>
  </div></header>
  <main>
    <section>
      <h2><%= t('tracked_link_kit.origins_title') %></h2>
      <% if @tracked_link.allowed_origins.present? %>
        <ul><% @tracked_link.allowed_origins.each do |origin| %><li><code><%= origin %></code></li><% end %></ul>
        <p><%= t('tracked_link_kit.origins_hint') %></p>
      <% else %>
        <p><%= t('tracked_link_kit.origins_none') %></p>
      <% end %>
    </section>
    <section>
      <h2><%= t('tracked_link_kit.code_title') %></h2>
      <p><%= t('tracked_link_kit.code_hint') %></p>
      <pre id="snippet"><%= @snippet %></pre>
      <button type="button" id="copy" data-copied="<%= t('tracked_link_kit.copied') %>"><%= t('tracked_link_kit.copy') %></button>
    </section>
    <section>
      <h2><%= t('tracked_link_kit.button_title') %></h2>
      <p><%= t('tracked_link_kit.button_hint') %></p>
      <pre><%= %(<a href="#" data-chat2you-whatsapp>#{t('tracked_link_kit.button_label')}</a>) %></pre>
    </section>
    <section>
      <h2><%= t('tracked_link_kit.test_title') %></h2>
      <p><%= t('tracked_link_kit.test_hint') %></p>
    </section>
  </main>
  <script>
    document.getElementById('copy').addEventListener('click', function (event) {
      var button = event.currentTarget;
      navigator.clipboard.writeText(document.getElementById('snippet').textContent).then(function () {
        button.textContent = button.dataset.copied;
      });
    });
  </script>
</body>
</html>
