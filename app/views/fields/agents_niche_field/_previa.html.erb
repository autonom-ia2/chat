<%# #1550 — prévia de uma escolha: como um card fechado (ganho, perdido) aparece para a equipe da conta. Locais: textos
    (do AgentsNicheField#previa), alvo (perfil ou geral) e classe (o :has que mostra esta prévia só na escolha marcada).
    As classes do :has ficam escritas por extenso em _form, para o Tailwind gerá-las. %>
<p class="hidden flex-wrap items-center gap-2 mt-4 mb-0 text-sm text-n-slate-12 <%= classe %>" data-agents-niche-preview="<%= alvo %>">
  <span><%= t('autonomia_agents_niche.preview_label') %></span>
  <span class="px-2 py-0.5 rounded-lg font-medium ring-1 ring-inset ring-n-iris-8 bg-n-iris-2 text-n-iris-11"><%= textos.first %></span>
  <span class="px-2 py-0.5 rounded-lg font-medium ring-1 ring-inset ring-n-slate-7 bg-n-slate-2 text-n-slate-11"><%= textos.last %></span>
</p>
