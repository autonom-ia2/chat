<section class="main-content__body">
  <hr class="my-4 border-n-weak" />
  <% enabled = Autonomia::Agents::Config.redesign_enabled_for?(page.resource) %>
  <%= form_for([:toggle_agents_redesign, namespace, page.resource], method: :post, html: { class: "form" }) do |form| %>
    <div class="form-actions">
      <div class="pb-3">
        <p class="font-medium"><%= t('autonomia.agents.redesign.title') %></p>
        <p><%= t('autonomia.agents.redesign.description') %></p>
      </div>
      <%= hidden_field_tag :enabled, (!enabled).to_s %>
      <%= form.submit(t("autonomia.agents.redesign.#{enabled ? 'disable' : 'enable'}")) %>
    </div>
  <% end %>
</section>
