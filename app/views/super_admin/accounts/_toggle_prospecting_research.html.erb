<section class="main-content__body">
  <hr/>
  <% enabled = Autonomia::Prospecting::Config.research_enabled?(page.resource) %>
  <%= form_for([:toggle_prospecting_research, namespace, page.resource], method: :post, html: { class: "form" }) do |f| %>
    <div class="form-actions">
      <div class="pb-3">
        <p class="font-medium">Prospecting research</p>
        <p>
          Controls company and decision maker research for this account (website enrichment today). It runs on the
          platform keys and only works while Autonomia Prospecting is also enabled.
        </p>
        <p>Current status: <strong><%= enabled ? 'Enabled' : 'Disabled' %></strong></p>
      </div>
      <%= hidden_field_tag :enabled, (!enabled).to_s %>
      <%= f.submit(enabled ? 'Disable Prospecting research' : 'Enable Prospecting research') %>
    </div>
  <% end %>
</section>
