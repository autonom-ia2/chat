#!/bin/bash
# Kit único de demo em tela real (#2140). Roda de dentro da worktree; o painel sobe no m2 ou no m4 (#2965).
# Runbook: docs/runbooks/demo-tela-real.md
#
#   bin/demo maquinas                        mede m2 e m4, lista as demos vivas e diz onde o up subiria (só leitura)
#   bin/demo up <slug>                       escolhe a máquina; snapshot, banco/Redis próprios, seed, Rails + Vite
#   bin/demo sync <slug>                     leva o que mudou na worktree para o snapshot da demo
#   bin/demo flag <slug> <flag> [conta]      liga uma feature flag no banco da demo (conta 1 por padrão)
#   bin/demo seed <slug> <arquivo.rb>        roda um seed próprio (rails runner) no banco da demo
#   bin/demo tunnel <slug>                   comando de túnel (se a demo está no outro Mac) e URL para abrir
#   bin/demo prints <slug> <jornadas.json>   prints por jornada (1440 e 390) em docs/<pasta>/
#   bin/demo psql <slug> "SQL"               roda um SQL no banco da demo, como a role da demo (sem superuser)
#   bin/demo status <slug>                   estado gravado da demo e a máquina onde ela está
#   bin/demo down <slug> [--apagar]          desliga; com --apagar, apaga banco, snapshot e pasta da demo
#
# Antes de qualquer up: perguntar à Orquestração Deploy e esperar o OK. No máximo 1 demo viva, somando m2 e m4.
# Os comandos acham sozinhos a máquina da demo. Para forçar: DEMO_MAQUINA=m2|m4 bin/demo <comando> <slug>.
# Só demo local. Nada aqui fala com produção, AWS ou banco de produção.
set -euo pipefail

# Máquinas que podem receber a demo, na ordem do desempate (#2965). HOST é a máquina da demo deste comando: o up
# escolhe (maquina_do_up) e os outros comandos acham onde a demo está registrada (achar_maquina). AQUI é este Mac.
MAQUINAS=(m2 m4)
HOST=''
AQUI=''
# Limites para subir uma demo (regra do Rodrigo, 12/11/2026), lidos de `maccluster status --json`: carga (load de
# 1 min) abaixo de CARGA_MAX, memória disponível acima de RAM_MIN_GB e swap-out abaixo de SWAP_MAX_MIB_S ("perto de 0").
CARGA_MAX=20
RAM_MIN_GB=3
SWAP_MAX_MIB_S=1
RAIZ_DEMOS=/Users/Shared/chat2you-demos
PREFIXO_SNAPSHOT=/Users/Shared/maccluster-workspaces/chat2you/
KIT=$(cd "${BASH_SOURCE[0]%/*}/../script/demo" && pwd -P) || { echo "bin/demo: não achei script/demo" >&2; exit 1; }
# Portas: Rails 4400-5196 (passo 4), Vite = Rails + 2, Redis 57400-57599. Longe das de teste (55432, 56379)
# e das demos feitas à mão (3301-4025, 56xxx).
FAIXAS=200
BASE_RAILS=4400
BASE_REDIS=57400

uso() { /usr/bin/sed -n '2,18p' "${BASH_SOURCE[0]}" | /usr/bin/cut -c3-; exit 2; }
falha() { echo "bin/demo: $*" >&2; exit 1; }
# em_uso (mesmo arquivo que o no_m2.sh usa na máquina da demo)
# shellcheck source=script/demo/comum.sh
source "$KIT/comum.sh"

validar_slug() {
  local s=$1
  case "$s" in
    '' | *[!a-z0-9-]* | -* | *-) falha "slug inválido '$s': use minúsculas, dígitos e hífen (ex.: 2140-kit)" ;;
  esac
  [ ${#s} -le 30 ] || falha "slug longo demais (máx. 30)"
}

portas() {
  local n
  n=$(printf %s "$1" | /usr/bin/cksum | /usr/bin/awk -v f="$FAIXAS" '{print $1 % f}') || falha "cksum falhou; não sei as portas"
  case "$n" in '' | *[!0-9]*) falha "cksum devolveu '$n'; não sei as portas" ;; esac
  RAILS_PORT=$((BASE_RAILS + n * 4))
  VITE_PORT=$((RAILS_PORT + 2))
  REDIS_PORT=$((BASE_REDIS + n))
}

maquina_valida() {
  local m
  for m in "${MAQUINAS[@]}"; do
    [ "$m" != "$1" ] || return 0
  done
  return 1
}

# Roda um comando de shell na máquina $1: por ssh, ou direto quando ela é este Mac. Neste Mac o ambiente vai limpo,
# como o que o ssh entrega: nenhuma variável da sessão (RAILS_ENV, PG*, DATABASE_URL) entra no kit.
rodar_em() {
  if [ "$1" = "$AQUI" ]; then
    /usr/bin/env -i HOME="$HOME" USER="$USER" LOGNAME="$USER" PATH=/usr/bin:/bin:/usr/sbin:/sbin \
      TMPDIR="${TMPDIR:-/tmp}" /bin/bash -c "$2"
  else
    ssh -o BatchMode=yes "$1" "$2"
  fi
}
remoto() { rodar_em "$HOST" "$1"; }

# O comando vira uma linha só: cada argumento vai escapado com %q para chegar inteiro na máquina da demo.
# DEMO_ONDE diz ao no_m2.sh em qual máquina ele está (só para as mensagens).
no_m2() {
  local comando
  printf -v comando '%q ' /usr/bin/env "DEMO_ONDE=$HOST" /bin/bash "$RAIZ_DEMOS/$slug/kit/no_m2.sh" "$@" ||
    falha "não montei o comando para o $HOST"
  remoto "$comando"
}

# Leva o script/demo desta worktree para a pasta da demo na máquina dela (o kit roda de lá, não do snapshot).
enviar_kit() {
  remoto "/bin/mkdir -p '$RAIZ_DEMOS/$slug/kit'" || falha "não criei a pasta do kit no $HOST"
  /usr/bin/tar -C "$KIT" -cf - . | remoto "/usr/bin/tar -C '$RAIZ_DEMOS/$slug/kit' -xf -" ||
    falha "não levei o kit ao $HOST"
}

# A demo $slug está registrada (demo.env) na máquina $1? Responde "sim", "nao" ou "sem-resposta" (ssh falhou: rede,
# máquina desligada). Erro nunca vira "nao".
registrada_em() {
  local resposta
  if ! resposta=$(rodar_em "$1" "if test -f '$RAIZ_DEMOS/$slug/demo.env'; then echo sim; else echo nao; fi"); then
    echo sem-resposta
    return 0
  fi
  case "$resposta" in
    sim | nao) echo "$resposta" ;;
    *) falha "resposta inesperada do $1: $resposta" ;;
  esac
}

# Acha a máquina onde a demo $slug está registrada e a põe em HOST: a pessoa não precisa lembrar. Com DEMO_MAQUINA,
# só olha essa. Máquina que não responde não vira "não está lá": se a demo não aparecer na outra, o comando para.
achar_maquina() {
  local m resposta achadas='' mudas='' alvos="${DEMO_MAQUINA:-${MAQUINAS[*]}}"
  for m in $alvos; do
    resposta=$(registrada_em "$m") || exit 1
    case "$resposta" in
      sim) achadas="$achadas $m" ;;
      sem-resposta) mudas="$mudas $m" ;;
    esac
  done
  achadas=${achadas# }
  case "$achadas" in
    '')
      [ -z "$mudas" ] || falha "não achei a demo $slug e não consegui falar com:$mudas. Não sei se ela está lá."
      falha "a demo $slug não existe (olhei: $alvos). Rode: bin/demo up $slug"
      ;;
    *' '*) falha "a demo $slug está registrada em mais de uma máquina ($achadas). Diga qual: DEMO_MAQUINA=<máquina>" ;;
  esac
  [ -z "$mudas" ] || echo "bin/demo: aviso: não consegui falar com:$mudas. Sigo com a demo que achei no $achadas." >&2
  HOST=$achadas
}

exigir_demo_registrada() { achar_maquina; }

# Demos vivas na máquina $1, uma por linha: "<slug> <o que está ligado>". Só leitura (script/demo/vivas.sh).
vivas_em() { rodar_em "$1" /bin/bash < "$KIT/vivas.sh"; }

# Todas as demos vivas em VIVAS, uma por linha: "<slug> <máquina> <o que está ligado>". As duas máquinas têm de
# responder: sem isso não dá para afirmar que não há demo viva.
listar_vivas() {
  local m saida
  VIVAS=''
  for m in "${MAQUINAS[@]}"; do
    saida=$(vivas_em "$m" | /usr/bin/awk -v m="$m" 'NF { print $1, m, $2 }') ||
      falha "não consegui ver as demos vivas no $m; sem isso não sei se já há demo ligada. Nada subiu."
    [ -z "$saida" ] || VIVAS+="$saida"$'\n'
  done
}

mostrar_vivas() { printf %s "$1" | /usr/bin/awk '{ printf "  %s no %s (ligado: %s)\n", $1, $2, $3 }'; }

# Mede as máquinas pelo MacCluster. MEDIDA fica com uma linha por máquina, na ordem de MAQUINAS:
#   "<máquina> serve|fora <carga> <memória disponível em GB> <swap-out em MiB/s>"   ou   "<máquina> desligada"
# Campo ausente ou saída estranha para tudo: nunca vira "serve".
medir() {
  local saida
  saida=$(maccluster status --json) || falha "maccluster status falhou; não sei a carga das máquinas"
  MEDIDA=$(printf %s "$saida" | /usr/bin/python3 -I -c 'import json, sys
carga_max, ram_min, swap_max = (float(v) for v in sys.argv[1:4])
nos = json.load(sys.stdin)["nodes"]
for nome in sys.argv[4:]:
    no = nos[nome]
    if not no["online"]:
        print(nome, "desligada")
        continue
    m = no["metrics"]
    carga, ram = float(m["load1"]), float(m["memory_available_gb"])
    swap = float(m["telemetry"]["swapout_rate"]) / 1048576
    serve = carga < carga_max and ram > ram_min and swap < swap_max
    print(nome, "serve" if serve else "fora", f"{carga:.2f}", f"{ram:.1f}", f"{swap:.1f}")
' "$CARGA_MAX" "$RAM_MIN_GB" "$SWAP_MAX_MIB_S" "${MAQUINAS[@]}") ||
    falha "não li a medição das máquinas na saída do MacCluster"
}

# O que foi medido em cada máquina e o limite, em português simples.
descrever_medida() {
  local nome estado carga ram swap
  while read -r nome estado carga ram swap; do
    case "$estado" in
      desligada) echo "  $nome: desligada ou sem rede" ;;
      serve) echo "  $nome: dentro do limite (carga $carga, memória livre $ram GB, swap $swap MiB/s)" ;;
      *) echo "  $nome: FORA do limite (carga $carga, memória livre $ram GB, swap $swap MiB/s)" ;;
    esac
  done <<< "$MEDIDA"
  echo "  limite: carga abaixo de $CARGA_MAX, memória livre acima de $RAM_MIN_GB GB, swap abaixo de $SWAP_MAX_MIB_S MiB/s"
}

# A máquina que serve, entre as de $1 (nomes separados por espaço). Desempate: se mais de uma serve, ganha a que tem
# mais memória livre (foi a memória que travou o M2 em 12/11/2026); empate exato fica com a primeira de MAQUINAS.
# Vazio = nenhuma serve.
melhor_maquina() {
  printf '%s\n' "$MEDIDA" | /usr/bin/awk -v alvos=" $1 " '
    $2 == "serve" && index(alvos, " " $1 " ") && (melhor == "" || $4 + 0 > ram) { melhor = $1; ram = $4 + 0 }
    END { print melhor }'
}

# Define HOST para o up e recusa o que a regra não deixa: outra demo viva (no máximo 1, somando as máquinas) e
# máquina fora do limite. Demo que já existe continua onde está (banco e pasta moram lá); demo nova vai para a
# melhor máquina dentro do limite, ou para a de DEMO_MAQUINA, se ela servir. JA_REGISTRADA: onde a demo já existia.
maquina_do_up() {
  local m resposta outras alvos
  JA_REGISTRADA=''
  for m in "${MAQUINAS[@]}"; do
    resposta=$(registrada_em "$m") || exit 1
    case "$resposta" in
      sim) JA_REGISTRADA="$JA_REGISTRADA $m" ;;
      sem-resposta) falha "não consegui falar com o $m. Sem as duas máquinas não sei se já há demo ligada. Nada subiu." ;;
    esac
  done
  JA_REGISTRADA=${JA_REGISTRADA# }
  case "$JA_REGISTRADA" in
    *' '*) falha "a demo $slug está registrada em mais de uma máquina ($JA_REGISTRADA). Apague a que sobra antes." ;;
  esac
  [ -z "$JA_REGISTRADA" ] || [ -z "${DEMO_MAQUINA:-}" ] || [ "$DEMO_MAQUINA" = "$JA_REGISTRADA" ] ||
    falha "a demo $slug já está no $JA_REGISTRADA; não dá para subi-la no $DEMO_MAQUINA. Use outro slug."
  listar_vivas
  outras=$(printf %s "$VIVAS" | /usr/bin/awk -v s="$slug" '$1 != s') || falha "awk falhou lendo as demos vivas"
  [ -z "$outras" ] || falha "já há demo viva, e o limite é 1 somando ${MAQUINAS[*]}:
$(mostrar_vivas "$outras")
Desligue antes (bin/demo down <slug>) ou combine com a Orquestração Deploy. Nada subiu."
  medir
  alvos=${JA_REGISTRADA:-${DEMO_MAQUINA:-${MAQUINAS[*]}}}
  HOST=$(melhor_maquina "$alvos") || falha "awk falhou escolhendo a máquina"
  [ -n "$HOST" ] || falha "nenhuma máquina dentro do limite para subir a demo agora (podia ser: $alvos):
$(descrever_medida)
Espere a carga baixar e fale com a Orquestração Deploy. Nada subiu."
  echo "máquina da demo $slug: $HOST"
  descrever_medida
}

# Demo em remoção (a máquina da demo já apagou banco e snapshot, falta terminar): só o down --apagar e o status seguem.
em_remocao() {
  local valor
  valor=$(valor_do_estado EM_REMOCAO) || falha "não consegui ler o estado da demo no $HOST"
  case "$valor" in
    sim) return 0 ;;
    nao) return 1 ;;
    *) falha "estado da demo sem EM_REMOCAO (veio '$valor')" ;;
  esac
}
recusar_em_remocao() { if em_remocao; then falha "demo em remoção: rode bin/demo down $slug --apagar"; fi; }

exigir_demo() {
  exigir_demo_registrada
  recusar_em_remocao
}

# Um valor do demo.env da demo. Erro de ssh/awk ou chave ausente sai com 1 (quem chama usa `|| falha`): nunca vira
# valor vazio aceito em silêncio.
valor_do_estado() {
  local saida valor
  saida=$(no_m2 estado "$slug") || falha "não consegui ler o estado da demo no $HOST"
  valor=$(printf '%s\n' "$saida" | /usr/bin/awk -F= -v k="$1" '$1 == k {print substr($0, length(k) + 2)}') ||
    falha "awk falhou lendo o estado da demo"
  [ -n "$valor" ] || falha "estado da demo sem $1"
  printf '%s\n' "$valor"
}

worktree() {
  WT=$(/usr/bin/git rev-parse --show-toplevel) || falha "rode de dentro da worktree"
}

json_campo() { /usr/bin/python3 -I -c 'import json,sys; print(json.load(sys.stdin)[sys.argv[1]])' "$1"; }

# O que nunca vai deste Mac para o outro nem é apagado lá pelo rsync: dependências, caches e logs da demo.
EXCLUIR_RSYNC=(--exclude=/src/node_modules --exclude=/src/tests/playwright/node_modules --exclude=/src/tmp
  --exclude=/src/log --exclude=/src/public/vite-dev --exclude=/src/public/vite-test --exclude=/src/storage
  --exclude=/src/.bundle --exclude=/src/coverage)

# Snapshot neste Mac (--local-only: sem fila de réplica do MacCluster). Se a demo roda aqui, ela usa esse snapshot
# no lugar, sem cópia. Se roda no outro Mac, a cópia vai para lá pelo mesmo caminho: nasce de um clone APFS (cp -c,
# custo ~0) do snapshot chat2you mais recente que já está lá, e o rsync --checksum --delete leva só a diferença.
# Funciona com o outro Mac em "modo remoto", em que o MacCluster não replica snapshot (transferência grande).
# Snapshot criado pelo up e ainda não registrado (demo.env): qualquer saída com erro até o registro o descarta nos
# dois Macs (trap EXIT do cmd_up). Vazio = nada a descartar.
SNAPSHOT_NOVO=''
descartar_snapshot_novo() {
  local codigo=$? snapdir=$SNAPSHOT_NOVO
  SNAPSHOT_NOVO=''
  [ -n "$snapdir" ] && [ "$codigo" -ne 0 ] || return 0
  echo "bin/demo: o up falhou depois do snapshot; descartando $snapdir no $HOST e neste Mac" >&2
  if [ "$HOST" = "$AQUI" ]; then
    apagar_snapshot_local "$snapdir/src"
  elif no_m2 descartar-snapshot "$slug" "$snapdir"; then
    apagar_snapshot_local "$snapdir/src"
  else
    echo "bin/demo: não consegui descartar no $HOST: $HOST:$snapdir (o deste Mac ficou: $snapdir)" >&2
  fi
}

criar_snapshot() {
  local saida snapdir
  echo "snapshot da worktree $WT (só neste Mac, $AQUI) ..."
  saida=$(maccluster workspace snapshot --cwd "$WT" --name chat2you --local-only --json) || falha "snapshot falhou"
  SNAP=$(printf %s "$saida" | json_campo src) || falha "não li o caminho do snapshot na saída do MacCluster"
  case "$SNAP" in */src) ;; *) falha "snapshot em caminho inesperado: $SNAP" ;; esac
  snapdir=${SNAP%/src}
  snapshot_valido "$snapdir"
  # O id do snapshot leva data, hora, HEAD, hash e um uuid: cada chamada cria um diretório novo. Confere que é este.
  /usr/bin/python3 -I -c 'import json,os,sys
m = json.load(open(os.path.join(sys.argv[1], ".maccluster-workspace.json")))
ok = m["snapshot_id"] == os.path.basename(sys.argv[1]) and m["source_path"] == sys.argv[2]
sys.exit(0 if ok else 1)' "$snapdir" "$WT" || falha "o snapshot $snapdir não é desta worktree"
  # Daqui em diante, qualquer falha descarta este snapshot nos dois Macs (descartar_snapshot_novo).
  SNAPSHOT_NOVO=$snapdir
  # Só este usuário abre o snapshot (o rsync -a leva o modo 700 para a cópia do outro Mac).
  /bin/chmod 700 "$snapdir" || falha "não consegui fechar o snapshot em 700: $snapdir"
  echo "snapshot no $AQUI: $snapdir"
  if [ "$HOST" = "$AQUI" ]; then
    echo "a demo roda neste Mac: usa o snapshot no lugar, sem cópia (o pnpm install traz as dependências)"
    return 0
  fi
  no_m2 clonar-base "$slug" "$snapdir" || falha "não consegui preparar a cópia no $HOST"
  echo "rsync da diferença para o $HOST ..."
  local estatisticas
  estatisticas=$(/usr/bin/rsync -a --checksum --delete "${EXCLUIR_RSYNC[@]}" --stats "$snapdir/" "$HOST:$snapdir/") ||
    falha "rsync para o $HOST falhou"
  printf '%s\n' "$estatisticas" | /usr/bin/grep -i 'files transferred\|total transferred\|sent ' || :
  local resto
  resto=$(/usr/bin/rsync -a --checksum --delete "${EXCLUIR_RSYNC[@]}" -n -i "$snapdir/" "$HOST:$snapdir/") ||
    falha "não consegui conferir a cópia no $HOST"
  [ -z "$resto" ] || { echo "$resto" | /usr/bin/head -10; falha "cópia no $HOST diverge do snapshot depois do rsync"; }
  echo "snapshot no $HOST igual ao do $AQUI: $SNAP"
}

cmd_up() {
  worktree
  portas "$slug"
  maquina_do_up
  if [ -n "$JA_REGISTRADA" ]; then
    recusar_em_remocao
    local origem
    origem=$(valor_do_estado ORIGEM) || falha "não li a origem da demo"
    [ "$origem" = "$WT" ] || falha "a demo $slug nasceu de $origem, não desta worktree ($WT). Use outro slug."
    echo "demo $slug já existe: religando (sem snapshot nem banco novos)"
    enviar_kit
  else
    enviar_kit
    no_m2 checar "$slug" "$RAILS_PORT" "$VITE_PORT" "$REDIS_PORT"
    local cabeca
    cabeca=$(/usr/bin/git -C "$WT" rev-parse HEAD) || falha "git rev-parse falhou"
    trap descartar_snapshot_novo EXIT
    criar_snapshot
    gravar_sincronizados "$cabeca"
    no_m2 iniciar "$slug" "$SNAP" "$cabeca" "$WT" "$RAILS_PORT" "$VITE_PORT" "$REDIS_PORT" || falha "não registrei a demo"
    # Registrada: daqui em diante quem apaga é o down --apagar.
    SNAPSHOT_NOVO=''
    trap - EXIT
  fi
  no_m2 preparar "$slug"
  no_m2 subir "$slug"
  cmd_tunnel
}

sensivel() {
  case "$1" in
    .env | .env.* | */.env | */.env.* | *.pem | *.key | *.p12 | *.pfx | .npmrc | */.npmrc | id_* | */id_* | \
      config/credentials/* | config/credentials.yml.enc | \
      .secrets/* | */.secrets/* | *.sqlite* | \
      node_modules/* | */node_modules/* | tmp/* | log/* | public/vite*/* | .claude/* | .codex/*) return 0 ;;
  esac
  return 1
}

# Acrescenta em $2 (NUL) os arquivos que diferem do commit base $1 (alterados, novos, apagados) mais os não
# rastreados. Cada git é conferido à parte (num `{ a; b; }` a falha do primeiro sumiria).
candidatos() {
  /usr/bin/git -C "$WT" diff -z --name-only "$1" >> "$2" || falha "git diff falhou; não sei o que mudou"
  /usr/bin/git -C "$WT" ls-files -z --others --exclude-standard >> "$2" || falha "git ls-files falhou; não sei o que mudou"
}

temporario() {
  TEMPORARIO=$(/usr/bin/mktemp "${TMPDIR:-/tmp}/demo-$1.XXXXXX") || falha "mktemp falhou"
  [ -n "$TEMPORARIO" ] && [ -f "$TEMPORARIO" ] || falha "mktemp não criou o arquivo"
}

# A lista do último sync fica na máquina da demo (NUL): arquivo não rastreado que sumiu da worktree também some da demo.
gravar_sincronizados() {
  local lista
  temporario sincronizados
  lista=$TEMPORARIO
  candidatos "$1" "$lista"
  LC_ALL=C /usr/bin/sort -z -u "$lista" | remoto "/bin/cat > '$RAIZ_DEMOS/$slug/sincronizados.z'" ||
    { /bin/rm -f "$lista"; falha "não gravei a lista do sync no $HOST"; }
  /bin/rm -f "$lista"
}

# Lista anterior. Ausente (1o sync) = vazia; erro de ssh para o comando.
sincronizados_antes() {
  remoto "if test -f '$RAIZ_DEMOS/$slug/sincronizados.z'; then /bin/cat '$RAIZ_DEMOS/$slug/sincronizados.z'; fi" ||
    falha "não li a lista do último sync no $HOST"
}

# O painel (Rails) da demo $slug está ligado na máquina dela? O sync não religa demo desligada: quem liga é o up,
# que mede a máquina antes.
painel_ligado() {
  local saida
  saida=$(vivas_em "$HOST") || falha "não consegui ver se a demo $slug está ligada no $HOST"
  printf '%s\n' "$saida" | /usr/bin/awk -v s="$slug" '$1 == s && index("," $2 ",", ",rails,") { achei = 1 } END { exit !achei }'
}

cmd_sync() {
  exigir_demo
  worktree
  enviar_kit
  local snap base origem
  snap=$(valor_do_estado SNAP) || falha "não li o snapshot da demo"
  base=$(valor_do_estado BASE_SHA) || falha "não li o commit base da demo"
  origem=$(valor_do_estado ORIGEM) || falha "não li a origem da demo"
  [ "$origem" = "$WT" ] || falha "a demo $slug nasceu de $origem, não desta worktree ($WT)"
  local copiar=() apagar=() f lista comando
  temporario sync
  lista=$TEMPORARIO
  # shellcheck disable=SC2064
  trap "/bin/rm -f '$lista'" EXIT
  candidatos "$base" "$lista"
  sincronizados_antes >> "$lista"
  LC_ALL=C /usr/bin/sort -z -u -o "$lista" "$lista" || falha "sort falhou na lista do sync"
  while IFS= read -r -d '' f; do
    [ -n "$f" ] || continue
    if sensivel "$f"; then echo "ignorado (sensível/cache): $f"; continue; fi
    if [ -e "$WT/$f" ]; then copiar+=("$f"); else apagar+=("$f"); fi
  done < "$lista"
  /bin/rm -f "$lista"
  echo "desde ${base:0:10}: copiar ${#copiar[@]}, apagar ${#apagar[@]}"
  for f in "${copiar[@]+"${copiar[@]}"}"; do echo "  + $f"; done
  local migrar=false reiniciar=false pnpm=false vite=false
  for f in "${copiar[@]+"${copiar[@]}"}" "${apagar[@]+"${apagar[@]}"}"; do
    case "$f" in Gemfile | Gemfile.lock) falha "Gemfile mudou: gem nova precisa existir no Ruby do MacCluster. Faça uma demo nova." ;; esac
    case "$f" in db/migrate/* | db/schema.rb) migrar=true ;; esac
    case "$f" in package.json | pnpm-lock.yaml) pnpm=true ;; esac
    # Em padrão de case, * também casa "/": config/*.yml pega config/locales/x.yml.
    case "$f" in *.rb | config/*.yml | config/*.yml.erb | lib/*) reiniciar=true ;; esac
    case "$f" in config/vite.json | vite.config.* | tailwind.config.* | postcss.config.*) vite=true ;; esac
  done
  if [ ${#copiar[@]} -gt 0 ]; then
    /usr/bin/tar -C "$WT" -cf - -- "${copiar[@]}" | remoto "/usr/bin/tar -C '$snap' -xf -" ||
      falha "não copiei os arquivos para o snapshot no $HOST"
  fi
  for f in "${apagar[@]+"${apagar[@]}"}"; do
    printf -v comando '/bin/rm -f %q' "$snap/$f" || falha "não montei o rm de $f"
    remoto "$comando" || falha "não apaguei $f no $HOST"
    echo "  - $f"
  done
  gravar_sincronizados "$base"
  $pnpm && no_m2 pnpm "$slug"
  $migrar && no_m2 migrar "$slug"
  if { $vite || $migrar || $reiniciar; } && ! painel_ligado; then
    echo "a demo está desligada no $HOST: arquivos levados, nada religado. Para ligar: bin/demo up $slug"
    return 0
  fi
  if $vite; then
    echo "config do Vite/Tailwind mudou: reiniciando o Vite"
    no_m2 reiniciar-vite "$slug"
  fi
  if $migrar || $reiniciar; then
    echo "Ruby/config/migration mudou: reiniciando só o Rails"
    no_m2 reiniciar-rails "$slug"
  elif ! $vite; then
    echo "só front: o Vite recarrega sozinho"
  fi
}

cmd_flag() {
  exigir_demo
  enviar_kit
  no_m2 flag "$slug" "${1:?uso: bin/demo flag <slug> <flag> [conta]}" "${2:-1}"
}

cmd_seed() {
  local arquivo=${1:?uso: bin/demo seed <slug> <arquivo.rb>}
  [ -f "$arquivo" ] || falha "arquivo não existe: $arquivo"
  exigir_demo
  enviar_kit
  remoto "/bin/mkdir -p '$RAIZ_DEMOS/$slug/seeds'" || falha "não criei a pasta dos seeds no $HOST"
  local pasta=. nome=${arquivo##*/}
  case "$arquivo" in */*) pasta=${arquivo%/*} ;; esac
  /usr/bin/tar -C "$pasta" -cf - -- "$nome" |
    remoto "/usr/bin/tar -C '$RAIZ_DEMOS/$slug/seeds' -xf -" || falha "não levei o seed ao $HOST"
  no_m2 semear "$slug" "$nome"
}

cmd_tunnel() {
  local rails vite
  rails=$(valor_do_estado RAILS_PORT) || falha "não li a porta do Rails"
  vite=$(valor_do_estado VITE_PORT) || falha "não li a porta do Vite"
  if [ "$HOST" = "$AQUI" ]; then
    cat <<TXT

Painel da demo $slug neste Mac ($HOST). Não precisa de túnel:
  http://localhost:$rails/app/login   (usuário do seed: john@acme.inc, senha em db/seeds.rb)
TXT
    return 0
  fi
  cat <<TXT

Painel da demo $slug no $HOST. Para abrir neste Mac ($AQUI):
  ssh -f -N -L $rails:127.0.0.1:$rails -L '$vite:[::1]:$vite' $HOST
  http://localhost:$rails/app/login   (usuário do seed: john@acme.inc, senha em db/seeds.rb)
Fechar o túnel: pkill -f 'ssh -f -N -L $rails:'
TXT
}

# A pasta dos prints (relativa à worktree) não pode passar por link simbólico, nem ela nem nenhum ancestral até a
# worktree, e o caminho real (pwd -P) do que já existe tem de ficar dentro do caminho real da worktree.
pasta_segura() {
  local relativa=$1 parte=$1 real raiz existente
  while :; do
    [ ! -L "$WT/$parte" ] || falha "\"pasta\" passa por link simbólico: $WT/$parte"
    case "$parte" in */*) parte=${parte%/*} ;; *) break ;; esac
  done
  raiz=$(cd "$WT" && pwd -P) || falha "não li o caminho real da worktree"
  existente=$relativa
  while [ ! -d "$WT/$existente" ]; do
    case "$existente" in */*) existente=${existente%/*} ;; *) existente=. ; break ;; esac
  done
  real=$(cd "$WT/$existente" && pwd -P) || falha "não li o caminho real de $WT/$existente"
  case "$real" in
    "$raiz" | "$raiz"/*) ;;
    *) falha "\"pasta\" sai da worktree: $real" ;;
  esac
}

cmd_prints() {
  worktree
  local jornadas=${1:?uso: bin/demo prints <slug> <jornadas.json>} pasta
  [ -f "$jornadas" ] || falha "arquivo não existe: $jornadas"
  pasta=$(/usr/bin/python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("pasta",""))' "$jornadas") ||
    falha "não li \"pasta\" em $jornadas"
  case "$pasta" in
    docs/?* ) ;;
    *) falha "\"pasta\" do jornadas.json precisa começar com docs/ (veio '$pasta')" ;;
  esac
  case "$pasta" in *..* | */.* | *//*) falha "\"pasta\" não pode ter componente começando com '.' nem '//' ('$pasta')" ;; esac
  # Prints regravam a pasta inteira: nunca por cima de arquivo versionado.
  local versionados
  versionados=$(/usr/bin/git -C "$WT" ls-files -- "$pasta") || falha "git ls-files falhou; não sei se $pasta é versionada"
  [ -z "$versionados" ] || falha "\"pasta\" $pasta tem arquivo versionado; use uma pasta nova (ex.: $pasta-v2)"
  pasta_segura "$pasta"
  exigir_demo
  enviar_kit
  remoto "/bin/mkdir -p '$RAIZ_DEMOS/$slug/prints-entrada'" || falha "não criei a pasta das jornadas no $HOST"
  remoto "/bin/cat > '$RAIZ_DEMOS/$slug/prints-entrada/jornadas.json'" < "$jornadas" ||
    falha "não levei as jornadas ao $HOST"
  local codigo=0
  no_m2 prints "$slug" || codigo=$?
  # Os prints chegam num temporário fora da worktree; só arquivo comum e pasta passam, e só para uma pasta sem link.
  local recebidos estranhos links
  recebidos=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/demo-prints.XXXXXX") || falha "mktemp falhou"
  [ -n "$recebidos" ] && [ -d "$recebidos" ] || falha "mktemp não criou a pasta"
  # shellcheck disable=SC2064
  trap "/bin/rm -rf '$recebidos'" EXIT
  remoto "/usr/bin/tar -C '$RAIZ_DEMOS/$slug/prints-saida' -cf - ." | /usr/bin/tar -C "$recebidos" -xf - ||
    falha "não trouxe os prints do $HOST"
  estranhos=$(/usr/bin/find "$recebidos" ! -type f ! -type d) || falha "find falhou nos prints recebidos"
  [ -z "$estranhos" ] || falha "os prints trouxeram algo que não é arquivo nem pasta (link?): $estranhos"
  /bin/mkdir -p "$WT/$pasta" || falha "não criei $WT/$pasta"
  pasta_segura "$pasta"
  links=$(/usr/bin/find "$WT/$pasta" -type l) || falha "find falhou em $WT/$pasta"
  [ -z "$links" ] || falha "há link simbólico dentro de $WT/$pasta: $links"
  /bin/cp -R "$recebidos/." "$WT/$pasta/" || falha "não copiei os prints para $WT/$pasta"
  [ "$codigo" -eq 0 ] || echo "bin/demo: prints com FALHA (saída $codigo); veja as linhas acima" >&2
  echo "prints em $WT/$pasta (o relato com URLs e erros fica no $HOST: $RAIZ_DEMOS/$slug/relato.json)"
  return "$codigo"
}

# Confere, sem apagar, que o snapshot deste Mac pode sair (caminho, marcador, ninguém usando).
conferir_snapshot_local() {
  local snapdir=${1%/src}
  snapshot_valido "$snapdir"
  [ -d "$snapdir" ] || { echo "snapshot não existe neste Mac: $snapdir"; return; }
  [ -f "$snapdir/.maccluster-workspace.json" ] || falha "$snapdir sem o marcador do MacCluster; não apago"
  # Mesma conferência do no_m2.sh: o marcador tem de dizer que o snapshot é este (snapshot_id igual ao nome).
  /usr/bin/python3 -I -c 'import json,os,sys
m = json.load(open(os.path.join(sys.argv[1], ".maccluster-workspace.json")))
sys.exit(0 if m.get("snapshot_id") == os.path.basename(sys.argv[1]) else 1)' "$snapdir" ||
    falha "o marcador de $snapdir não é deste snapshot (snapshot_id diferente do nome); não apago"
  snapshot_so_meu "$snapdir"
  if em_uso "$snapdir"; then falha "snapshot em uso neste Mac; não apaguei: $snapdir (repita, ou apague à mão pelo caminho exato com lsof +D vazio)"; fi
}

apagar_snapshot_local() {
  local snapdir=${1%/src}
  conferir_snapshot_local "$1"
  [ -d "$snapdir" ] || return 0
  /bin/rm -rf "$snapdir"
  echo "snapshot apagado neste Mac ($AQUI): $snapdir"
  apagar_trava "$snapdir"
}

# O MacCluster deixa um lock vazio ao lado de cada snapshot que ele cria.
apagar_trava() {
  local trava
  trava="${1%/*}/.${1##*/}.maccluster-lock"
  [ ! -f "$trava" ] || [ -s "$trava" ] || /bin/rm -f "$trava"
}

cmd_down() {
  exigir_demo_registrada
  enviar_kit
  if [ "${1:-}" != --apagar ]; then recusar_em_remocao; fi
  if [ "${1:-}" = --apagar ]; then
    local snap
    snap=$(valor_do_estado SNAP) || falha "não li o snapshot da demo; nada apagado"
    if [ "$HOST" = "$AQUI" ]; then
      # A demo roda neste Mac, em cima do próprio snapshot: quem confere e apaga é o `apagar` (depois de descer).
      snapshot_valido "${snap%/src}"
      no_m2 apagar "$slug" || falha "o apagar recusou; confira as linhas acima ($snap)"
      apagar_trava "${snap%/src}"
    else
      conferir_snapshot_local "$snap"
      no_m2 apagar "$slug" || falha "o $HOST recusou o apagar; nada foi apagado neste Mac ($snap)"
      # O demo.env só some no `fechar`: se este Mac recusar aqui, repetir o down --apagar termina o serviço.
      apagar_snapshot_local "$snap"
    fi
    no_m2 fechar "$slug"
  else
    no_m2 descer "$slug"
    echo "banco, snapshot e pasta continuam. Para apagar: bin/demo down $slug --apagar"
  fi
}

cmd_maquinas() {
  local escolha
  medir
  listar_vivas
  echo "máquinas:"
  descrever_medida
  escolha=$(melhor_maquina "${DEMO_MAQUINA:-${MAQUINAS[*]}}") || falha "awk falhou escolhendo a máquina"
  if [ -n "$VIVAS" ]; then
    echo "demos vivas (o limite é 1, somando ${MAQUINAS[*]}):"
    mostrar_vivas "$VIVAS"
    echo "um up de outra demo agora seria recusado: já há demo viva"
  elif [ -n "$escolha" ]; then
    echo "demos vivas: nenhuma"
    echo "um up de demo nova agora iria para: $escolha"
  else
    echo "demos vivas: nenhuma"
    echo "um up agora seria recusado: nenhuma máquina dentro do limite"
  fi
  echo "Antes de qualquer up: perguntar à Orquestração Deploy e esperar o OK."
}

[ $# -ge 1 ] || uso
case "${DEMO_MAQUINA:-}" in
  '') ;;
  *) maquina_valida "$DEMO_MAQUINA" || falha "DEMO_MAQUINA='$DEMO_MAQUINA' não vale: use uma de ${MAQUINAS[*]}" ;;
esac
AQUI=$(maccluster node) || falha "maccluster node falhou; não sei em qual Mac estou"
maquina_valida "$AQUI" || falha "maccluster node devolveu '$AQUI'; esperava uma de ${MAQUINAS[*]}"
if [ "$1" = maquinas ]; then
  cmd_maquinas
  exit 0
fi
[ $# -ge 2 ] || uso
cmd=$1
slug=$2
shift 2
validar_slug "$slug"

case "$cmd" in
  up) cmd_up ;;
  sync) cmd_sync ;;
  flag) cmd_flag "$@" ;;
  seed) cmd_seed "$@" ;;
  tunnel) exigir_demo; cmd_tunnel ;;
  prints) cmd_prints "$@" ;;
  psql) exigir_demo; enviar_kit; no_m2 psql "$slug" "${1:-}" ;;
  status) exigir_demo_registrada; no_m2 estado "$slug"; echo "MAQUINA=$HOST" ;;
  down) cmd_down "$@" ;;
  *) uso ;;
esac
