#!/usr/bin/env bash
# Regera, na ordem certa, tudo o que a Automação livre gera do código (#2569).
#   bin/regerar-automacao           # escreve os arquivos gerados
#   bin/regerar-automacao --check   # só confere; falha se algum está fora de dia
#
# 1. lib/operator_guide/formatos-das-acoes.json   (rails autonomia:guia:formatos)
# 2. lib/operator_guide/automacao-passos.json     (rails autonomia:guia:automacao; lê o 1)
# 3. lib/operator_guide/guia-produto.md e guideRouteRegistry.js   (pnpm guia:build)
# Guia em docs/automacao/regerar-e-textos-por-area.md.
set -euo pipefail
cd "$(dirname "$0")/.."

case "${1:-}" in
  '')
    bundle exec rails autonomia:guia:formatos autonomia:guia:automacao
    pnpm guia:build
    ;;
  --check)
    bundle exec rails autonomia:guia:formatos:check autonomia:guia:automacao:check
    pnpm guia:check
    ;;
  *)
    echo "uso: bin/regerar-automacao [--check]" >&2
    exit 2
    ;;
esac
