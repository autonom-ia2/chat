INSTAGRAM_TESTER_RUNTIME_STACK=hub2you
HOME=/var/lib/instagram-publisher-hub2you
PATH=/usr/local/bin:/usr/bin:/bin
INSTAGRAM_TESTER_PUBLISHER_SOCKET=/run/instagram-publisher-hub2you/publisher.sock
INSTAGRAM_TESTER_PUBLISHER_SSH_KEY=/var/lib/instagram-publisher-hub2you/publisher/id_ed25519
INSTAGRAM_TESTER_PUBLISHER_HOST_KEY_DOCUMENT=ChatwootInstagramPublisherHostKey
AWS_CONFIG_FILE=/var/lib/instagram-publisher-hub2you/publisher/aws-config
AWS_SHARED_CREDENTIALS_FILE=/dev/null
AWS_EC2_METADATA_DISABLED=true
AWS_PAGER=
