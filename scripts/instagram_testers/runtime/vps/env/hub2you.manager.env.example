INSTAGRAM_TESTER_RUNTIME_STACK=hub2you
HOME=/var/lib/instagram-hub2you
DISPLAY=:91
XAUTHORITY=/var/lib/instagram-hub2you/.Xauthority
INSTAGRAM_TESTER_CHROMIUM_SANDBOX=true
INSTAGRAM_TESTER_RUNTIME_MODE=vps
INSTAGRAM_TESTER_BROWSER_OPERATIONS_ENABLED=false
INSTAGRAM_TESTER_SEARCH_STATUS_ENABLED=false
PATH=/usr/local/bin:/usr/bin:/bin
INSTAGRAM_TESTER_BROWSER_PROFILE=/var/lib/instagram-hub2you/profile
INSTAGRAM_TESTER_PLAYWRIGHT_MODULE=/opt/instagram-meta/current/scripts/instagram_testers/runtime/vps/node_modules/playwright/index.mjs
INSTAGRAM_TESTER_OPERATOR_REQUEST_FILE=/run/instagram-hub2you/browser-request.json
INSTAGRAM_TESTER_PROXY_HOST=REQUIRED_APPROVED_PROXY_HOST
INSTAGRAM_TESTER_PROXY_PORT=REQUIRED_APPROVED_PROXY_PORT
INSTAGRAM_TESTER_PROXY_AUTH_MODE=ip
INSTAGRAM_TESTER_PUBLISHER_SOCKET=/run/instagram-publisher-hub2you/publisher.sock
