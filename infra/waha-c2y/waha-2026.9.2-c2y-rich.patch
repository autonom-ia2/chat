+jest.mock('@waha/utils/promiseTimeout', () => ({
+  sleep: jest.fn(() => Promise.resolve()),
+}));
+// The real helper pulls ESM-only Baileys, which jest can not load
+jest.mock('@waha/apps/chatwoot/waha', () => ({
+  EngineHelper: { WhatsAppMessageKeys: jest.fn() },
+}));
+
+import { JestLogger } from '@waha/apps/app_sdk/jest/JestLogger';
+import { AttributeKey } from '@waha/apps/chatwoot/const';
+import { MessageHandler } from '@waha/apps/chatwoot/consumers/inbox/message_created';
+import { i18n } from '@waha/apps/chatwoot/i18n';
+import { DeterministicMessageId } from '@waha/apps/chatwoot/messages/to/whatsapp/native';
+import { EngineHelper } from '@waha/apps/chatwoot/waha';
+
+const CHAT_ID = '5511999999999@c.us';
+const GROUP_ID = '120363000000000000@g.us';
+const SESSION = 'hub2you';
+const SECRET_URL_TOKEN = 'eyJfcmFpbHMiOnsiZGF0YSI6NDJ9fQ';
+
+function chatwootMessage(extra: any = {}, chatId: string = CHAT_ID) {
+  return {
+    id: 777,
+    created_at: '2026-10-16T12:00:00Z',
+    content_type: 'text',
+    content: 'Olá **cliente**',
+    message_type: 'outgoing',
+    attachments: [],
+    content_attributes: {},
+    conversation: {
+      id: 42,
+      meta: {
+        sender: {
+          custom_attributes: { [AttributeKey.WA_CHAT_ID]: chatId },
+        },
+      },
+    },
+    ...extra,
+  };
+}
+
+function attachment(name: string, fileType: string) {
+  return {
+    file_type: fileType,
+    data_url: `https://chat.example/rails/active_storage/blobs/redirect/${SECRET_URL_TOKEN}/${name}`,
+  };
+}
+
+function setup() {
+  const sent = { id: { id: 'WAID', remote: CHAT_ID }, fromMe: true };
+  const session: any = {
+    name: SESSION,
+    sendPoll: jest.fn().mockResolvedValue(sent),
+    sendText: jest.fn().mockResolvedValue(sent),
+    sendImage: jest.fn().mockResolvedValue(sent),
+    sendVideo: jest.fn().mockResolvedValue(sent),
+    sendFile: jest.fn().mockResolvedValue(sent),
+    sendVoice: jest.fn().mockResolvedValue(sent),
+    readMessages: jest.fn().mockResolvedValue(undefined),
+    startTyping: jest.fn().mockResolvedValue(undefined),
+    stopTyping: jest.fn().mockResolvedValue(undefined),
+  };
+  const mapping: any = {
+    getMappingByChatwootCombinedKeyAndPart: jest.fn().mockResolvedValue(null),
+    getWhatsAppMessage: jest.fn().mockResolvedValue([]),
+    map: jest.fn().mockResolvedValue(undefined),
+  };
+  const status: any = { sync: jest.fn().mockResolvedValue(undefined) };
+  const config: any = {
+    conversations: { syncMessageStatus: false },
+    linkPreview: 'OFF',
+  };
+  const media = {
+    fetch: jest.fn().mockResolvedValue(Buffer.from('original-image')),
+    toJpeg: jest.fn().mockResolvedValue(Buffer.from('jpeg-bytes')),
+  };
+  const logger = JestLogger();
+  const handler = new MessageHandler(
+    mapping,
+    logger,
+    session,
+    config,
+    i18n.locale('en-US'),
+    status,
+    media,
+  );
+  (EngineHelper.WhatsAppMessageKeys as jest.Mock).mockReturnValue({
+    timestamp: new Date(0),
+    from_me: true,
+    chat_id: CHAT_ID,
+    message_id: 'WAID',
+    participant: null,
+  });
+  return { handler, session, mapping, logger, media };
+}
+
+function allLogs(logger: any): string {
+  return ['fatal', 'error', 'warn', 'info', 'debug', 'trace']
+    .flatMap((level) => logger[level].mock.calls)
+    .map((args) => args.map((a) => String(a)).join(' '))
+    .join('\n');
+}
+
+afterEach(() => jest.clearAllMocks());
+
+describe('MessageHandler - sendPoll (c2y-rich-2, item 1)', () => {
+  const POLL = {
+    name: 'Qual plano?',
+    options: ['Básico', 'Completo'],
+    multipleAnswers: true,
+  };
+
+  it('sends the native poll with the deterministic id and maps it as 1 part', async () => {
+    const { handler, session, mapping } = setup();
+    const result = await handler.handle(
+      chatwootMessage({
+        content: 'Qual plano?\n\n1. Básico\n2. Completo',
+        content_attributes: {
+          waha_native: {
+            kind: 'sendPoll',
+            payload: { poll: POLL, chatId: 'attacker@c.us' },
