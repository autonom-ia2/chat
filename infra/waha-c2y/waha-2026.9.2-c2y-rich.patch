+      expect(container.ContactConversationService).not.toHaveBeenCalled();
+      expect(container.MessageMappingService).not.toHaveBeenCalled();
+      expect(info.onConversationId).not.toHaveBeenCalled();
+    },
+  );
+
+  it('ON (c2yViewOnceNotice: true): one incoming customer notice', async () => {
+    const { consumer, job, info, sent, repo, mapping } = consumerWith({
+      locale: 'pt-BR',
+      c2yViewOnceNotice: true,
+    });
+    await consumer.Process(job, info);
+    expect(repo.ConversationByContact).toHaveBeenCalledTimes(1);
+    expect(sent).toHaveLength(1);
+    expect(sent[0].message_type).toBe('incoming');
+    expect(sent[0].private).toBe(false);
+    expect(
+      sent[0].content_attributes.waha_view_once_unavailable,
+    ).toEqual({ from_me: false, id: `false_${CUSTOMER}_${WA_ID}` });
+    expect(mapping.map).toHaveBeenCalledTimes(1);
+    expect(mapping.map.mock.calls[0][1].message_id).toBe(`${WA_ID}-C2YVO`);
+  });
+
+  it('the config is read on every job: off -> on -> off without restart', async () => {
+    const config: Record<string, unknown> = { locale: 'pt-BR' };
+    const { consumer, job, info, sent, container } = consumerWith(config);
+    container.ChatWootConfig.mockImplementation(() =>
+      ChatWootConfigDefaults(config as unknown as ChatWootAppConfig),
+    );
+    await consumer.Process(job, info);
+    config.c2yViewOnceNotice = true;
+    await consumer.Process(job, info);
+    config.c2yViewOnceNotice = false;
+    await consumer.Process(job, info);
+    expect(sent).toHaveLength(1);
+  });
+
+  it('ViewOnceNoticeEnabled: only an exact true', () => {
+    expect(ViewOnceNoticeEnabled(undefined)).toBe(false);
+    expect(ViewOnceNoticeEnabled(null)).toBe(false);
+    expect(ViewOnceNoticeEnabled({})).toBe(false);
+    expect(ViewOnceNoticeEnabled({ c2yViewOnceNotice: false })).toBe(false);
+    expect(ViewOnceNoticeEnabled({ c2yViewOnceNotice: true })).toBe(true);
+  });
+
+  it('the apps API keeps the option (whitelist) and rejects a non boolean', () => {
+    const base = {
+      url: 'https://chat.example',
+      accountId: 1,
