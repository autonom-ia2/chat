+const findEnabledAppById = jest.fn();
+jest.mock('@waha/apps/app_sdk/storage/AppRepository', () => ({
+  AppRepository: jest.fn().mockImplementation(() => ({
+    findEnabledAppById: findEnabledAppById,
+  })),
+}));
+// The CLI pulls ESM-only Baileys, which jest can not load
+jest.mock('@waha/apps/chatwoot/cli', () => ({ CommandPrefix: 'wa/' }));
+
+import { NotFoundException, UnauthorizedException } from '@nestjs/common';
+import { ChatwootWebhookController } from '@waha/apps/chatwoot/api/chatwoot.webhook.controller';
+
+function setup(app: any = { id: 'app_1', session: 'hub2you' }) {
+  findEnabledAppById.mockResolvedValue(app);
+  const queue: any = {
+    addJobToQueue: jest.fn().mockResolvedValue(undefined),
+    addMessageCreatedJob: jest.fn().mockResolvedValue(undefined),
+  };
+  const manager: any = { store: { getWAHADatabase: () => ({}) } };
+  const controller = new ChatwootWebhookController(queue, manager);
+  // Signature checked in c2y.signature.test.ts and the e2e below
+  const verify = jest.fn().mockResolvedValue('ok');
+  (controller as any).c2ySignature = { verify };
+  return { controller, queue, verify };
+}
+
+function body(extra: any = {}) {
+  return {
+    event: 'c2y_message_reaction',
+    id: 501,
+    message_type: 'incoming',
+    private: false,
+    content_attributes: {},
+    conversation: { id: 42, meta: { sender: {} } },
+    c2y_reaction: { emoji: '👍' },
+    ...extra,
+  };
+}
+
+afterEach(() => jest.clearAllMocks());
+
+describe('ChatwootWebhookController - c2y events (c2y-rich-2)', () => {
+  it('reaction to an INCOMING message is queued (before the incoming filter)', async () => {
+    const { controller, queue } = setup();
+    await controller.webhook('hub2you', 'app_1', body());
+    expect(queue.addJobToQueue).toHaveBeenCalledWith('c2y_message_reaction', {
+      session: 'hub2you',
+      app: 'app_1',
+      body: expect.objectContaining({ id: 501 }),
+    });
+  });
+
+  it('edit of an echo (external_echo) message is queued too', async () => {
+    const { controller, queue } = setup();
+    await controller.webhook(
+      'hub2you',
+      'app_1',
+      body({
+        event: 'c2y_message_edit',
+        message_type: 'outgoing',
+        content_attributes: { external_echo: true },
+        c2y_edit: { waha_text: 'x' },
+      }),
+    );
+    expect(queue.addJobToQueue).toHaveBeenCalledWith(
+      'c2y_message_edit',
+      expect.anything(),
+    );
+  });
+
+  it('private note: ignored', async () => {
+    const { controller, queue } = setup();
+    await controller.webhook('hub2you', 'app_1', body({ private: true }));
+    expect(queue.addJobToQueue).not.toHaveBeenCalled();
+  });
+
+  it('unknown app or other session: 404, nothing queued', async () => {
+    const { controller, queue } = setup(null);
+    await expect(
+      controller.webhook('hub2you', 'app_1', body()),
+    ).rejects.toBeInstanceOf(NotFoundException);
+    findEnabledAppById.mockResolvedValue({ id: 'app_1', session: 'other' });
+    await expect(
+      controller.webhook('hub2you', 'app_1', body()),
+    ).rejects.toBeInstanceOf(NotFoundException);
+    expect(queue.addJobToQueue).not.toHaveBeenCalled();
+  });
+
+  it('regular incoming message_created is still ignored', async () => {
+    const { controller, queue } = setup();
+    await controller.webhook(
+      'hub2you',
+      'app_1',
+      body({ event: 'message_created' }),
+    );
+    expect(queue.addJobToQueue).not.toHaveBeenCalled();
+    expect(queue.addMessageCreatedJob).not.toHaveBeenCalled();
+  });
+});
+
+describe('ChatwootWebhookController - c2y signature (c2y-rich-2, review)', () => {
+  const req = {
+    rawBody: Buffer.from('{"event":"c2y_message_reaction"}'),
+    headers: {
+      'x-chatwoot-signature': 'sha256=abc',
+      'x-chatwoot-timestamp': '1',
+    },
+  };
+
+  it('passes the app config, raw body and headers to the verifier', async () => {
+    const app = { id: 'app_1', session: 'hub2you', config: { inboxId: 7 } };
+    const { controller, queue, verify } = setup(app);
+    await controller.webhook('hub2you', 'app_1', body(), req);
+    expect(verify).toHaveBeenCalledWith(
+      'app_1',
+      app.config,
+      req.rawBody,
+      req.headers,
+    );
+    expect(queue.addJobToQueue).toHaveBeenCalledTimes(1);
+  });
+
+  it.each([['invalid'], ['no-secret']])(
+    'verdict %s: 401 and nothing queued',
+    async (verdict) => {
+      const { controller, queue, verify } = setup();
+      verify.mockResolvedValue(verdict);
+      await expect(
+        controller.webhook('hub2you', 'app_1', body(), req),
+      ).rejects.toBeInstanceOf(UnauthorizedException);
+      expect(queue.addJobToQueue).not.toHaveBeenCalled();
+    },
+  );
+
+  it('unknown app: 404 before any signature work', async () => {
+    const { controller, verify } = setup(null);
+    await expect(
+      controller.webhook('hub2you', 'app_1', body(), req),
+    ).rejects.toBeInstanceOf(NotFoundException);
+    expect(verify).not.toHaveBeenCalled();
+  });
+
+  it('other events never go through the signature check', async () => {
+    const { controller, queue, verify } = setup();
+    await controller.webhook(
+      'hub2you',
+      'app_1',
+      body({
+        event: 'message_created',
+        message_type: 'outgoing',
+        c2y_reaction: undefined,
+      }),
+    );
+    expect(verify).not.toHaveBeenCalled();
+    expect(queue.addMessageCreatedJob).toHaveBeenCalledTimes(1);
+  });
+});
