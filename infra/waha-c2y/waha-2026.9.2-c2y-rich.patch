+import { Processor } from '@nestjs/bullmq';
+import { JOB_CONCURRENCY } from '@waha/apps/app_sdk/constants';
+import { ILogger } from '@waha/apps/app_sdk/ILogger';
+import { WAHASessionAPI } from '@waha/apps/app_sdk/waha/WAHASelf';
+import { SerializeWhatsAppKey } from '@waha/apps/chatwoot/client/ids';
+import { HasViewOnceNotice } from '@waha/apps/chatwoot/messages/to/chatwoot/ViewOnceNotice';
+import { MessageType } from '@waha/apps/chatwoot/client/types';
+import { ChatWootInboxMessageConsumer } from '@waha/apps/chatwoot/consumers/inbox/base';
+import { QueueName } from '@waha/apps/chatwoot/consumers/QueueName';
+import { DIContainer } from '@waha/apps/chatwoot/di/DIContainer';
+import {
+  ChatWootConfig,
+  LinkPreview,
+} from '@waha/apps/chatwoot/dto/config.dto';
+import { TKey } from '@waha/apps/chatwoot/i18n/templates';
+import {
+  ParseC2yEdit,
+  ParseC2yReaction,
+} from '@waha/apps/chatwoot/messages/to/whatsapp/actions';
+import {
+  MessageMappingService,
+  WhatsAppMessage,
+} from '@waha/apps/chatwoot/storage';
+import { SessionManager } from '@waha/core/abc/manager.abc';
+import { RMutexService } from '@waha/modules/rmutex/rmutex.service';
+import { Job, UnrecoverableError } from 'bullmq';
+import { PinoLogger } from 'nestjs-pino';
+
+/**
+ * Autonom.ia patch c2y-rich-2 (autonom-ia2/chat#1709)
+ * Reaction and edit made by an agent in chat2you -> WhatsApp.
+ * The log carries only ids (Chatwoot message, session) - never the emoji,
+ * the text or the phone.
+ */
+
+/**
+ * The error note of a reaction / edit is always an OUTGOING private note,
+ * even when the target message is incoming: the upstream reporter copies
+ * body.message_type, and before the patch it never saw incoming events.
+ * Returns a copy; the job body is not changed.
+ */
+export function ReportBody(body: any): any {
+  return { ...body, message_type: MessageType.OUTGOING };
+}
+
+async function WhatsAppParts(
+  mapping: MessageMappingService,
+  body: any,
+): Promise<WhatsAppMessage[]> {
+  const messages = await mapping.getWhatsAppMessage({
+    conversation_id: body.conversation.id,
+    message_id: body.id,
+  });
+  return messages || [];
+}
+
+@Processor(QueueName.INBOX_C2Y_REACTION, { concurrency: JOB_CONCURRENCY })
+export class ChatWootInboxC2yReactionConsumer extends ChatWootInboxMessageConsumer {
+  constructor(
+    protected readonly manager: SessionManager,
+    log: PinoLogger,
+    rmutex: RMutexService,
+  ) {
+    super(manager, log, rmutex, 'ChatWootInboxC2yReactionConsumer');
+  }
+
+  ErrorHeaderKey(): TKey | null {
+    return TKey.WHATSAPP_MESSAGE_SENDING_ERROR;
+  }
+
+  protected async ReportErrorForMessage(job: Job, err: any, body: any) {
+    return super.ReportErrorForMessage(job, err, ReportBody(body));
+  }
+
+  protected async ReportErrorRecovered(job: Job, body: any) {
+    return super.ReportErrorRecovered(job, ReportBody(body));
+  }
+
+  protected async Process(container: DIContainer, body, job: Job) {
+    const session = new WAHASessionAPI(job.data.session, container.WAHASelf());
+    const handler = new C2yReactionHandler(
+      container.MessageMappingService(),
+      container.Logger(),
+      session,
+    );
+    return await handler.handle(body);
+  }
+}
+
+export class C2yReactionHandler {
+  constructor(
+    private mappingService: MessageMappingService,
+    private logger: ILogger,
+    private session: WAHASessionAPI,
+  ) {}
+
+  async handle(body: any) {
+    const reaction = ParseC2yReaction(body);
+    if (!reaction) {
+      this.logger.warn(
+        `c2y_message_reaction without a valid emoji ignored: chatwoot_message_id=${body?.id}`,
+      );
+      return null;
+    }
+    const parts = await WhatsAppParts(this.mappingService, body);
+    if (HasViewOnceNotice(parts)) {
+      this.logger.warn(
+        `c2y_message_reaction on a view once notice ignored: chatwoot_message_id=${body.id}`,
+      );
+      return null;
+    }
+    if (parts.length === 0) {
+      throw new UnrecoverableError(
+        `No WhatsApp message found for Chatwoot message '${body.id}', ` +
+          'the reaction was not sent',
+      );
+    }
+    const messageId = SerializeWhatsAppKey(parts[0]);
+    const result = await this.session.setReaction({
+      session: '',
+      messageId: messageId,
+      reaction: reaction.emoji,
+    });
+    this.logger.info(
+      `ChatWoot => WhatsApp: reaction ${reaction.emoji ? 'set' : 'removed'}: ` +
+        `chatwoot_message_id=${body.id} session=${this.session.name}`,
+    );
+    return result;
+  }
+}
+
+@Processor(QueueName.INBOX_C2Y_EDIT, { concurrency: JOB_CONCURRENCY })
+export class ChatWootInboxC2yEditConsumer extends ChatWootInboxMessageConsumer {
+  constructor(
+    protected readonly manager: SessionManager,
+    log: PinoLogger,
+    rmutex: RMutexService,
+  ) {
+    super(manager, log, rmutex, 'ChatWootInboxC2yEditConsumer');
+  }
+
+  ErrorHeaderKey(): TKey | null {
+    return TKey.WHATSAPP_MESSAGE_SENDING_ERROR;
+  }
+
+  protected async ReportErrorForMessage(job: Job, err: any, body: any) {
+    return super.ReportErrorForMessage(job, err, ReportBody(body));
+  }
+
+  protected async ReportErrorRecovered(job: Job, body: any) {
+    return super.ReportErrorRecovered(job, ReportBody(body));
+  }
+
+  protected async Process(container: DIContainer, body, job: Job) {
+    const session = new WAHASessionAPI(job.data.session, container.WAHASelf());
+    const handler = new C2yEditHandler(
+      container.MessageMappingService(),
+      container.Logger(),
+      session,
+      container.ChatWootConfig(),
+    );
+    return await handler.handle(body);
+  }
+}
+
+export class C2yEditHandler {
+  constructor(
+    private mappingService: MessageMappingService,
+    private logger: ILogger,
+    private session: WAHASessionAPI,
+    private config: ChatWootConfig,
+  ) {}
+
+  async handle(body: any) {
+    const edit = ParseC2yEdit(body);
+    if (!edit) {
+      this.logger.warn(
+        `c2y_message_edit without a valid text ignored: chatwoot_message_id=${body?.id}`,
+      );
+      return null;
+    }
+    const parts = await WhatsAppParts(this.mappingService, body);
+    if (HasViewOnceNotice(parts)) {
+      this.logger.warn(
+        `c2y_message_edit on a view once notice ignored: chatwoot_message_id=${body.id}`,
+      );
+      return null;
+    }
+    if (parts.length !== 1) {
+      throw new UnrecoverableError(
+        `Chatwoot message '${body.id}' has ${parts.length} WhatsApp parts; ` +
+          'only a message sent as a single text can be edited',
+      );
+    }
+    const whatsapp = parts[0];
+    const result = await this.session.editMessage(
+      whatsapp.chat_id,
+      SerializeWhatsAppKey(whatsapp),
+      {
+        text: edit.text,
+        linkPreview: [LinkPreview.LQ, LinkPreview.HQ].includes(
+          this.config.linkPreview,
+        ),
+        linkPreviewHighQuality: this.config.linkPreview == LinkPreview.HQ,
+      },
+    );
+    this.logger.info(
+      `ChatWoot => WhatsApp: message edited: chatwoot_message_id=${body.id} ` +
+        `session=${this.session.name}`,
+    );
+    return result;
+  }
+}
