diff --git a/src/core/engines/gows/c2y.viewonce.test.ts b/src/core/engines/gows/c2y.viewonce.test.ts
new file mode 100644
index 00000000..706cae85
--- /dev/null
+++ b/src/core/engines/gows/c2y.viewonce.test.ts
@@ -0,0 +1,119 @@
+import {
+  BuildViewOnceUnavailablePayload,
+  C2Y_VIEW_ONCE_UNAVAILABLE,
+  IsViewOnceUnavailable,
+} from '@waha/core/engines/gows/c2y.viewonce';
+import { WAHAEvents } from '@waha/structures/enums.dto';
+import { MessageSource } from '@waha/structures/responses.dto';
+
+// events.UndecryptableMessage as GOWS serializes it (Go field names)
+function undecryptable(info: any = {}, extra: any = {}) {
+  return {
+    Info: {
+      Chat: '5511999999999@s.whatsapp.net',
+      Sender: '5511999999999@s.whatsapp.net',
+      SenderAlt: '123456789@lid',
+      PushName: 'Maria Cliente',
+      IsFromMe: false,
+      IsGroup: false,
+      ID: '3A0123456789ABCDEF',
+      Timestamp: '2026-10-16T12:00:00-03:00',
+      ...info,
+    },
+    IsUnavailable: true,
+    UnavailableType: 'view_once',
+    DecryptFailMode: '',
+    ...extra,
+  };
+}
+
+describe('IsViewOnceUnavailable (c2y-rich-4)', () => {
+  it('view once from a contact in a 1:1 chat', () => {
+    expect(IsViewOnceUnavailable(undecryptable())).toBe(true);
+  });
+
+  it('1:1 chat addressed by lid', () => {
+    expect(
+      IsViewOnceUnavailable(undecryptable({ Chat: '123456789@lid' })),
+    ).toBe(true);
+  });
+
+  it.each([
+    ['my own message', undecryptable({ IsFromMe: true })],
+    ['group (flag)', undecryptable({ IsGroup: true })],
+    ['group (jid)', undecryptable({ Chat: '120363000000000000@g.us' })],
+    ['status broadcast', undecryptable({ Chat: 'status@broadcast' })],
+    ['newsletter', undecryptable({ Chat: '120363000000000000@newsletter' })],
+    ['other unavailable type', undecryptable({}, { UnavailableType: '' })],
+    ['decrypt failure, not unavailable', undecryptable({}, { IsUnavailable: false })],
+    ['no message id', undecryptable({ ID: '' })],
+    ['no chat', undecryptable({ Chat: '' })],
+    ['no info', { IsUnavailable: true, UnavailableType: 'view_once' }],
+    ['null', null],
+    ['undefined', undefined],
+  ])('ignores %s', (_name, data) => {
+    expect(IsViewOnceUnavailable(data)).toBe(false);
+  });
+});
+
+describe('BuildViewOnceUnavailablePayload (c2y-rich-4)', () => {
+  it('same id and chat shape as a GOWS incoming message', () => {
+    const data = undecryptable();
+    expect(BuildViewOnceUnavailablePayload(data)).toEqual({
+      id: 'false_5511999999999@c.us_3A0123456789ABCDEF',
+      timestamp: 1792162800,
+      from: '5511999999999@c.us',
+      fromMe: false,
+      source: MessageSource.APP,
+      to: null,
+      participant: null,
+      body: null,
+      hasMedia: false,
+      _data: {
+        Info: {
+          Chat: '5511999999999@s.whatsapp.net',
+          ID: '3A0123456789ABCDEF',
+          IsFromMe: false,
+          IsGroup: false,
+          Timestamp: '2026-10-16T12:00:00-03:00',
+        },
+        IsUnavailable: true,
+        UnavailableType: 'view_once',
+      },
+    });
+  });
+
+  it('the job never carries the raw event (name, sender, alt address)', () => {
+    const payload = BuildViewOnceUnavailablePayload(undecryptable());
+    const json = JSON.stringify(payload);
+    expect(json).not.toContain('Maria Cliente');
+    expect(json).not.toContain('PushName');
+    expect(json).not.toContain('Sender');
+    expect(json).not.toContain('123456789@lid');
+    expect(json).not.toContain('DecryptFailMode');
+  });
+
+  it('keeps a lid chat as lid', () => {
+    const payload = BuildViewOnceUnavailablePayload(
+      undecryptable({ Chat: '123456789@lid' }),
+    );
+    expect(payload.from).toBe('123456789@lid');
+    expect(payload.id).toBe('false_123456789@lid_3A0123456789ABCDEF');
+  });
+
+  it.each([['0001-01-01T00:00:00Z'], ['not a date'], [undefined]])(
+    'timestamp %p becomes null',
+    (ts) => {
+      expect(
+        BuildViewOnceUnavailablePayload(undecryptable({ Timestamp: ts }))
+          .timestamp,
+      ).toBeNull();
+    },
+  );
+});
+
+describe('internal event name', () => {
+  it('is not a WAHAEvents value, so no webhook (not even "*") gets it', () => {
+    expect(Object.values(WAHAEvents)).not.toContain(C2Y_VIEW_ONCE_UNAVAILABLE);
+  });
+});
diff --git a/src/core/engines/gows/c2y.viewonce.ts b/src/core/engines/gows/c2y.viewonce.ts
new file mode 100644
index 00000000..bd7ac069
--- /dev/null
+++ b/src/core/engines/gows/c2y.viewonce.ts
@@ -0,0 +1,108 @@
+import {
+  isJidBroadcast,
+  isJidGroup,
+  isJidNewsletter,
+  toCusFormat,
+} from '@waha/core/utils/jids';
+import { MessageSource } from '@waha/structures/responses.dto';
+
+/**
+ * Autonom.ia patch c2y-rich-4 (autonom-ia2/chat#1709)
+ *
+ * A linked device never receives the media key of a view once message: the
+ * server sends <unavailable type="view_once"/> instead of <enc>, and
+ * whatsmeow emits events.UndecryptableMessage{IsUnavailable: true,
+ * UnavailableType: "view_once"} (message.go). Upstream WAHA only logs it, so
+ * nothing reached the connector.
+ *
+ * This internal event carries the notice to the Chatwoot app, the same way
+ * WhatsApp Web shows "open it on your phone". It is NOT a WAHAEvents value,
+ * so webhooks (including '*') never see it.
+ */
+export const C2Y_VIEW_ONCE_UNAVAILABLE = 'c2y.message.view_once.unavailable';
+
+const VIEW_ONCE = 'view_once';
+
+export interface ViewOnceUnavailablePayload {
+  id: string;
+  timestamp: number | null;
+  from: string;
+  fromMe: false;
+  source: MessageSource;
+  to: null;
+  participant: null;
+  body: null;
+  hasMedia: false;
+  _data: any;
+}
+
+/**
+ * Only a view once message from a CONTACT in a 1:1 chat. Groups, broadcast,
+ * newsletters and my own messages stay as they are.
+ */
+export function IsViewOnceUnavailable(data: any): boolean {
+  if (!data || data.IsUnavailable !== true) {
+    return false;
+  }
+  if (data.UnavailableType !== VIEW_ONCE) {
+    return false;
+  }
+  const info = data.Info;
+  if (!info || !info.ID || !info.Chat) {
+    return false;
+  }
+  if (info.IsFromMe === true || info.IsGroup === true) {
+    return false;
+  }
+  const chat = String(info.Chat);
+  if (isJidGroup(chat) || isJidBroadcast(chat) || isJidNewsletter(chat)) {
+    return false;
+  }
+  return true;
+}
+
+function timestampSeconds(timestamp: unknown): number | null {
+  if (typeof timestamp !== 'string' || timestamp.startsWith('0001')) {
+    return null;
+  }
+  const ms = new Date(timestamp).getTime();
+  return Number.isFinite(ms) ? Math.floor(ms / 1000) : null;
+}
+
+/**
+ * Same id and chat shape as a GOWS incoming message (toWAMessage), so the
+ * connector finds the same contact and conversation.
+ *
+ * The job keeps only what the connector reads: chat, id, direction and
+ * time. Never the raw event (PushName, Sender, SenderAlt...). Without
+ * SenderAlt, a @lid chat finds the phone through findPNByLid, as the
+ * connector already does when the engine does not send it.
+ */
+export function BuildViewOnceUnavailablePayload(
+  data: any,
+): ViewOnceUnavailablePayload {
+  const info = data.Info;
+  const chat = toCusFormat(info.Chat);
+  return {
+    id: `false_${chat}_${info.ID}`,
+    timestamp: timestampSeconds(info.Timestamp),
+    from: chat,
+    fromMe: false,
+    source: MessageSource.APP,
+    to: null,
+    participant: null,
+    body: null,
+    hasMedia: false,
+    _data: {
+      Info: {
+        Chat: info.Chat,
+        ID: info.ID,
+        IsFromMe: false,
+        IsGroup: false,
+        Timestamp: info.Timestamp,
+      },
+      IsUnavailable: true,
+      UnavailableType: VIEW_ONCE,
+    },
+  };
+}
