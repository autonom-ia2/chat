+  /**
+   * Sends the native message as the single part of the Chatwoot message.
+   * Returns null when WAHA refused it for good, so the caller sends the text.
+   */
+  private async handleNative(
+    native: WahaNative,
+    message: any,
+    chatId: string,
+    replyTo: string | undefined,
+  ): Promise<any[] | null> {
+    const part = 1;
+    const parts = 1;
+    const exists = await this.getMapping(message, part);
+    if (exists) {
+      this.logger.warn(
+        `Skip part ${part}: mapping exists for Chatwoot message ${message.id}`,
+      );
+      return [];
+    }
+    const msg = await this.sendNative(native, message, chatId, replyTo);
+    if (msg === null) {
+      return null;
+    }
+    await this.saveMapping(message, msg, part, parts);
+    this.logger.info(
+      `ChatWoot => WhatsApp: native message sent: kind=${native.kind} ` +
+        `chatwoot_message_id=${message.id} session=${this.session.name}`,
+    );
+    if (this.config.conversations.syncMessageStatus) {
+      await this.syncStatus(message, parts);
+    }
+    return [msg];
+  }
+
+  private async sendNative(
+    native: WahaNative,
+    message: any,
+    chatId: string,
+    replyTo: string | undefined,
+  ): Promise<any | null> {
+    const id = DeterministicMessageId(
+      this.session.name,
+      message.id,
+      native.kind,
+    );
+    const request = BuildWahaNativeRequest(native, chatId, replyTo, id);
+    const opts = { signal: AbortSignal.timeout(WAHA_NATIVE_SEND_TIMEOUT_MS) };
+    try {
+      switch (native.kind) {
+        case 'sendList':
+          return await this.session.sendList(request as SendListRequest, opts);
+        case 'sendLocation':
+          return await this.session.sendLocation(
+            request as MessageLocationRequest,
+            opts,
+          );
+        case 'sendContactVcard':
+          return await this.session.sendContactVcard(
+            request as MessageContactVcardRequest,
+            opts,
+          );
+      }
+    } catch (err) {
+      // Never log err itself: it carries request config, headers and payload
+      const status = WahaHttpStatus(err);
+      const where =
+        `kind=${native.kind} status=${status ?? 'no-response'} ` +
+        `chatwoot_message_id=${message.id} session=${this.session.name}`;
+      if (IsDefinitiveRefusal(status)) {
+        this.logger.warn(
+          `ChatWoot => WhatsApp: native message refused, sending text instead: ${where}`,
+        );
+        return null;
+      }
+      this.logger.error(
+        `ChatWoot => WhatsApp: native message not confirmed, not retrying: ${where}`,
+      );
+      throw new WahaNativeSendError(native.kind, status, message.id);
+    }
+  }
+
   /**
    * Push acks that arrived before the last part was mapped, best effort
    */
