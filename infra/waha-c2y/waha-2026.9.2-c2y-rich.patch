+const CUSTOMER = '5511999999999@c.us';
+const ME = '5511888888888@c.us';
+const l = i18n.locale('en-US');
+
+/** Baileys-like reader (Baileys itself is ESM, see c2y3.test.ts) */
+const reader: ProtoReader = {
+  normalize(message: any) {
+    const inner = message?.ephemeralMessage?.message;
+    return inner || message;
+  },
+  contentType(message: any) {
+    if (!message) return undefined;
+    return Object.keys(message).find(
+      (k) => k === 'conversation' || k.endsWith('Message'),
+    );
+  },
+};
+
+function setup(opts: { mapped?: any; history?: boolean } = {}) {
+  const mapping: any = {
+    getChatWootMessage: jest.fn().mockResolvedValue(opts.mapped ?? null),
+  };
+  const logger = JestLogger();
+  const info: any = { onConversationId: jest.fn(), onMessageType: jest.fn() };
+  const session: any = {
+    name: 'hub2you',
+    getSessionInfo: jest.fn().mockResolvedValue({
+      me: { id: ME, lid: '777@lid' },
+    }),
+    getMessageById: jest.fn().mockResolvedValue(null),
+  };
+  const waha: any = {
+    fetch: jest.fn().mockResolvedValue(Buffer.from('bytes')),
+  };
+  const Cls: any = opts.history
