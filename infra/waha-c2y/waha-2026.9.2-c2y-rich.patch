+import { UnrecoverableError } from 'bullmq';
+import { JestLogger } from '@waha/apps/app_sdk/jest/JestLogger';
+import {
+  C2yEditHandler,
+  ChatWootInboxC2yEditConsumer,
+  ChatWootInboxC2yReactionConsumer,
+  ReportBody,
+  C2yReactionHandler,
+} from '@waha/apps/chatwoot/consumers/inbox/c2y_actions';
+
+const CHAT_ID = '5511999999999@c.us';
+const SESSION = 'hub2you';
+
+const PART = {
+  chat_id: CHAT_ID,
+  message_id: '3EB0ABC',
+  from_me: true,
+  participant: null,
+};
+
+function body(extra: any = {}) {
+  return {
+    id: 501,
+    message_type: 'outgoing',
+    content: 'texto antigo',
+    conversation: { id: 42 },
+    ...extra,
+  };
+}
+
+function setup(parts: any[] = [PART]) {
+  const session: any = {
+    name: SESSION,
+    setReaction: jest.fn().mockResolvedValue({ id: 'R' }),
+    editMessage: jest.fn().mockResolvedValue({ id: 'E' }),
+  };
+  const mapping: any = {
+    getWhatsAppMessage: jest.fn().mockResolvedValue(parts),
+  };
+  const logger = JestLogger();
+  return { session, mapping, logger };
+}
+
+function allLogs(logger: any): string {
+  return ['fatal', 'error', 'warn', 'info', 'debug', 'trace']
+    .flatMap((level) => logger[level].mock.calls)
+    .map((args) => args.map((a) => String(a)).join(' '))
+    .join('\n');
+}
+
+afterEach(() => jest.clearAllMocks());
+
+describe('C2yReactionHandler (c2y-rich-2, item 6)', () => {
+  it('reacts to the mapped WhatsApp message', async () => {
+    const { session, mapping, logger } = setup();
+    const handler = new C2yReactionHandler(mapping, logger, session);
+    await handler.handle(body({ c2y_reaction: { emoji: '👍' } }));
+    expect(mapping.getWhatsAppMessage).toHaveBeenCalledWith({
+      conversation_id: 42,
+      message_id: 501,
+    });
+    expect(session.setReaction).toHaveBeenCalledWith({
+      session: '',
+      messageId: `true_${CHAT_ID}_3EB0ABC`,
+      reaction: '👍',
+    });
+  });
+
+  it('reacts to a customer message (incoming) too', async () => {
+    const { session, mapping, logger } = setup([
+      { ...PART, from_me: false, message_id: 'CUSTOMER1' },
+    ]);
+    const handler = new C2yReactionHandler(mapping, logger, session);
+    await handler.handle(
+      body({ message_type: 'incoming', c2y_reaction: { emoji: '❤️' } }),
+    );
+    expect(session.setReaction.mock.calls[0][0].messageId).toBe(
+      `false_${CHAT_ID}_CUSTOMER1`,
+    );
+  });
+
+  it("'' removes the reaction", async () => {
+    const { session, mapping, logger } = setup();
+    const handler = new C2yReactionHandler(mapping, logger, session);
+    await handler.handle(body({ c2y_reaction: { emoji: '' } }));
+    expect(session.setReaction.mock.calls[0][0].reaction).toBe('');
+  });
+
+  it('without mapping: unrecoverable error (reported at once, no retry)', async () => {
+    const { session, mapping, logger } = setup([]);
+    const handler = new C2yReactionHandler(mapping, logger, session);
+    await expect(
+      handler.handle(body({ c2y_reaction: { emoji: '👍' } })),
+    ).rejects.toBeInstanceOf(UnrecoverableError);
+    expect(session.setReaction).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    [{}],
+    [{ c2y_reaction: null }],
+    [{ c2y_reaction: { emoji: 1 } }],
+    [{ c2y_reaction: { emoji: 'x'.repeat(33) } }],
+  ])('invalid payload %j: nothing is sent', async (extra) => {
+    const { session, mapping, logger } = setup();
+    const handler = new C2yReactionHandler(mapping, logger, session);
+    await expect(handler.handle(body(extra))).resolves.toBeNull();
+    expect(session.setReaction).not.toHaveBeenCalled();
+  });
+
+  it('logs carry no emoji and no phone', async () => {
+    const { session, mapping, logger } = setup();
+    const handler = new C2yReactionHandler(mapping, logger, session);
+    await handler.handle(body({ c2y_reaction: { emoji: '🦄' } }));
+    const logs = allLogs(logger);
+    expect(logs).not.toContain('🦄');
+    expect(logs).not.toContain('5511999999999');
+  });
+});
+
+describe('C2yEditHandler (c2y-rich-2, item 7)', () => {
+  const config: any = { linkPreview: 'OFF' };
+
+  it('edits the single mapped text with the preformatted text', async () => {
+    const { session, mapping, logger } = setup();
+    const handler = new C2yEditHandler(mapping, logger, session, config);
