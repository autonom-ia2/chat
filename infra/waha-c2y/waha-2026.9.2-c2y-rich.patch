+    const { handler, conversation } = setup(locale);
+    await handler.handle(votePayload({}, { selectedOptions: [] }) as any);
+    const body = conversation.send.mock.calls[0][0];
+    expect(body.content).toBe(text);
+    expect(body.content).not.toBe(POLL_VOTE_REMOVED_KEY);
+    expect(body.content_attributes.waha_poll_vote.options).toEqual([]);
+  });
+
+  it.each([[null], [undefined]])(
