+import * as path from 'path';
+import axios from 'axios';
+import { Agent as HttpsAgent } from 'https';
+// @ts-ignore
+import * as UserAgent from 'user-agents';
+
+/**
+ * Autonom.ia patch c2y-rich-2 (autonom-ia2/chat#1709)
+ * Images WhatsApp does not show as a photo (webp, bmp, tiff, avif, heic...)
+ * are converted to JPEG before sendImage. GIF goes as a video (ffmpeg).
+ */
+export const WHATSAPP_VIDEO_MIMETYPE = 'video/mp4';
+export const GIF_MIMETYPE = 'image/gif';
+export const JPEG_MIMETYPE = 'image/jpeg';
+const JPEG_QUALITY = 85;
+
+/**
+ * The image is downloaded into the memory of the WAHA process, shared by
+ * every session. Above this size it is not converted: it goes as a file,
+ * as before the patch. 16 MB is the WhatsApp media limit.
+ */
+export const MAX_IMAGE_DOWNLOAD_BYTES = 16 * 1024 * 1024;
+
+/**
+ * Decoded size bound for sharp (its default is ~268 MP). 50 MP covers the
+ * 48 MP photos of current phones; above it the image goes as a file.
+ */
+export const MAX_IMAGE_INPUT_PIXELS = 50_000_000;
+
+// Same TLS and User-Agent as utils/fetch.ts fetchBuffer (self-hosted Chatwoot)
+const InsecureHttpsAgent = new HttpsAgent({
+  rejectUnauthorized: false,
+});
+
+export interface MediaTools {
+  fetch(url: string): Promise<Buffer>;
+  toJpeg(input: Buffer): Promise<Buffer>;
+}
+
+/**
+ * Downloads at most maxBytes; bigger bodies are aborted while streaming
+ * (axios maxContentLength) and the promise rejects.
+ */
+export async function FetchLimited(
+  url: string,
+  maxBytes: number = MAX_IMAGE_DOWNLOAD_BYTES,
+): Promise<Buffer> {
+  const res = await axios.get(url, {
+    responseType: 'arraybuffer',
+    httpsAgent: InsecureHttpsAgent,
+    headers: {
+      'User-Agent': new UserAgent().toString(),
+    },
+    maxContentLength: maxBytes,
+    maxBodyLength: maxBytes,
+  });
+  return Buffer.from(res.data);
+}
+
+export async function SharpToJpeg(
+  input: Buffer,
+  maxPixels: number = MAX_IMAGE_INPUT_PIXELS,
+): Promise<Buffer> {
+  // CJS module, loaded on first use only
+  // eslint-disable-next-line @typescript-eslint/no-var-requires
+  const sharp = require('sharp');
+  return sharp(input, { limitInputPixels: maxPixels })
+    .rotate()
+    .jpeg({ quality: JPEG_QUALITY })
+    .toBuffer();
+}
+
+export const DefaultMediaTools: MediaTools = {
+  fetch: (url: string) => FetchLimited(url),
+  toJpeg: (input: Buffer) => SharpToJpeg(input),
+};
+
+/** "foto.webp" -> "foto.jpg"; empty name -> "image.jpg" */
+export function JpegFilename(filename: string | undefined | null): string {
+  const name = filename ? path.parse(filename).name : '';
+  return `${name || 'image'}.jpg`;
+}
