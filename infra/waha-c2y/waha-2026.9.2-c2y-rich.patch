+});
+
+/* ------------------------------------------------------------------ */
+/* C2: reaction and edit in the conversation of the target message    */
+/* ------------------------------------------------------------------ */
+
+function inboundSetup(Cls: any, target: any) {
+  const sent: any[] = [];
+  const byContact = {
+    conversationId: 99,
+    send: jest.fn(async (body: any) => {
+      sent.push({ conversation: 99, body });
