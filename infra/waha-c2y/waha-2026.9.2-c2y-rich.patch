diff --git a/src/apps/chatwoot/consumers/waha/event.response.test.ts b/src/apps/chatwoot/consumers/waha/event.response.test.ts
new file mode 100644
index 00000000..4e0c7367
--- /dev/null
+++ b/src/apps/chatwoot/consumers/waha/event.response.test.ts
@@ -0,0 +1,266 @@
+// The real helper pulls ESM-only Baileys, which jest can not load
+jest.mock('@waha/apps/chatwoot/waha', () => ({ EngineHelper: {} }));
+
+import { JestLogger } from '@waha/apps/app_sdk/jest/JestLogger';
+import {
+  EVENT_RESPONSE_KEYS,
+  EventResponseHandler,
+  SentByConnector,
+} from '@waha/apps/chatwoot/consumers/waha/event.response';
+import { ListenEventsForChatWoot } from '@waha/apps/chatwoot/consumers/waha/base';
+import { QueueName } from '@waha/apps/chatwoot/consumers/QueueName';
+import { i18n } from '@waha/apps/chatwoot/i18n';
+import { ChatWootWAHAQueueService } from '@waha/apps/chatwoot/services/ChatWootWAHAQueueService';
+import { WAHAEvents } from '@waha/structures/enums.dto';
+
+const CUSTOMER = '5511999999999@c.us';
+const ME = '5511888888888@c.us';
+const EVENT_WA_ID = '3EB0EVENT0000000001';
+
+function payload(extra: any = {}, response: any = {}, key?: string) {
+  return {
+    id: `false_${CUSTOMER}_RESP1`,
+    from: CUSTOMER,
+    fromMe: false,
+    timestamp: 1760620000,
+    // as GOWS gives it: the key as the customer wrote it (points to us)
+    eventCreationKey: {
+      id: key ?? `false_${ME}_${EVENT_WA_ID}`,
+      to: ME,
+      from: ME,
+    },
+    eventResponse: {
+      response: 'GOING',
+      timestampMs: 1760620000123,
+      extraGuestCount: 0,
+      ...response,
+    },
+    _data: {},
+    ...extra,
+  } as any;
+}
+
+// parts: set by message_created only when the connector sends the event
+function setup(
+  locale = 'en-US',
+  existing: any = null,
+  eventRow: any = { id: 1, conversation_id: 42, message_id: 900, parts: 1 },
+) {
+  const mapping: any = {
+    getChatWootMessage: jest.fn(async (key) => {
+      if (key.message_id === EVENT_WA_ID) return eventRow;
+      if (key.message_id === 'RESP1') return existing;
+      return null;
+    }),
+    map: jest.fn().mockResolvedValue(undefined),
+  };
+  const conversation: any = {
+    send: jest.fn().mockResolvedValue({
+      id: 1001,
+      conversation_id: 42,
+      created_at: 1760620001,
+    }),
+  };
+  const repo: any = { ConversationById: jest.fn(() => conversation) };
+  const info: any = { onConversationId: jest.fn(), onMessageType: jest.fn() };
+  const session: any = {
+    getSessionInfo: jest.fn().mockResolvedValue({
+      me: { id: ME, lid: '777@lid' },
+    }),
+  };
+  const logger = JestLogger();
+  const handler = new EventResponseHandler(
+    mapping,
+    repo,
+    logger,
+    i18n.locale(locale),
+    info,
+    session,
+  );
+  return { handler, mapping, conversation, session, info, logger };
+}
+
+describe('event.response (item 13)', () => {
+  it.each([
+    ['GOING', 'going', 'Going'],
+    ['NOT_GOING', 'not_going', 'Not going'],
+    ['MAYBE', 'maybe', 'Maybe'],
+  ])('%s on our event: incoming answer + waha_event_response', async (engine, answer, text) => {
+    const { handler, conversation, mapping, info } = setup();
+    const result = await handler.handle(
+      payload({}, { response: engine, extraGuestCount: 2 }),
+    );
+    expect(conversation.send).toHaveBeenCalledTimes(1);
+    expect(result).toEqual({
+      content: text,
+      message_type: 'incoming',
+      private: false,
+      content_attributes: {
+        in_reply_to: 900,
+        waha_event_response: {
+          event_message_id: 900,
+          response: answer,
+          extra_guests: 2,
+          response_id: `false_${CUSTOMER}_RESP1`,
+          timestamp: 1760620000123,
+        },
+      },
+    });
+    expect(info.onConversationId).toHaveBeenCalledWith(42);
+    expect(mapping.map).toHaveBeenCalledWith(
+      { timestamp: new Date(1760620001000), conversation_id: 42, message_id: 1001 },
+      expect.objectContaining({ message_id: 'RESP1', chat_id: CUSTOMER }),
+      1,
+    );
+  });
+
+  it('pt-BR texts', async () => {
+    const texts = [];
+    for (const response of ['GOING', 'NOT_GOING', 'MAYBE']) {
+      const { handler } = setup('pt-BR');
+      texts.push((await handler.handle(payload({}, { response }))).content);
+    }
+    expect(texts).toEqual(['Vou', 'Não vou', 'Talvez']);
+  });
+
+  it('locale without the keys falls back to English', async () => {
+    const { handler } = setup('es-ES');
+    expect((await handler.handle(payload())).content).toBe('Going');
+  });
+
+  it('key in our own perspective (fromMe true, chat = customer) is also ours', async () => {
+    const { handler, conversation } = setup();
+    await handler.handle(payload({}, {}, `true_${CUSTOMER}_${EVENT_WA_ID}`));
+    expect(conversation.send).toHaveBeenCalledTimes(1);
+  });
+
+  it('key pointing to our lid', async () => {
+    const { handler, conversation } = setup();
+    await handler.handle(payload({}, {}, `false_777@lid_${EVENT_WA_ID}`));
+    expect(conversation.send).toHaveBeenCalledTimes(1);
+  });
+
+  it("customer's own event (fromMe true in the customer's key): ignored", async () => {
+    const { handler, conversation } = setup();
+    const r = await handler.handle(payload({}, {}, `true_${ME}_${EVENT_WA_ID}`));
+    expect(r).toBeNull();
+    expect(conversation.send).not.toHaveBeenCalled();
+  });
+
+  it('event of someone else (customer perspective, other chat): ignored', async () => {
+    const { handler, conversation } = setup();
+    const r = await handler.handle(
+      payload({}, {}, `false_${CUSTOMER}_${EVENT_WA_ID}`),
+    );
+    expect(r).toBeNull();
+    expect(conversation.send).not.toHaveBeenCalled();
+  });
+
+  it('group: ours when the key participant is our number', async () => {
+    const group = '120363000000000000@g.us';
+    const { handler, conversation } = setup();
+    await handler.handle(
+      payload({ from: group }, {}, `false_${group}_${EVENT_WA_ID}_${ME}`),
+    );
+    expect(conversation.send).toHaveBeenCalledTimes(1);
+    const other = setup();
+    await other.handler.handle(
+      payload({ from: group }, {}, `false_${group}_${EVENT_WA_ID}_${CUSTOMER}`),
+    );
+    expect(other.conversation.send).not.toHaveBeenCalled();
+  });
+
+  // Review c2y-rich-3 (finding 1)
+  it.each([
+    ['parts null (mirrored from the phone)', null],
+    ['parts missing', undefined],
+  ])('event created on the business phone (%s): ignored, nothing created', async (_n, parts) => {
+    const row = { id: 1, conversation_id: 42, message_id: 900, parts: parts };
+    const { handler, conversation, mapping } = setup('en-US', null, row);
+    expect(await handler.handle(payload())).toBeNull();
+    expect(conversation.send).not.toHaveBeenCalled();
+    expect(mapping.map).not.toHaveBeenCalled();
+  });
+
+  it('SentByConnector', () => {
+    expect(SentByConnector({ parts: 1 } as any)).toBe(true);
+    expect(SentByConnector({ parts: 3 } as any)).toBe(true);
+    expect(SentByConnector({ parts: null } as any)).toBe(false);
+    expect(SentByConnector({} as any)).toBe(false);
+    expect(SentByConnector({ parts: 0 } as any)).toBe(false);
+    expect(SentByConnector(null)).toBe(false);
+  });
+
+  // Review c2y-rich-3 (finding 4): the mapping lookup is by message id only
+  // (WhatsAppMessageRepository.getByMessageId: app_pk + message_id), so a
+  // customer answering from a @lid jid still finds the event.
+  it('customer answering from a @lid jid: found by the event message id', async () => {
+    const { handler, conversation, mapping } = setup();
+    await handler.handle(payload({ from: '123456789@lid' }));
+    expect(conversation.send).toHaveBeenCalledTimes(1);
+    expect(mapping.getChatWootMessage).toHaveBeenCalledWith(
+      expect.objectContaining({ message_id: EVENT_WA_ID }),
+    );
+  });
+
+  it('event not mapped: ignored', async () => {
+    const { handler, conversation } = setup();
+    const r = await handler.handle(payload({}, {}, `false_${ME}_OTHERID`));
+    expect(r).toBeNull();
+    expect(conversation.send).not.toHaveBeenCalled();
+  });
+
+  it('answer from the business phone: ignored', async () => {
+    const { handler, conversation, session } = setup();
+    expect(await handler.handle(payload({ fromMe: true }))).toBeNull();
+    expect(conversation.send).not.toHaveBeenCalled();
+    expect(session.getSessionInfo).not.toHaveBeenCalled();
+  });
+
+  it.each(['UNKNOWN', undefined, null])('answer %p: ignored', async (response) => {
+    const { handler, conversation } = setup();
+    expect(await handler.handle(payload({}, { response }))).toBeNull();
+    expect(conversation.send).not.toHaveBeenCalled();
+  });
+
+  it('same response twice (retry): created once', async () => {
+    const { handler, conversation } = setup('en-US', { message_id: 1001 });
+    expect(await handler.handle(payload())).toBeNull();
+    expect(conversation.send).not.toHaveBeenCalled();
+  });
+
+  it('own number not readable: throws (job retried), log by class only', async () => {
+    const { handler, session, logger, conversation } = setup();
+    session.getSessionInfo.mockRejectedValueOnce(
+      new TypeError('key secret 5511999999999'),
+    );
+    await expect(handler.handle(payload())).rejects.toThrow(TypeError);
+    expect(conversation.send).not.toHaveBeenCalled();
+    const warn = String((logger.warn as jest.Mock).mock.calls[0][0]);
+    expect(warn).toContain('(TypeError)');
+    expect(warn).not.toContain('5511');
+  });
+
+  it('i18n keys exist in en-US and pt-BR', () => {
+    for (const key of Object.values(EVENT_RESPONSE_KEYS)) {
+      expect(i18n.locale('en-US').r(key)).not.toBe(key);
+      expect(i18n.locale('pt-BR').r(key)).not.toBe(key);
+    }
+  });
+
+  it('connector listens to event.response and routes it to its queue', () => {
+    const service0 = new ChatWootWAHAQueueService({
+      queue: jest.fn((name) => name),
+    } as any);
+    const events = ListenEventsForChatWoot({
+      conversations: { markAsRead: false, syncMessageStatus: false },
+    } as any);
+    expect(events).toContain(WAHAEvents.EVENT_RESPONSE);
+    expect(events).not.toContain(WAHAEvents.EVENT_RESPONSE_FAILED);
+    expect((service0 as any).getQueueForEvent(WAHAEvents.EVENT_RESPONSE_FAILED)).toBeNull();
+    const service = service0;
+    expect((service as any).getQueueForEvent(WAHAEvents.EVENT_RESPONSE)).toBe(
+      QueueName.WAHA_EVENT_RESPONSE,
+    );
+  });
+});
