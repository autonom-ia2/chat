+    expect(session.sendPoll).toHaveBeenCalledTimes(1);
+    const [request, opts] = session.sendPoll.mock.calls[0];
+    expect(request).toEqual({
+      session: '',
+      chatId: CHAT_ID,
+      id: DeterministicMessageId(SESSION, 777, 'sendPoll'),
+      poll: POLL,
+      reply_to: undefined,
+    });
+    expect(opts.signal).toBeDefined();
+    expect(session.sendText).not.toHaveBeenCalled();
+    expect(mapping.map).toHaveBeenCalledTimes(1);
+    expect(result).toHaveLength(1);
+  });
+
+  it('refused poll (422): sends the numbered text once', async () => {
+    const { handler, session } = setup();
+    const err: any = new Error('Request failed with status code 422');
+    err.response = { status: 422 };
+    session.sendPoll.mockRejectedValue(err);
+    await handler.handle(
+      chatwootMessage({
+        content: 'Qual plano?\n\n1. Básico\n2. Completo',
+        content_attributes: {
+          waha_native: { kind: 'sendPoll', payload: { poll: POLL } },
+        },
+      }),
+    );
+    expect(session.sendText).toHaveBeenCalledTimes(1);
+    expect(session.sendText.mock.calls[0][0].text).toContain('1. Básico');
+  });
+});
+
+describe('MessageHandler - waha_text (c2y-rich-2, item 8)', () => {
+  it('without the key: converts markdown as before', async () => {
+    const { handler, session } = setup();
+    await handler.handle(chatwootMessage());
+    expect(session.sendText.mock.calls[0][0].text).toBe('Olá *cliente*');
+  });
+
+  it('with the key: sends waha_text as is, no markdown conversion', async () => {
+    const { handler, session } = setup();
+    const wahaText = 'Olá *cliente* _it_ ~risco~ `x` 2*3*4 a**b**c';
+    await handler.handle(
+      chatwootMessage({ content_attributes: { waha_text: wahaText } }),
+    );
+    expect(session.sendText.mock.calls[0][0].text).toBe(wahaText);
+  });
+
+  it('with the key in a group: mentions are read from waha_text', async () => {
+    const { handler, session } = setup();
+    await handler.handle(
+      chatwootMessage(
+        { content_attributes: { waha_text: 'Oi @5511988887777 tudo *bem*' } },
+        GROUP_ID,
+      ),
+    );
+    const request = session.sendText.mock.calls[0][0];
+    expect(request.mentions).toEqual(['5511988887777@c.us']);
+    expect(request.text).toContain('tudo *bem*');
+  });
+
+  it('ignores a non-string waha_text', async () => {
+    const { handler, session } = setup();
+    await handler.handle(
+      chatwootMessage({ content_attributes: { waha_text: { x: 1 } } }),
+    );
+    expect(session.sendText.mock.calls[0][0].text).toBe('Olá *cliente*');
+  });
+
+  it('caption of a single attachment uses waha_text too', async () => {
+    const { handler, session } = setup();
+    await handler.handle(
+      chatwootMessage({
+        content_attributes: { waha_text: 'legenda *pronta*' },
+        attachments: [attachment('foto.jpg', 'image')],
+      }),
