diff --git a/src/apps/chatwoot/messages/to/chatwoot/ViewOnceNotice.ts b/src/apps/chatwoot/messages/to/chatwoot/ViewOnceNotice.ts
new file mode 100644
index 00000000..f791f1d6
--- /dev/null
+++ b/src/apps/chatwoot/messages/to/chatwoot/ViewOnceNotice.ts
@@ -0,0 +1,72 @@
+import { parseMessageIdSerialized } from '@waha/core/utils/ids';
+import { toCusFormat } from '@waha/core/utils/jids';
+
+/**
+ * Autonom.ia patch c2y-rich-4 (autonom-ia2/chat#1709)
+ *
+ * The view once notice is mapped under its own WhatsApp id (real id + suffix),
+ * like the upstream fake call ids. So:
+ * - a second UndecryptableMessage for the same id finds the notice and stops;
+ * - the real message (if the phone ever resends the content) is NOT taken for
+ *   a duplicate: it keeps its own id, gets its media, and carries
+ *   waha_view_once_resolved pointing to the notice, so chat2you replaces it.
+ * WhatsApp ids are alphanumeric: the '-' keeps the two apart.
+ */
+export const VIEW_ONCE_NOTICE_KEY =
+  'whatsapp.to.chatwoot.message.view_once.unavailable';
+
+const NOTICE_SUFFIX = '-C2YVO';
+
+export interface WahaViewOnceUnavailable {
+  from_me: false;
+  id: string;
+}
+
+export interface WahaViewOnceResolved {
+  id: string;
+  notice_message_id: number;
+}
+
+export interface MappingKey {
+  chat_id: string;
+  message_id: string;
+}
+
+/**
+ * <ID> -> <ID>-C2YVO. Also works on a serialized 1:1 id
+ * (false_<chat>_<ID> -> false_<chat>_<ID>-C2YVO): it has no participant part.
+ */
+export function NoticeWhatsAppId(id: string): string {
+  return `${id}${NOTICE_SUFFIX}`;
+}
+
+/** Mapping key of the notice for a real serialized message id */
+export function NoticeMappingKey(serialized: string): MappingKey {
+  const key = parseMessageIdSerialized(serialized);
+  return {
+    chat_id: toCusFormat(key.remoteJid),
+    message_id: NoticeWhatsAppId(key.id),
+  };
+}
+
+/** Mapping key of the real message for a real serialized message id */
+export function RealMappingKey(serialized: string): MappingKey {
+  const key = parseMessageIdSerialized(serialized);
+  return { chat_id: toCusFormat(key.remoteJid), message_id: key.id };
+}
+
+/**
+ * The WhatsApp id mapped to a Chatwoot message is the notice's fake id: it
+ * does not exist on WhatsApp, so it must never be quoted, reacted to, edited
+ * or deleted there.
+ */
+export function IsViewOnceNoticeId(messageId: unknown): boolean {
+  return typeof messageId === 'string' && messageId.endsWith(NOTICE_SUFFIX);
+}
+
+/** Any mapped part of the Chatwoot message is the notice */
+export function HasViewOnceNotice(
+  parts: Array<{ message_id?: string | null }> | null | undefined,
+): boolean {
+  return (parts || []).some((part) => IsViewOnceNoticeId(part?.message_id));
+}
diff --git a/src/apps/chatwoot/messages/to/chatwoot/c2y3.retry.ts b/src/apps/chatwoot/messages/to/chatwoot/c2y3.retry.ts
new file mode 100644
index 00000000..4ce35524
--- /dev/null
+++ b/src/apps/chatwoot/messages/to/chatwoot/c2y3.retry.ts
@@ -0,0 +1,108 @@
+import { ILogger } from '@waha/apps/app_sdk/ILogger';
+import { IsMediaDownloadFailure } from '@waha/apps/chatwoot/messages/to/chatwoot/c2y3';
+import { EngineHelper } from '@waha/apps/chatwoot/waha';
+import { parseMessageIdSerialized } from '@waha/core/utils/ids';
+import { WAMessage } from '@waha/structures/responses.dto';
+import { sleep } from '@waha/utils/promiseTimeout';
+
+/**
+ * Autonom.ia patch c2y-rich-3 (autonom-ia2/chat#1709, round 2, item 6)
+ *
+ * The engine could not download the media of an incoming message. Ask it
+ * again (GetMessageById + download) a couple of times before the connector
+ * gives up and creates the "media not downloaded" message.
+ *
+ * OFF unless WAHA_C2Y_MEDIA_RETRY=true: when it works it changes what an
+ * account without the chat2you flag sees (media instead of the warning), so
+ * it waits for Rodrigo's decision.
+ *
+ * The job holds the chat mutex for at most JOB_LOCK_TTL (20 s), so the whole
+ * retry (waits + calls) stays under 14 s.
+ */
+export const MEDIA_RETRY_ENV = 'WAHA_C2Y_MEDIA_RETRY';
+export const MEDIA_RETRY_WAITS_MS: readonly number[] = [2_000, 4_000];
+export const MEDIA_RETRY_TIMEOUT_MS = 4_000;
+
+export interface MediaRetryOptions {
+  enabled: boolean;
+  waitsMs: readonly number[];
+  timeoutMs: number;
+  sleep?: (ms: number) => Promise<void>;
+}
+
+export function MediaRetryFromEnv(
+  env: Record<string, string | undefined> = process.env,
+): MediaRetryOptions {
+  return {
+    enabled: env[MEDIA_RETRY_ENV] === 'true',
+    waitsMs: MEDIA_RETRY_WAITS_MS,
+    timeoutMs: MEDIA_RETRY_TIMEOUT_MS,
+  };
+}
+
+export interface MessageByIdSource {
+  getMessageById(
+    chatId: string,
+    messageId: string,
+    media: boolean,
+    opts?: { signal?: AbortSignal },
+  ): Promise<any>;
+}
+
+function shortId(id: string): string {
+  try {
+    return parseMessageIdSerialized(id, true)?.id || 'unknown';
+  } catch (err) {
+    return 'unknown';
+  }
+}
+
+function errorKind(err: any): string {
+  return err?.name || err?.constructor?.name || typeof err;
+}
+
+/**
+ * Same payload with the downloaded media, or the payload untouched.
+ * Never throws. Logs only the WhatsApp message id (no chat, phone or text).
+ */
+export async function RetryMediaDownload(
+  payload: WAMessage,
+  source: MessageByIdSource,
+  logger: ILogger,
+  options: MediaRetryOptions,
+): Promise<WAMessage> {
+  if (!options.enabled || !IsMediaDownloadFailure(payload)) {
+    return payload;
+  }
+  const wait = options.sleep ?? sleep;
+  const id = shortId(payload.id);
+  let chatId: string;
+  try {
+    chatId = EngineHelper.ChatID(payload);
+  } catch (err) {
+    return payload;
+  }
+  for (let attempt = 0; attempt < options.waitsMs.length; attempt++) {
+    await wait(options.waitsMs[attempt]);
+    try {
+      const fresh = await source.getMessageById(chatId, payload.id, true, {
+        signal: AbortSignal.timeout(options.timeoutMs),
+      });
+      const url = fresh?.media?.url;
+      if (typeof url === 'string' && url) {
+        logger.info(
+          `WhatsApp => ChatWoot: media downloaded on retry ${attempt + 1}: message_id=${id}`,
+        );
+        return { ...payload, media: fresh.media };
+      }
+    } catch (err) {
+      logger.warn(
+        `WhatsApp => ChatWoot: media retry ${attempt + 1} failed (${errorKind(err)}): message_id=${id}`,
+      );
+    }
+  }
+  logger.warn(
+    `WhatsApp => ChatWoot: media not downloaded after ${options.waitsMs.length} retries: message_id=${id}`,
+  );
+  return payload;
+}
