@@ -56,3 +56,37 @@ export function BuildCallMessagePayload(
     source: MessageSource.APP,
   };
 }
+
+/**
+ * Autonom.ia c2y-rich-2: structured call data next to the unchanged content.
+ * content_attributes.waha_call - chat2you turns it into an activity notice
+ * only for accounts with the feature on, and removes it otherwise.
+ */
+export interface WahaCall {
+  call_id: string;
+  event: 'received' | 'accepted' | 'rejected';
+  is_video: boolean;
+  by_me: boolean;
+  reason: string | null;
+}
+
+const WAHA_CALL_EVENT = {
+  [WAHAEvents.CALL_RECEIVED]: 'received',
+  [WAHAEvents.CALL_ACCEPTED]: 'accepted',
+  [WAHAEvents.CALL_REJECTED]: 'rejected',
+} as const;
+
+export function BuildWahaCall(
+  payload: CallMessagePayload,
+  event: Events,
+  byMe: boolean,
+): WahaCall {
+  const reason = payload._data?.Reason;
+  return {
+    call_id: payload.callId,
+    event: WAHA_CALL_EVENT[event],
+    is_video: Boolean(payload.isVideo),
+    by_me: byMe,
+    reason: typeof reason === 'string' ? reason : null,
+  };
+}
