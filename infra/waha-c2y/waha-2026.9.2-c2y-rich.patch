+import { UnrecoverableError } from 'bullmq';
+import {
+  BuildWahaNativeRequest,
+  DeterministicMessageId,
+  IsDefinitiveRefusal,
+  ParseWahaNative,
+  WahaHttpStatus,
+  WahaNativeSendError,
+} from '@waha/apps/chatwoot/messages/to/whatsapp/native';
+
+const LIST_PAYLOAD = {
+  message: {
+    title: 'Planos',
+    description: 'Escolha um plano',
+    footer: 'Hub2You',
+    button: 'Ver planos',
+    sections: [
+      { title: 'Auto', rows: [{ title: 'Básico', rowId: 'auto_basico' }] },
+    ],
+  },
+};
+
+describe('ParseWahaNative', () => {
+  it('reads a known kind with an object payload', () => {
+    const native = ParseWahaNative({
+      content_attributes: {
+        waha_native: { kind: 'sendList', payload: LIST_PAYLOAD },
+      },
+    });
+    expect(native).toEqual({ kind: 'sendList', payload: LIST_PAYLOAD });
+  });
+
+  it.each([
+    [undefined],
+    [{}],
+    [{ waha_native: null }],
+    [{ waha_native: 'sendList' }],
+    [{ waha_native: { kind: 'sendButtons', payload: {} } }],
+    [{ waha_native: { kind: 'sendText', payload: { text: 'x' } } }],
+    [{ waha_native: { kind: 'sendLocation' } }],
+    [{ waha_native: { kind: 'sendLocation', payload: [1, 2] } }],
+    [{ waha_native: { kind: 'sendLocation', payload: 'x' } }],
+  ])('ignores invalid content_attributes %j', (attrs) => {
+    expect(ParseWahaNative({ content_attributes: attrs })).toBeNull();
+  });
+
+  it('ignores a message without content_attributes', () => {
+    expect(ParseWahaNative({})).toBeNull();
+    expect(ParseWahaNative(null)).toBeNull();
+  });
+});
+
+describe('BuildWahaNativeRequest', () => {
+  const chatId = '5511999999999@c.us';
+  const replyTo = 'true_5511999999999@c.us_3EB0AAAA';
+
+  it('list: chatId comes from the connector, never from the payload', () => {
+    const request = BuildWahaNativeRequest(
+      {
+        kind: 'sendList',
+        payload: {
+          ...LIST_PAYLOAD,
+          chatId: 'attacker@c.us',
+          session: 'other',
+        },
+      },
+      chatId,
+      replyTo,
+      'ID',
+    );
+    expect(request).toEqual({
+      session: '',
+      chatId: chatId,
+      message: LIST_PAYLOAD.message,
+      reply_to: replyTo,
+    });
+  });
+
+  it('location: copies only the endpoint fields and the deterministic id', () => {
+    const request = BuildWahaNativeRequest(
+      {
+        kind: 'sendLocation',
+        payload: {
+          latitude: -23.5,
+          longitude: -46.6,
+          title: 'Escritório',
+          chatId: 'attacker@c.us',
+          extra: 'drop me',
+        },
+      },
+      chatId,
+      undefined,
+      '3EB0ID',
+    );
+    expect(request).toEqual({
+      session: '',
+      chatId: chatId,
+      id: '3EB0ID',
+      latitude: -23.5,
+      longitude: -46.6,
+      title: 'Escritório',
+      reply_to: undefined,
+    });
+  });
+
+  it('contact: copies contacts and the deterministic id', () => {
+    const contacts = [
+      {
+        fullName: 'Maria',
+        organization: 'Hub2You',
+        phoneNumber: '+55 11 99999-9999',
+        whatsappId: '5511999999999',
+      },
+    ];
+    const request = BuildWahaNativeRequest(
+      {
+        kind: 'sendContactVcard',
+        payload: { contacts: contacts, session: 'other' },
+      },
+      chatId,
+      replyTo,
+      '3EB0ID',
+    );
+    expect(request).toEqual({
+      session: '',
+      chatId: chatId,
+      id: '3EB0ID',
+      contacts: contacts,
+      reply_to: replyTo,
+    });
+  });
+});
+
+describe('DeterministicMessageId', () => {
+  it('is stable for the same Chatwoot message', () => {
+    const a = DeterministicMessageId('default', 123, 'sendLocation');
+    const b = DeterministicMessageId('default', 123, 'sendLocation');
+    expect(a).toEqual(b);
+    expect(a).toMatch(/^3EB0[0-9A-F]{18}$/);
+  });
+
+  it('changes with message, session and kind', () => {
+    const base = DeterministicMessageId('default', 123, 'sendLocation');
+    expect(DeterministicMessageId('default', 124, 'sendLocation')).not.toEqual(
+      base,
+    );
+    expect(DeterministicMessageId('other', 123, 'sendLocation')).not.toEqual(
+      base,
+    );
+    expect(
+      DeterministicMessageId('default', 123, 'sendContactVcard'),
+    ).not.toEqual(base);
+  });
+});
+
+describe('error classification', () => {
+  it.each([
+    [400, true],
+    [404, true],
+    [422, true],
+    [499, true],
+    [501, true],
+    [500, false],
+    [502, false],
+    [503, false],
+    [504, false],
+    [null, false],
+  ])('status %p definitive=%p', (status, expected) => {
+    expect(IsDefinitiveRefusal(status)).toBe(expected);
+  });
+
+  it('reads the HTTP status of an axios-like error', () => {
+    expect(WahaHttpStatus({ response: { status: 422 } })).toBe(422);
+    expect(WahaHttpStatus({ code: 'ECONNABORTED' })).toBeNull();
+    expect(WahaHttpStatus(new Error('boom'))).toBeNull();
+  });
+
+  it('WahaNativeSendError is unrecoverable and carries only safe fields', () => {
+    const err = new WahaNativeSendError('sendList', 500, 77);
+    expect(err).toBeInstanceOf(UnrecoverableError);
+    expect(err.name).toBe('UnrecoverableError');
+    expect(err.message).toContain('kind=sendList');
+    expect(err.message).toContain('status=500');
+    expect(err.message).toContain('chatwoot_message_id=77');
+    const timeout = new WahaNativeSendError('sendLocation', null, 78);
+    expect(timeout.message).toContain('status=no-response');
+  });
+});
diff --git a/src/apps/chatwoot/messages/to/whatsapp/native.ts b/src/apps/chatwoot/messages/to/whatsapp/native.ts
new file mode 100644
index 00000000..bab676ae
--- /dev/null
+++ b/src/apps/chatwoot/messages/to/whatsapp/native.ts
@@ -0,0 +1,290 @@
+import { createHash } from 'node:crypto';
+import { UnrecoverableError } from 'bullmq';
+import { MessageContactVcardRequest } from '@waha/structures/chatting.dto';
+import { MessageLocationRequest } from '@waha/structures/chatting.dto';
+import { MessagePollRequest } from '@waha/structures/chatting.dto';
+import { SendListRequest } from '@waha/structures/chatting.list.dto';
+import { MessageLinkCustomPreviewRequest } from '@waha/structures/chatting.dto';
+import { EventMessageRequest } from '@waha/structures/events.dto';
+
+/**
+ * Autonom.ia patch c2y-rich-1/c2y-rich-2/c2y-rich-3 (autonom-ia2/chat#1709)
+ * Chatwoot message -> native WhatsApp message (list, location, contact, poll,
+ * link card with custom preview, event)
+ * Contract: content_attributes.waha_native = {kind, payload}
+ * payload follows the WAHA endpoint body WITHOUT chatId and session.
+ */
+export const WAHA_NATIVE_KINDS = [
+  'sendList',
+  'sendLocation',
+  'sendContactVcard',
+  'sendPoll',
+  // Autonom.ia c2y-rich-3
+  'sendLinkCustomPreview',
+  'sendEvent',
+] as const;
+
+export type WahaNativeKind = (typeof WAHA_NATIVE_KINDS)[number];
+
+export interface WahaNative {
+  kind: WahaNativeKind;
+  payload: Record<string, any>;
+}
+
+export type WahaNativeRequest =
+  | SendListRequest
+  | MessageLocationRequest
+  | MessageContactVcardRequest
+  | MessagePollRequest
+  | MessageLinkCustomPreviewRequest
+  | EventMessageRequest;
+
+const HTTP_NOT_IMPLEMENTED = 501;
+
+/**
+ * Time limit for one native send call to the local WAHA API.
+ * Beyond it the send is treated as uncertain (could have been delivered).
+ */
+export const WAHA_NATIVE_SEND_TIMEOUT_MS = 60_000;
+
+export function ParseWahaNative(message: any): WahaNative | null {
+  const native = message?.content_attributes?.waha_native;
+  if (!native || typeof native !== 'object') {
+    return null;
+  }
+  if (!WAHA_NATIVE_KINDS.includes(native.kind)) {
+    return null;
+  }
+  const payload = native.payload;
+  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) {
+    return null;
+  }
+  return { kind: native.kind, payload: payload };
+}
+
+/**
+ * Deterministic WhatsApp message id from the Chatwoot message id,
+ * so a manual re-run of the same job can not deliver a second copy.
+ * Same shape as whatsmeow/Baileys ids: "3EB0" + 18 upper hex chars.
+ * The seed keeps "c2y-rich-1" on purpose: ids stay stable across patches,
+ * and a poll vote is matched against the id of the poll (c2y-rich-2).
+ */
+export function DeterministicMessageId(
+  session: string,
+  chatwootMessageId: number | string,
+  kind: WahaNativeKind,
+): string {
+  const seed = `autonomia:c2y-rich-1:${session}:${chatwootMessageId}:${kind}`;
+  const hash = createHash('sha256').update(seed).digest('hex');
+  return `3EB0${hash.slice(0, 18).toUpperCase()}`;
+}
+
+/**
+ * Build the WAHA request from the payload.
+ * chatId and session ALWAYS come from the connector, never from the payload.
+ * Only the documented fields of each endpoint are copied.
+ */
+export function BuildWahaNativeRequest(
+  native: WahaNative,
+  chatId: string,
+  replyTo: string | undefined,
+  id: string,
+): WahaNativeRequest {
+  const p = native.payload;
+  switch (native.kind) {
+    case 'sendList':
+      return {
+        session: '',
+        chatId: chatId,
+        message: p.message,
+        reply_to: replyTo,
+      };
+    case 'sendLocation':
+      return {
+        session: '',
+        chatId: chatId,
+        id: id,
+        latitude: p.latitude,
+        longitude: p.longitude,
+        title: p.title,
+        reply_to: replyTo,
+      };
+    case 'sendContactVcard':
+      return {
+        session: '',
+        chatId: chatId,
+        id: id,
+        contacts: p.contacts,
+        reply_to: replyTo,
+      };
+    case 'sendPoll':
+      return {
+        session: '',
+        chatId: chatId,
+        id: id,
+        poll: {
+          name: p.poll?.name,
+          options: p.poll?.options,
+          multipleAnswers: Boolean(p.poll?.multipleAnswers),
+        },
+        reply_to: replyTo,
+      };
+    case 'sendLinkCustomPreview': {
+      // Autonom.ia c2y-rich-3: no id - the endpoint does not accept one
+      const preview = p.preview || {};
+      const image = preview.image;
+      return {
+        session: '',
+        chatId: chatId,
+        text: p.text,
+        linkPreviewHighQuality: true,
+        preview: {
+          url: preview.url,
+          title: preview.title,
+          description: preview.description,
+          image:
+            image && typeof image === 'object'
+              ? ({ url: image.url, mimetype: image.mimetype } as any)
+              : undefined,
+        },
+        reply_to: replyTo,
+      };
+    }
+    case 'sendEvent': {
+      // Autonom.ia c2y-rich-3: no id - the endpoint does not accept one
+      const event = p.event || {};
+      const locationName = event.location?.name;
+      return {
+        chatId: chatId,
+        event: {
+          name: event.name,
+          description: event.description,
+          startTime: event.startTime,
+          endTime: event.endTime,
+          location: locationName ? { name: locationName } : undefined,
+          extraGuestsAllowed: false,
+        },
+        reply_to: replyTo,
+      };
+    }
+  }
+}
+
+function isHttpUrl(value: unknown): boolean {
+  if (typeof value !== 'string' || !value) {
+    return false;
+  }
+  try {
+    const url = new URL(value);
+    return url.protocol === 'https:' || url.protocol === 'http:';
+  } catch (err) {
+    return false;
+  }
+}
+
+function isText(value: unknown): boolean {
+  return typeof value === 'string' && value.trim().length > 0;
+}
+
+function isEpochSeconds(value: unknown): boolean {
+  return typeof value === 'number' && Number.isInteger(value) && value > 0;
+}
+
+/**
+ * Autonom.ia c2y-rich-3: why the request can not go to WAHA as is, or null.
+ * A request with a problem is never sent: the caller sends the text once.
+ * Needed because WAHA answers 500 (not 4xx) for some of these, which the
+ * connector reads as an uncertain send and would not fall back to text.
+ */
+export function NativeRequestProblem(
+  kind: WahaNativeKind,
+  request: WahaNativeRequest,
+): string | null {
+  if (kind === 'sendLinkCustomPreview') {
+    const r = request as MessageLinkCustomPreviewRequest;
+    if (!isText(r.text)) return 'text';
+    if (!isHttpUrl(r.preview?.url)) return 'preview.url';
+    // The controller throws (500) when the text lacks the url
+    if (!r.text.includes(r.preview.url)) return 'text-without-url';
+    if (typeof r.preview.title !== 'string') return 'preview.title';
+    if (typeof r.preview.description !== 'string') {
+      return 'preview.description';
+    }
+    return null;
+  }
+  if (kind === 'sendEvent') {
+    const event = (request as EventMessageRequest).event;
+    if (!event || !isText(event.name)) return 'event.name';
+    if (!isEpochSeconds(event.startTime)) return 'event.startTime';
+    if (event.endTime !== undefined && event.endTime !== null) {
+      if (!isEpochSeconds(event.endTime)) return 'event.endTime';
+      if (event.endTime <= event.startTime) return 'event.endTime';
+    }
+    if (
+      event.description !== undefined &&
+      event.description !== null &&
+      typeof event.description !== 'string'
+    ) {
+      return 'event.description';
+    }
+    return null;
+  }
+  return null;
+}
+
+/**
+ * Autonom.ia c2y-rich-3: link card without an image. GOWS needs the image
+ * (fileToMedia(undefined) -> 500), so it goes as text with the automatic
+ * link preview instead.
+ */
+export function HasPreviewImage(request: WahaNativeRequest): boolean {
+  const image = (request as MessageLinkCustomPreviewRequest)?.preview
+    ?.image as any;
+  return Boolean(image) && isHttpUrl(image.url);
+}
+
+/**
+ * HTTP status of a failed call to the local WAHA API, null when there is no
+ * response (timeout, abort, connection error).
+ */
+export function WahaHttpStatus(err: any): number | null {
+  const status = err?.response?.status;
+  return typeof status === 'number' ? status : null;
+}
+
+/**
+ * WAHA refused the request for good (validation, unsupported chat, engine
+ * without the method). Nothing was sent, so the text fallback is safe.
+ */
+export function IsDefinitiveRefusal(status: number | null): boolean {
+  if (status == null) {
+    return false;
+  }
+  if (status === HTTP_NOT_IMPLEMENTED) {
+    return true;
+  }
+  return status >= 400 && status < 500;
+}
+
+/**
+ * Native send failed with an uncertain outcome (5xx, gRPC, timeout).
+ * No retry: a list can not carry a pre-generated id and a resend could
+ * duplicate it. The message carries only safe fields - never the original
+ * error, request config, headers, api key or payload.
+ */
+export class WahaNativeSendError extends UnrecoverableError {
+  constructor(
+    public readonly kind: WahaNativeKind,
+    public readonly status: number | null,
+    public readonly chatwootMessageId: number | string,
+  ) {
+    const statusText = status ?? 'no-response';
+    super(
+      `WhatsApp native message was not confirmed (kind=${kind}, ` +
+        `status=${statusText}, chatwoot_message_id=${chatwootMessageId}). ` +
+        'It was not retried to avoid a duplicate; ' +
+        'check the chat before sending again.',
+    );
+    this.name = 'UnrecoverableError';
+  }
+}
