+/**
+ * Autonom.ia c2y-rich-3: ISO time of a PLAYED ack, null for any other ack
+ * or an invalid timestamp
+ */
+export function PlayedAt(ack: WAMessageAck, timestamp: unknown): string | null {
+  if (ack !== WAMessageAck.PLAYED) {
+    return null;
+  }
+  const ms = Number(timestamp);
+  if (!Number.isFinite(ms) || ms <= 0) {
+    return null;
+  }
+  const date = new Date(ms);
+  return Number.isNaN(date.getTime()) ? null : date.toISOString();
+}
