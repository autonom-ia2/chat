+// The real helper pulls ESM-only Baileys, which jest can not load
+jest.mock('@waha/apps/chatwoot/waha', () => ({ EngineHelper: {} }));
+
+import { JestLogger } from '@waha/apps/app_sdk/jest/JestLogger';
+import {
+  POLL_VOTE_REMOVED_KEY,
+  PollVoteHandler,
+} from '@waha/apps/chatwoot/consumers/waha/poll.vote';
+import { i18n } from '@waha/apps/chatwoot/i18n';
+import { ListenEventsForChatWoot } from '@waha/apps/chatwoot/consumers/waha/base';
