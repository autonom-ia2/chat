@@ -0,0 +1,292 @@
+jest.mock('@waha/utils/promiseTimeout', () => ({
+  sleep: jest.fn(() => Promise.resolve()),
+}));
+// The real helper pulls ESM-only Baileys, which jest can not load
+jest.mock('@waha/apps/chatwoot/waha', () => ({
+  EngineHelper: { WhatsAppMessageKeys: jest.fn() },
+}));
+
+import { UnrecoverableError } from 'bullmq';
+import { JestLogger } from '@waha/apps/app_sdk/jest/JestLogger';
+import { AttributeKey } from '@waha/apps/chatwoot/const';
+import { MessageHandler } from '@waha/apps/chatwoot/consumers/inbox/message_created';
+import { i18n } from '@waha/apps/chatwoot/i18n';
+import { DeterministicMessageId } from '@waha/apps/chatwoot/messages/to/whatsapp/native';
+import { EngineHelper } from '@waha/apps/chatwoot/waha';
+
+const CHAT_ID = '5511999999999@c.us';
+const SESSION = 'hub2you';
+const SECRET_VCARD_PHONE = '+55 11 98888-7777';
+
+const LIST = {
+  title: 'Planos',
+  description: 'Escolha um plano',
+  footer: 'Hub2You',
+  button: 'Ver planos',
+  sections: [
+    { title: 'Auto', rows: [{ title: 'Básico', rowId: 'auto_basico' }] },
+  ],
+};
+
+function chatwootMessage(waha_native: any, extra: any = {}) {
+  return {
+    id: 501,
+    created_at: '2026-10-16T12:00:00Z',
+    content_type: 'text',
+    content: '1) Básico',
+    message_type: 'outgoing',
+    attachments: [],
+    content_attributes: { waha_native: waha_native },
+    conversation: {
+      id: 42,
+      meta: {
+        sender: {
+          custom_attributes: { [AttributeKey.WA_CHAT_ID]: CHAT_ID },
+        },
+      },
+    },
+    ...extra,
+  };
+}
+
+function httpError(status: number) {
+  const err: any = new Error(`Request failed with status code ${status}`);
+  err.isAxiosError = true;
+  err.config = {
+    headers: { 'X-Api-Key': 'super-secret-key' },
+    data: JSON.stringify({ phoneNumber: SECRET_VCARD_PHONE }),
+  };
+  err.response = { status: status, data: { message: 'x' } };
+  return err;
+}
+
+function setup() {
+  const sent = { id: { id: 'WAID', remote: CHAT_ID }, fromMe: true };
+  const session: any = {
+    name: SESSION,
+    sendList: jest.fn().mockResolvedValue(sent),
+    sendLocation: jest.fn().mockResolvedValue(sent),
+    sendContactVcard: jest.fn().mockResolvedValue(sent),
+    sendText: jest.fn().mockResolvedValue(sent),
+    readMessages: jest.fn().mockResolvedValue(undefined),
+    startTyping: jest.fn().mockResolvedValue(undefined),
+    stopTyping: jest.fn().mockResolvedValue(undefined),
+  };
+  const mapping: any = {
+    getMappingByChatwootCombinedKeyAndPart: jest.fn().mockResolvedValue(null),
+    getWhatsAppMessage: jest.fn().mockResolvedValue([
+      {
+        message_id: 'QUOTED',
+        chat_id: CHAT_ID,
+        from_me: false,
+        participant: null,
+      },
+    ]),
+    map: jest.fn().mockResolvedValue(undefined),
+  };
+  const status: any = { sync: jest.fn().mockResolvedValue(undefined) };
+  const config: any = {
+    conversations: { syncMessageStatus: true },
+    linkPreview: 'off',
+  };
+  const logger = JestLogger();
+  const handler = new MessageHandler(
+    mapping,
+    logger,
+    session,
+    config,
+    i18n.locale('en-US'),
+    status,
+  );
+  (EngineHelper.WhatsAppMessageKeys as jest.Mock).mockReturnValue({
+    timestamp: new Date(0),
+    from_me: true,
+    chat_id: CHAT_ID,
+    message_id: 'WAID',
+    participant: null,
+  });
+  return { handler, session, mapping, logger, status };
+}
+
+function allLogs(logger: any): string {
+  return ['fatal', 'error', 'warn', 'info', 'debug', 'trace']
+    .flatMap((level) => logger[level].mock.calls)
+    .map((args) => args.map((a) => String(a)).join(' '))
+    .join('\n');
+}
+
+describe('MessageHandler - waha_native (c2y-rich-1)', () => {
+  afterEach(() => jest.clearAllMocks());
+
+  it('sendList: uses the connector chatId and reply_to, maps the message, skips text', async () => {
+    const { handler, session, mapping, status } = setup();
+    const body = chatwootMessage(undefined, {
+      content_attributes: {
+        in_reply_to: 9,
+        waha_native: {
+          kind: 'sendList',
+          payload: { message: LIST, chatId: 'other@c.us', session: 'x' },
+        },
+      },
+    });
+
+    const result = await handler.handle(body);
+
+    expect(session.sendList).toHaveBeenCalledTimes(1);
+    const [request, opts] = session.sendList.mock.calls[0];
+    expect(request.chatId).toBe(CHAT_ID);
+    expect(request.message).toEqual(LIST);
+    expect(request.reply_to).toBe(`false_${CHAT_ID}_QUOTED`);
+    expect(request.session).toBe('');
+    expect(opts.signal).toBeDefined();
+    expect(session.sendText).not.toHaveBeenCalled();
+    expect(mapping.map).toHaveBeenCalledTimes(1);
+    const [chatwoot, whatsapp, part] = mapping.map.mock.calls[0];
+    expect(chatwoot).toMatchObject({
+      conversation_id: 42,
+      message_id: 501,
+      parts: 1,
+    });
+    expect(whatsapp.message_id).toBe('WAID');
+    expect(part).toBe(1);
+    expect(status.sync).toHaveBeenCalledWith({
+      conversation_id: 42,
+      message_id: 501,
+      parts: 1,
+    });
+    expect(result).toHaveLength(1);
+  });
+
+  it('sendLocation: sends with the deterministic id', async () => {
+    const { handler, session } = setup();
+    await handler.handle(
+      chatwootMessage({
+        kind: 'sendLocation',
+        payload: { latitude: -23.5, longitude: -46.6, title: 'Escritório' },
+      }),
+    );
+    const [request] = session.sendLocation.mock.calls[0];
+    expect(request).toMatchObject({
+      chatId: CHAT_ID,
+      latitude: -23.5,
+      longitude: -46.6,
+      title: 'Escritório',
+      id: DeterministicMessageId(SESSION, 501, 'sendLocation'),
+    });
+    expect(session.sendText).not.toHaveBeenCalled();
+  });
+
+  it('sendContactVcard: sends with the deterministic id', async () => {
+    const { handler, session } = setup();
+    const contacts = [{ fullName: 'Maria', phoneNumber: SECRET_VCARD_PHONE }];
+    await handler.handle(
+      chatwootMessage({ kind: 'sendContactVcard', payload: { contacts } }),
+    );
+    const [request] = session.sendContactVcard.mock.calls[0];
+    expect(request).toMatchObject({
+      chatId: CHAT_ID,
+      contacts: contacts,
+      id: DeterministicMessageId(SESSION, 501, 'sendContactVcard'),
+    });
+    expect(session.sendText).not.toHaveBeenCalled();
+  });
+
+  it.each([400, 422, 501])(
+    'definitive refusal %p: sends the text once through the normal path',
+    async (code) => {
+      const { handler, session, mapping, logger } = setup();
+      session.sendList.mockRejectedValue(httpError(code));
+      await handler.handle(
+        chatwootMessage({ kind: 'sendList', payload: { message: LIST } }),
+      );
+      expect(session.sendList).toHaveBeenCalledTimes(1);
+      expect(session.sendText).toHaveBeenCalledTimes(1);
+      expect(session.sendText.mock.calls[0][0].text).toContain('1) Básico');
+      expect(session.sendText.mock.calls[0][0].chatId).toBe(CHAT_ID);
+      expect(mapping.map).toHaveBeenCalledTimes(1);
+      expect(logger.warn).toHaveBeenCalledWith(
+        expect.stringContaining(`status=${code}`),
+      );
+    },
+  );
+
+  it.each([
+    ['5xx', httpError(500)],
+    ['bad gateway', httpError(502)],
+    ['timeout', Object.assign(new Error('canceled'), { code: 'ERR_CANCELED' })],
+  ])(
+    'uncertain failure (%s): unrecoverable, no text, no mapping',
+    async (_name, error) => {
+      const { handler, session, mapping } = setup();
+      session.sendContactVcard.mockRejectedValue(error);
+      const promise = handler.handle(
+        chatwootMessage({
+          kind: 'sendContactVcard',
+          payload: {
+            contacts: [{ fullName: 'Maria', phoneNumber: SECRET_VCARD_PHONE }],
+          },
+        }),
+      );
+      await expect(promise).rejects.toBeInstanceOf(UnrecoverableError);
+      expect(session.sendText).not.toHaveBeenCalled();
+      expect(mapping.map).not.toHaveBeenCalled();
+    },
+  );
+
+  it('never logs the error object, api key or payload', async () => {
+    const { handler, session, logger } = setup();
+    session.sendContactVcard.mockRejectedValue(httpError(500));
+    await handler
+      .handle(
+        chatwootMessage({
+          kind: 'sendContactVcard',
+          payload: {
+            contacts: [{ fullName: 'Maria', phoneNumber: SECRET_VCARD_PHONE }],
+          },
+        }),
+      )
+      .catch((err) => {
+        expect(err.message).not.toContain('super-secret-key');
+        expect(err.message).not.toContain(SECRET_VCARD_PHONE);
+      });
+    const logs = allLogs(logger);
+    expect(logs).toContain('kind=sendContactVcard');
+    expect(logs).toContain('status=500');
+    expect(logs).toContain('chatwoot_message_id=501');
+    expect(logs).toContain(`session=${SESSION}`);
+    expect(logs).not.toContain('super-secret-key');
+    expect(logs).not.toContain('X-Api-Key');
+    expect(logs).not.toContain(SECRET_VCARD_PHONE);
+    expect(logs).not.toContain('Maria');
+  });
+
+  it('skips the native send when the mapping already exists', async () => {
+    const { handler, session, mapping } = setup();
+    mapping.getMappingByChatwootCombinedKeyAndPart.mockResolvedValue({
+      id: 1,
+    });
+    await handler.handle(
+      chatwootMessage({ kind: 'sendList', payload: { message: LIST } }),
+    );
+    expect(session.sendList).not.toHaveBeenCalled();
+    expect(session.sendText).not.toHaveBeenCalled();
+    expect(mapping.map).not.toHaveBeenCalled();
+  });
+
+  it('message without waha_native keeps the original text flow', async () => {
+    const { handler, session } = setup();
+    const body = chatwootMessage(undefined);
+    body.content_attributes = {} as any;
+    await handler.handle(body);
+    expect(session.sendText).toHaveBeenCalledTimes(1);
+    expect(session.sendList).not.toHaveBeenCalled();
+  });
+
+  it('unknown kind keeps the original text flow', async () => {
+    const { handler, session } = setup();
+    await handler.handle(
+      chatwootMessage({ kind: 'sendButtons', payload: { buttons: [] } }),
+    );
+    expect(session.sendText).toHaveBeenCalledTimes(1);
+  });
+});
