+    expect(body.content_attributes.waha_poll_vote.options).toEqual([
+      'Auto',
+      'Vida',
+    ]);
+  });
+
+  it.each([
+    ['en-US', 'Vote removed'],
+    ['pt-BR', 'Voto retirado'],
