+import { ExtractListReply } from '@waha/apps/chatwoot/messages/to/chatwoot/ListReply';
+
+/**
+ * Baileys is ESM-only and is not loaded under jest.
+ * Same unwrapping as Baileys normalizeMessageContent (ephemeral, view once),
+ * used only to exercise ExtractListReply. The real Baileys function is
+ * checked against the built dist separately (see README of the patch).
+ */
+function unwrap(message: any): any {
+  let content = message;
+  for (let i = 0; i < 5; i++) {
+    const inner =
+      content?.ephemeralMessage ||
+      content?.viewOnceMessage ||
+      content?.viewOnceMessageV2 ||
+      content?.viewOnceMessageV2Extension ||
+      content?.documentWithCaptionMessage;
+    if (!inner) {
+      break;
+    }
+    content = inner.message;
+  }
+  return content;
+}
+
+const NOWEB_REPLY = {
+  listResponseMessage: {
+    title: 'Básico',
+    listType: 1,
+    singleSelectReply: { selectedRowId: 'auto_basico' },
+  },
+};
+
+describe('ExtractListReply', () => {
+  it('NOWEB: plain list reply', () => {
+    expect(ExtractListReply({ message: NOWEB_REPLY }, unwrap)).toEqual({
+      row_id: 'auto_basico',
+      title: 'Básico',
+    });
+  });
+
+  it('NOWEB: ephemeral (disappearing messages)', () => {
+    const data = { message: { ephemeralMessage: { message: NOWEB_REPLY } } };
+    expect(ExtractListReply(data, unwrap)).toEqual({
+      row_id: 'auto_basico',
+      title: 'Básico',
+    });
+  });
+
+  it('NOWEB: view once', () => {
+    const data = {
+      message: { viewOnceMessageV2: { message: NOWEB_REPLY } },
+    };
