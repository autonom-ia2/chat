+
+describe('c2y action error note (c2y-rich-2, review)', () => {
+  function consumerWithReporter(Klass: any) {
+    const reporter = {
+      ReportError: jest.fn().mockResolvedValue(undefined),
+      ReportSucceeded: jest.fn().mockResolvedValue(undefined),
+    };
+    const conversation = { id: 42 };
+    const container: any = {
+      Locale: () => ({ key: () => ({ render: () => 'Erro ao enviar' }) }),
+      ContactConversationService: () => ({
+        ConversationById: jest.fn().mockReturnValue(conversation),
+      }),
+      ChatWootErrorReporter: jest.fn().mockReturnValue(reporter),
+    };
+    // No constructor: only the reporting path is exercised
+    const consumer = Object.create(Klass.prototype);
+    consumer.DIContainer = jest.fn().mockResolvedValue(container);
+    return { consumer, reporter, conversation };
+  }
+
+  const job: any = {
+    data: { app: 'app-1', session: SESSION },
+    attemptsMade: 3,
+  };
+
+  it.each([
+    ['reaction', ChatWootInboxC2yReactionConsumer],
+    ['edit', ChatWootInboxC2yEditConsumer],
+  ])(
+    '%s on an INCOMING message reports an OUTGOING private note',
+    async (_name, Klass) => {
+      const { consumer, reporter, conversation } = consumerWithReporter(Klass);
+      const err = new UnrecoverableError('no mapping');
+      const incoming = body({ message_type: 'incoming' });
+      await expect(
+        consumer.ReportErrorForMessage(job, err, incoming),
+      ).rejects.toBe(err);
+      expect(reporter.ReportError).toHaveBeenCalledTimes(1);
+      expect(reporter.ReportError).toHaveBeenCalledWith(
+        conversation,
+        'Erro ao enviar',
+        'outgoing',
+        err,
+        501,
+      );
+      // The job body is not changed
+      expect(incoming.message_type).toBe('incoming');
+    },
+  );
+
+  it.each([
+    ['reaction', ChatWootInboxC2yReactionConsumer],
+    ['edit', ChatWootInboxC2yEditConsumer],
+  ])('%s recovered report also uses OUTGOING', async (_name, Klass) => {
+    const { consumer, reporter, conversation } = consumerWithReporter(Klass);
+    await consumer.ReportErrorRecovered(
+      job,
+      body({ message_type: 'incoming' }),
+    );
+    expect(reporter.ReportSucceeded).toHaveBeenCalledWith(
+      conversation,
+      'outgoing',
+      501,
+    );
+  });
+
+  it('ReportBody keeps every other field', () => {
+    const original = body({
+      message_type: 'incoming',
+      c2y_reaction: { emoji: '👍' },
+    });
+    expect(ReportBody(original)).toEqual({
+      ...original,
+      message_type: 'outgoing',
+    });
+  });
+});
