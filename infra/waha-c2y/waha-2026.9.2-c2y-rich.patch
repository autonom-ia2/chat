+      QueueName.WAHA_POLL_VOTE,
+    );
+    expect(service.getQueueForEvent(WAHAEvents.POLL_VOTE_FAILED).name).toBe(
+      QueueName.WAHA_POLL_VOTE,
+    );
+  });
+});
diff --git a/src/apps/chatwoot/consumers/waha/poll.vote.ts b/src/apps/chatwoot/consumers/waha/poll.vote.ts
new file mode 100644
index 00000000..e9e03b2f
--- /dev/null
+++ b/src/apps/chatwoot/consumers/waha/poll.vote.ts
@@ -0,0 +1,263 @@
+import { conversation_message_create } from '@figuro/chatwoot-sdk';
+import { Processor } from '@nestjs/bullmq';
+import { JOB_CONCURRENCY } from '@waha/apps/app_sdk/constants';
+import { ILogger } from '@waha/apps/app_sdk/ILogger';
+import { ContactConversationService } from '@waha/apps/chatwoot/client/ContactConversationService';
+import { MessageType } from '@waha/apps/chatwoot/client/types';
+import { QueueName } from '@waha/apps/chatwoot/consumers/QueueName';
+import { EventData } from '@waha/apps/chatwoot/consumers/types';
+import {
+  ChatWootWAHABaseConsumer,
+  IMessageInfo,
+} from '@waha/apps/chatwoot/consumers/waha/base';
+import { i18n } from '@waha/apps/chatwoot/i18n';
+import { Locale } from '@waha/apps/chatwoot/i18n/locale';
+import { DeterministicMessageId } from '@waha/apps/chatwoot/messages/to/whatsapp/native';
+import {
+  ChatwootMessage,
+  MessageMappingService,
+  WhatsAppMessage,
+} from '@waha/apps/chatwoot/storage';
+import { SessionManager } from '@waha/core/abc/manager.abc';
+import { parseMessageIdSerialized } from '@waha/core/utils/ids';
+import { isJidGroup, toCusFormat } from '@waha/core/utils/jids';
+import { RMutexService } from '@waha/modules/rmutex/rmutex.service';
+import { WAHAEvents } from '@waha/structures/enums.dto';
+import {
+  PollVotePayload,
+  WAHAWebhookPollVote,
+} from '@waha/structures/webhooks.dto';
+import { Job } from 'bullmq';
+import { PinoLogger } from 'nestjs-pino';
+
+/**
+ * Autonom.ia patch c2y-rich-2 (autonom-ia2/chat#1709)
+ * Vote on a poll the connector sent natively (sendPoll) -> incoming message
+ * in the poll conversation, with content_attributes.waha_poll_vote.
+ * Votes on any other poll are ignored, as before the patch.
+ * Also receives poll.vote.failed: GOWS routes a vote whose Votes list is
+ * null there (a retracted vote may come so); with no options it becomes
+ * "Vote removed", same as an empty list.
+ */
+export const POLL_VOTE_REMOVED_KEY = 'whatsapp.to.chatwoot.poll.vote.removed';
+
+export interface WahaPollVote {
+  poll_message_id: number;
+  options: string[];
+  vote_id: string;
+  timestamp: number | null;
+}
+
+@Processor(QueueName.WAHA_POLL_VOTE, { concurrency: JOB_CONCURRENCY })
+export class WAHAPollVoteConsumer extends ChatWootWAHABaseConsumer {
+  constructor(
+    protected readonly manager: SessionManager,
+    log: PinoLogger,
+    rmutex: RMutexService,
+  ) {
+    super(manager, log, rmutex, 'WAHAPollVoteConsumer');
+  }
+
+  GetChatId(event: WAHAWebhookPollVote): string {
+    return PollChatId(event.payload) ?? 'poll.vote';
+  }
+
+  async Process(
+    job: Job<EventData, any, WAHAEvents>,
+    info: IMessageInfo,
+  ): Promise<any> {
+    const container = await this.DIContainer(job, job.data.app);
+    const event: WAHAWebhookPollVote = job.data.event as any;
+    const handler = new PollVoteHandler(
+      container.MessageMappingService(),
+      container.ContactConversationService(),
+      container.Logger(),
+      container.Locale(),
+      info,
+      event.session,
+    );
+    return await handler.handle(event.payload);
+  }
+}
+
+function PollChatId(payload: PollVotePayload): string | null {
+  const id = payload?.poll?.id;
+  if (typeof id !== 'string' || !id) {
+    return null;
+  }
+  try {
+    const key = parseMessageIdSerialized(id, true);
+    return key.remoteJid ? toCusFormat(key.remoteJid) : null;
+  } catch (err) {
+    return null;
+  }
+}
+
+function SelectedOptions(payload: PollVotePayload): string[] {
+  const options = payload?.vote?.selectedOptions;
+  if (!Array.isArray(options)) {
+    return [];
+  }
+  return options.filter((o) => typeof o === 'string' && o.length > 0);
+}
+
+export class PollVoteHandler {
+  constructor(
+    private mappingService: MessageMappingService,
+    private repo: ContactConversationService,
+    private logger: ILogger,
+    private l: Locale,
+    private info: IMessageInfo,
+    private session: string,
+  ) {}
+
+  async handle(
+    payload: PollVotePayload,
+  ): Promise<conversation_message_create | null> {
+    const poll = await this.findOurPoll(payload);
+    if (!poll) {
+      return null;
+    }
+    if (payload.vote?.fromMe) {
+      // The business phone voted on its own poll - not a customer answer
+      this.logger.info(
+        `Poll vote from me ignored: chatwoot_message_id=${poll.message_id}`,
+      );
+      return null;
+    }
+    const voteKey = this.voteKey(payload);
+    if (!voteKey) {
+      this.logger.warn(
+        `Poll vote without a valid id ignored: chatwoot_message_id=${poll.message_id}`,
+      );
+      return null;
+    }
+    const existing = await this.mappingService.getChatWootMessage({
+      chat_id: voteKey.chat_id,
+      message_id: voteKey.message_id,
+    });
+    if (existing) {
+      this.logger.debug(`Skipping existing poll vote '${voteKey.message_id}'`);
+      return null;
+    }
+
+    this.info.onMessageType(MessageType.INCOMING);
+    this.info.onConversationId(poll.conversation_id);
+    const conversation = this.repo.ConversationById(poll.conversation_id);
+    const message = this.buildMessage(poll, payload);
+    const response = await conversation.send(message);
+    await this.saveMapping(response, voteKey);
+    this.logger.info(
+      `WhatsApp => ChatWoot: poll vote created for chatwoot_message_id=${poll.message_id}`,
+    );
+    return message;
+  }
+
+  /**
+   * The mapped Chatwoot message of the poll, only when its WhatsApp id is
+   * the deterministic id the connector gave to a native poll.
+   */
+  private async findOurPoll(
+    payload: PollVotePayload,
+  ): Promise<ChatwootMessage | null> {
+    const pollId = payload?.poll?.id;
+    if (typeof pollId !== 'string' || !pollId) {
+      return null;
+    }
+    let key;
+    try {
+      key = parseMessageIdSerialized(pollId, true);
+    } catch (err) {
+      return null;
+    }
+    if (!key?.id) {
+      return null;
+    }
+    const chatwoot = await this.mappingService.getChatWootMessage({
+      chat_id: key.remoteJid ? toCusFormat(key.remoteJid) : '',
+      message_id: key.id,
+    });
+    if (!chatwoot) {
+      this.logger.debug('Poll vote for a poll not mapped in Chatwoot, ignored');
+      return null;
+    }
+    const expected = DeterministicMessageId(
+      this.session,
+      chatwoot.message_id,
+      'sendPoll',
+    );
+    if (key.id !== expected) {
+      this.logger.debug(
+        `Poll vote for a poll not sent natively, ignored: chatwoot_message_id=${chatwoot.message_id}`,
+      );
+      return null;
+    }
+    return chatwoot;
+  }
+
+  private voteKey(payload: PollVotePayload): WhatsAppMessage | null {
+    const id = payload?.vote?.id;
+    if (typeof id !== 'string' || !id) {
+      return null;
+    }
+    try {
+      const key = parseMessageIdSerialized(id, true);
+      if (!key?.id) {
+        return null;
+      }
+      const remoteJid = key.remoteJid || '';
+      const timestamp = Number(payload.vote.timestamp);
+      return {
+        timestamp: new Date(Number.isFinite(timestamp) ? timestamp : 0),
+        chat_id: toCusFormat(remoteJid),
+        message_id: key.id,
+        from_me: Boolean(key.fromMe),
+        participant: isJidGroup(remoteJid) ? key.participant || null : null,
+      };
+    } catch (err) {
+      return null;
+    }
+  }
+
+  private removedText(): string {
+    const text = this.l.r(POLL_VOTE_REMOVED_KEY);
+    if (text && text !== POLL_VOTE_REMOVED_KEY) {
+      return text;
+    }
+    // Locale without the key: fall back to English
+    return i18n.locale('en-US').r(POLL_VOTE_REMOVED_KEY);
+  }
+
+  buildMessage(
+    poll: ChatwootMessage,
+    payload: PollVotePayload,
+  ): conversation_message_create {
+    const options = SelectedOptions(payload);
+    const content = options.length ? options.join(', ') : this.removedText();
+    const timestamp = Number(payload.vote?.timestamp);
+    const vote: WahaPollVote = {
+      poll_message_id: poll.message_id,
+      options: options,
+      vote_id: String(payload.vote?.id ?? ''),
+      timestamp: Number.isFinite(timestamp) ? timestamp : null,
+    };
+    return {
+      content: content,
+      message_type: MessageType.INCOMING as any,
+      private: false,
+      content_attributes: {
+        in_reply_to: poll.message_id,
+        waha_poll_vote: vote,
+      } as any,
+    };
+  }
+
+  private async saveMapping(chatwootMessage: any, whatsapp: WhatsAppMessage) {
+    const chatwoot: Omit<ChatwootMessage, 'id'> = {
+      timestamp: new Date(chatwootMessage.created_at * 1000),
+      conversation_id: chatwootMessage.conversation_id,
+      message_id: chatwootMessage.id,
+    };
+    await this.mappingService.map(chatwoot, whatsapp, 1);
+  }
+}
diff --git a/src/apps/chatwoot/consumers/waha/view_once.c2y4.test.ts b/src/apps/chatwoot/consumers/waha/view_once.c2y4.test.ts
