+import { QueueName } from '@waha/apps/chatwoot/consumers/QueueName';
+import { EventData } from '@waha/apps/chatwoot/consumers/types';
+import {
+  ChatWootWAHABaseConsumer,
+  IMessageInfo,
+} from '@waha/apps/chatwoot/consumers/waha/base';
+import { i18n } from '@waha/apps/chatwoot/i18n';
+import { Locale } from '@waha/apps/chatwoot/i18n/locale';
+import {
+  ChatwootMessage,
+  MessageMappingService,
+  WhatsAppMessage,
+} from '@waha/apps/chatwoot/storage';
+import { SessionManager } from '@waha/core/abc/manager.abc';
+import { parseMessageIdSerialized } from '@waha/core/utils/ids';
+import { isJidGroup, toCusFormat } from '@waha/core/utils/jids';
+import { RMutexService } from '@waha/modules/rmutex/rmutex.service';
+import { WAHAEvents } from '@waha/structures/enums.dto';
+import { EventResponsePayload } from '@waha/structures/events.dto';
+import { WAHAWebhookEventResponse } from '@waha/structures/webhooks.dto';
+import { Job } from 'bullmq';
+import { PinoLogger } from 'nestjs-pino';
+import { WAHASessionAPI } from '@waha/apps/app_sdk/waha/WAHASelf';
+import { JidUser } from '@waha/apps/chatwoot/messages/to/chatwoot/c2y3';
+
+/**
+ * Autonom.ia patch c2y-rich-3 (autonom-ia2/chat#1709, round 2, item 13)
+ * Answer (going / not going / maybe) to an event the connector sent
+ * (sendEvent) -> incoming message in the event conversation, with
+ * content_attributes.waha_event_response. Answers to any other event, and
+ * the business phone's own answers, are ignored, as before the patch.
+ * "Sent by the connector" = the event's Chatwoot mapping has `parts` (set
+ * only by message_created when the connector sends); an event created on
+ * the business phone is mirrored with parts null and is ignored.
+ * The engine can not cancel events, so there is nothing about cancelling.
+ */
+export const EVENT_RESPONSE_KEYS = {
+  going: 'whatsapp.to.chatwoot.event.response.going',
+  not_going: 'whatsapp.to.chatwoot.event.response.not_going',
+  maybe: 'whatsapp.to.chatwoot.event.response.maybe',
+} as const;
+
+export type WahaEventAnswer = keyof typeof EVENT_RESPONSE_KEYS;
+
+const ANSWER_BY_ENGINE: Record<string, WahaEventAnswer> = {
+  GOING: 'going',
+  NOT_GOING: 'not_going',
+  MAYBE: 'maybe',
+};
+
+export interface WahaEventResponse {
+  event_message_id: number;
+  response: WahaEventAnswer;
+  extra_guests: number;
+  response_id: string;
+  timestamp: number | null;
+}
+
+@Processor(QueueName.WAHA_EVENT_RESPONSE, { concurrency: JOB_CONCURRENCY })
+export class WAHAEventResponseConsumer extends ChatWootWAHABaseConsumer {
+  constructor(
+    protected readonly manager: SessionManager,
+    log: PinoLogger,
+    rmutex: RMutexService,
+  ) {
+    super(manager, log, rmutex, 'WAHAEventResponseConsumer');
+  }
+
+  GetChatId(event: WAHAWebhookEventResponse): string {
+    const from = event?.payload?.from;
+    return typeof from === 'string' && from ? from : 'event.response';
+  }
+
+  async Process(
+    job: Job<EventData, any, WAHAEvents>,
+    info: IMessageInfo,
+  ): Promise<any> {
+    const container = await this.DIContainer(job, job.data.app);
+    const event: WAHAWebhookEventResponse = job.data.event as any;
+    const handler = new EventResponseHandler(
+      container.MessageMappingService(),
+      container.ContactConversationService(),
+      container.Logger(),
+      container.Locale(),
+      info,
+      new WAHASessionAPI(event.session, container.WAHASelf()),
+    );
+    return await handler.handle(event.payload);
+  }
+}
+
+function EventKey(payload: EventResponsePayload) {
+  const id = payload?.eventCreationKey?.id;
+  if (typeof id !== 'string' || !id) {
+    return null;
+  }
+  try {
+    const key = parseMessageIdSerialized(id, true);
+    return key?.id ? key : null;
+  } catch (err) {
+    return null;
+  }
+}
+
+/**
+ * message_created saves `parts` (>= 1) on every message the connector sends;
+ * a message mirrored from the phone is saved without it (null).
+ */
+export function SentByConnector(chatwoot: ChatwootMessage | null): boolean {
+  const parts = Number(chatwoot?.parts);
+  return chatwoot?.parts != null && Number.isInteger(parts) && parts > 0;
+}
+
+export interface SessionInfoSource {
+  getSessionInfo(): Promise<any>;
+}
+
+export class EventResponseHandler {
+  constructor(
+    private mappingService: MessageMappingService,
+    private repo: ContactConversationService,
+    private logger: ILogger,
+    private l: Locale,
+    private info: IMessageInfo,
+    private session: SessionInfoSource,
+  ) {}
+
+  async handle(
+    payload: EventResponsePayload,
+  ): Promise<conversation_message_create | null> {
+    if (payload?.fromMe) {
+      // The business phone answered its own event - not a customer answer
+      return null;
+    }
+    const answer = ANSWER_BY_ENGINE[String(payload?.eventResponse?.response)];
+    if (!answer) {
+      this.logger.debug('Event response without a known answer, ignored');
+      return null;
+    }
+    const event = await this.findOurEvent(payload);
+    if (!event) {
+      return null;
+    }
+    const responseKey = this.responseKey(payload);
+    if (!responseKey) {
+      this.logger.warn(
+        `Event response without a valid id ignored: chatwoot_message_id=${event.message_id}`,
+      );
+      return null;
+    }
+    const existing = await this.mappingService.getChatWootMessage({
+      chat_id: responseKey.chat_id,
+      message_id: responseKey.message_id,
+    });
+    if (existing) {
+      this.logger.debug(
+        `Skipping existing event response '${responseKey.message_id}'`,
+      );
+      return null;
+    }
+
+    this.info.onMessageType(MessageType.INCOMING);
+    this.info.onConversationId(event.conversation_id);
+    const conversation = this.repo.ConversationById(event.conversation_id);
+    const message = this.buildMessage(event, payload, answer);
+    const response = await conversation.send(message);
+    await this.saveMapping(response, responseKey);
+    this.logger.info(
+      `WhatsApp => ChatWoot: event response created for chatwoot_message_id=${event.message_id}`,
+    );
+    return message;
+  }
+
+  /**
+   * The mapped Chatwoot message of the event, only when the event was sent
+   * by this number AND by the connector (sendEvent).
+   * The lookup is by WhatsApp message id only: MessageMappingService
+   * .getChatWootMessage -> WhatsAppMessageRepository.getByMessageId filters
+   * by app and message_id, never by chat_id, so a customer answering from a
+   * @lid jid finds the event mapped with its phone jid (and vice versa).
+   */
+  private async findOurEvent(
+    payload: EventResponsePayload,
+  ): Promise<ChatwootMessage | null> {
+    const key = EventKey(payload);
+    if (!key) {
+      return null;
+    }
+    if (!(await this.isOurEvent(key))) {
+      this.logger.debug('Event response for an event not sent by us, ignored');
+      return null;
+    }
+    const chatwoot = await this.mappingService.getChatWootMessage({
+      chat_id: toCusFormat(payload.from || ''),
+      message_id: key.id,
+    });
+    if (!chatwoot) {
+      this.logger.debug(
+        'Event response for an event not mapped in Chatwoot, ignored',
+      );
+      return null;
+    }
+    if (!SentByConnector(chatwoot)) {
+      // Event created on the business phone and mirrored: not ours (main)
+      this.logger.debug(
+        `Event response for an event not sent by the connector, ignored: chatwoot_message_id=${chatwoot.message_id}`,
+      );
+      return null;
+    }
+    return chatwoot;
+  }
+
+  /**
+   * GOWS gives the event key as the CUSTOMER wrote it (no perspective fix,
+   * unlike poll votes, see fixPollCreationKey): in a DM our event comes as
+   * {remoteJid: our number, fromMe: false}, and the customer's own event as
+   * {remoteJid: our number, fromMe: true}. Both perspectives are handled:
+   * - DM, key points to our number: ours when fromMe is false;
+   * - DM, key points to the customer: ours when fromMe is true;
+   * - group: ours when the key participant is our number, or fromMe with
+   *   no participant.
+   */
+  private async isOurEvent(key: {
+    fromMe?: boolean;
+    remoteJid?: string;
+    participant?: string;
+  }): Promise<boolean> {
+    let me: any;
+    try {
+      const info = await this.session.getSessionInfo();
+      me = info?.me;
+    } catch (err) {
+      const kind = err?.name || err?.constructor?.name || typeof err;
+      this.logger.warn(`Event response: own number not read (${kind})`);
+      throw err;
+    }
+    const own = [JidUser(me?.id), JidUser(me?.lid)].filter(Boolean);
+    if (own.length === 0) {
+      return false;
+    }
+    const participant = JidUser(key.participant);
+    if (isJidGroup(key.remoteJid || '')) {
+      if (participant !== null) {
+        return own.includes(participant);
+      }
+      return key.fromMe === true;
+    }
+    const chat = JidUser(key.remoteJid);
+    if (chat !== null && own.includes(chat)) {
+      return key.fromMe === false;
+    }
+    return key.fromMe === true;
+  }
+
+  private responseKey(payload: EventResponsePayload): WhatsAppMessage | null {
+    const id = payload?.id;
+    if (typeof id !== 'string' || !id) {
+      return null;
+    }
+    try {
+      const key = parseMessageIdSerialized(id, true);
+      if (!key?.id) {
+        return null;
+      }
+      const remoteJid = key.remoteJid || '';
+      const timestamp = Number(payload.eventResponse?.timestampMs);
+      return {
+        timestamp: new Date(Number.isFinite(timestamp) ? timestamp : 0),
+        chat_id: toCusFormat(remoteJid),
+        message_id: key.id,
+        from_me: Boolean(key.fromMe),
+        participant: isJidGroup(remoteJid) ? key.participant || null : null,
+      };
+    } catch (err) {
+      return null;
+    }
+  }
+
+  private answerText(answer: WahaEventAnswer): string {
+    const key = EVENT_RESPONSE_KEYS[answer];
+    const text = this.l.r(key);
+    if (text && text !== key) {
+      return text;
+    }
+    // Locale without the key: fall back to English
+    return i18n.locale('en-US').r(key);
+  }
+
+  buildMessage(
+    event: ChatwootMessage,
+    payload: EventResponsePayload,
+    answer: WahaEventAnswer,
+  ): conversation_message_create {
+    const timestamp = Number(payload.eventResponse?.timestampMs);
+    const guests = Number(payload.eventResponse?.extraGuestCount);
+    const response: WahaEventResponse = {
+      event_message_id: event.message_id,
+      response: answer,
+      extra_guests: Number.isFinite(guests) && guests > 0 ? guests : 0,
+      response_id: String(payload.id ?? ''),
+      timestamp: Number.isFinite(timestamp) ? timestamp : null,
+    };
+    return {
+      content: this.answerText(answer),
+      message_type: MessageType.INCOMING as any,
+      private: false,
+      content_attributes: {
+        in_reply_to: event.message_id,
+        waha_event_response: response,
+      } as any,
+    };
+  }
+
+  private async saveMapping(chatwootMessage: any, whatsapp: WhatsAppMessage) {
+    const chatwoot: Omit<ChatwootMessage, 'id'> = {
+      timestamp: new Date(chatwootMessage.created_at * 1000),
+      conversation_id: chatwootMessage.conversation_id,
+      message_id: chatwootMessage.id,
+    };
+    await this.mappingService.map(chatwoot, whatsapp, 1);
+  }
+}
