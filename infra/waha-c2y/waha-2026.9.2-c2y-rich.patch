@@ -0,0 +1,143 @@
+const findEnabledAppById = jest.fn();
+jest.mock('@waha/apps/app_sdk/storage/AppRepository', () => ({
+  AppRepository: jest.fn().mockImplementation(() => ({
+    findEnabledAppById: findEnabledAppById,
+  })),
+}));
+// The CLI pulls ESM-only Baileys, which jest can not load
+jest.mock('@waha/apps/chatwoot/cli', () => ({ CommandPrefix: 'wa/' }));
+
+import { INestApplication } from '@nestjs/common';
+import { Test } from '@nestjs/testing';
+import { createHmac } from 'crypto';
+import { json } from 'express';
+import { AddressInfo } from 'net';
+import { C2ySignatureVerifier } from '@waha/apps/chatwoot/api/c2y.signature';
+import { ChatwootWebhookController } from '@waha/apps/chatwoot/api/chatwoot.webhook.controller';
+import { keepChatwootWebhookRawBody } from '@waha/apps/chatwoot/api/rawbody';
+import { ChatWootQueueService } from '@waha/apps/chatwoot/services/ChatWootQueueService';
+import { SessionManager } from '@waha/core/abc/manager.abc';
+
+/**
+ * Autonom.ia c2y-rich-2: the whole HTTP path, with the same body parser
+ * setup as main.ts (json 50mb + verify, before the Nest default parser).
+ */
+const SECRET = 'inbox-secret';
+const PATH = '/webhooks/chatwoot/hub2you/app_1';
+
+describe('Chatwoot webhook c2y signature over HTTP (c2y-rich-2, review)', () => {
+  let app: INestApplication;
+  let base: string;
+  const queue: any = {
+    addJobToQueue: jest.fn().mockResolvedValue(undefined),
+    addMessageCreatedJob: jest.fn().mockResolvedValue(undefined),
+  };
+  const loader = jest.fn().mockResolvedValue(SECRET);
+
+  beforeAll(async () => {
+    findEnabledAppById.mockResolvedValue({
+      id: 'app_1',
+      session: 'hub2you',
+      config: { url: 'https://chat.example', accountId: 1, inboxId: 7 },
+    });
+    const moduleRef = await Test.createTestingModule({
+      controllers: [ChatwootWebhookController],
+      providers: [
+        { provide: ChatWootQueueService, useValue: queue },
+        {
+          provide: SessionManager,
+          useValue: { store: { getWAHADatabase: () => ({}) } },
+        },
+      ],
+    }).compile();
+    app = moduleRef.createNestApplication({ logger: false });
+    app.use(json({ limit: '50mb', verify: keepChatwootWebhookRawBody }));
+    (app.get(
+      ChatwootWebhookController,
+    ) as any).c2ySignature = new C2ySignatureVerifier(loader);
+    await app.listen(0, '127.0.0.1');
+    const port = (app.getHttpServer().address() as AddressInfo).port;
+    base = `http://127.0.0.1:${port}`;
+  });
+
+  afterAll(async () => {
+    await app.close();
+  });
+
+  afterEach(() => {
+    queue.addJobToQueue.mockClear();
+    queue.addMessageCreatedJob.mockClear();
+  });
+
+  function post(raw: string, headers: Record<string, string> = {}) {
+    return fetch(`${base}${PATH}`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', ...headers },
+      body: raw,
+    });
+  }
+
+  function signed(raw: string, secret = SECRET) {
+    const ts = String(Math.floor(Date.now() / 1000));
+    const sig = createHmac('sha256', secret)
+      .update(`${ts}.${raw}`)
+      .digest('hex');
+    return {
+      'X-Chatwoot-Timestamp': ts,
+      'X-Chatwoot-Signature': `sha256=${sig}`,
+    };
+  }
+
+  // Rails-style escapes and UTF-8: the signature is over these exact bytes
+  const reaction = JSON.stringify({
+    event: 'c2y_message_reaction',
+    id: 501,
+    message_type: 'incoming',
+    private: false,
+    conversation: { id: 42, meta: { sender: {} } },
+    c2y_reaction: { emoji: '👍' },
+  }).replace('"incoming"', '"in\\u0063oming"');
+
+  it('signed c2y event: 201 and queued', async () => {
+    const res = await post(reaction, signed(reaction));
+    expect(res.status).toBe(201);
+    expect(queue.addJobToQueue).toHaveBeenCalledWith(
+      'c2y_message_reaction',
+      expect.objectContaining({ app: 'app_1', session: 'hub2you' }),
+    );
+  });
+
+  it('unsigned c2y event: 401, not queued', async () => {
+    const res = await post(reaction);
+    expect(res.status).toBe(401);
+    expect(queue.addJobToQueue).not.toHaveBeenCalled();
+  });
+
+  it('signed with another secret: 401, not queued', async () => {
+    const res = await post(reaction, signed(reaction, 'guessed'));
+    expect(res.status).toBe(401);
+    expect(queue.addJobToQueue).not.toHaveBeenCalled();
+  });
+
+  it('body changed after signing: 401, not queued', async () => {
+    const headers = signed(reaction);
+    const forged = reaction.replace('👍', '💩');
+    const res = await post(forged, headers);
+    expect(res.status).toBe(401);
+    expect(queue.addJobToQueue).not.toHaveBeenCalled();
+  });
+
+  it('message_created without signature: accepted as before', async () => {
+    const created = JSON.stringify({
+      event: 'message_created',
+      id: 502,
+      message_type: 'outgoing',
+      private: false,
+      content: 'oi',
+      conversation: { id: 42, meta: { sender: {} } },
+    });
+    const res = await post(created);
+    expect(res.status).toBe(201);
+    expect(queue.addMessageCreatedJob).toHaveBeenCalledTimes(1);
+  });
+});
