@@ -0,0 +1,18 @@
+/**
+ * Autonom.ia patch c2y-rich-2 (autonom-ia2/chat#1709)
+ * body-parser `verify` hook: keeps the raw JSON body of the Chatwoot inbox
+ * webhook (POST /webhooks/chatwoot/...) on req.rawBody, so the c2y_* events
+ * can be checked against the HMAC signature. Every other route is untouched.
+ */
+export const CHATWOOT_WEBHOOK_PATH_PREFIX = '/webhooks/chatwoot/';
+
+export function keepChatwootWebhookRawBody(
+  req: any,
+  _res: unknown,
+  buf: Buffer,
+): void {
+  const url: unknown = req?.originalUrl ?? req?.url;
+  if (typeof url === 'string' && url.startsWith(CHATWOOT_WEBHOOK_PATH_PREFIX)) {
+    req.rawBody = buf;
+  }
+}
