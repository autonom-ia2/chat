+import {
+  IsGif,
+  IsMediaDownloadFailure,
+  JidUser,
+  MediaFailureReason,
+  ProtoReader,
+  QUOTE_BODY_MAX_CHARS,
+  ReadProtoMessage,
+  TruncateChars,
+  WahaAlbumOf,
+  WahaContactsOf,
+  WahaContextOf,
+  WahaLocationOf,
+  WahaMediaFailedOf,
+  WahaMediaOf,
+  WahaOrderOf,
+  WahaQuoteOf,
+} from '@waha/apps/chatwoot/messages/to/chatwoot/c2y3';
+
+/**
+ * Same contract as Baileys normalizeMessageContent + getContentType, enough
+ * for the shapes below (Baileys itself is ESM and can not load under jest;
+ * validate/r4-real-baileys.js runs the same cases against the real one).
+ */
+const WRAPPERS = [
+  'ephemeralMessage',
+  'viewOnceMessage',
+  'viewOnceMessageV2',
+  'viewOnceMessageV2Extension',
+  'documentWithCaptionMessage',
+];
+const reader: ProtoReader = {
+  normalize(message: any) {
+    let current = message;
+    for (let i = 0; i < 5 && current; i++) {
+      const wrapper = WRAPPERS.find((key) => current[key]?.message);
+      if (!wrapper) {
+        break;
+      }
+      current = current[wrapper].message;
+    }
+    return current;
+  },
+  contentType(message: any) {
+    if (!message) return undefined;
+    return Object.keys(message).find(
+      (k) => k === 'conversation' || k.endsWith('Message'),
+    );
+  },
+};
+const broken: ProtoReader = {
+  normalize: () => {
+    throw new TypeError('boom 5511999999999');
+  },
+  contentType: () => {
+    throw new TypeError('boom');
+  },
+};
+
+function media(extra: any = {}) {
+  return {
+    url: 'http://localhost:3000/api/files/s/abc.oga',
+    mimetype: 'audio/ogg; codecs=opus',
+    filename: null,
+    ...extra,
+  };
+}
+
+describe('ReadProtoMessage', () => {
+  it('unwraps and reads the type', () => {
+    const read = ReadProtoMessage(
+      { ephemeralMessage: { message: { imageMessage: { a: 1 } } } } as any,
+      reader,
+    );
+    expect(read.type).toBe('imageMessage');
+    expect(read.content).toEqual({ imageMessage: { a: 1 } });
+  });
+
+  it('reader throws: raw message, unknown type, never throws', () => {
+    const raw: any = { imageMessage: {} };
+    expect(ReadProtoMessage(raw, broken)).toEqual({ content: raw, type: null });
+  });
+
+  it('default Baileys reader under jest fails closed', () => {
+    const raw: any = { imageMessage: {} };
+    expect(ReadProtoMessage(raw)).toEqual({ content: raw, type: null });
+  });
+
+  it('no message', () => {
+    expect(ReadProtoMessage(null, reader)).toEqual({
+      content: null,
+      type: null,
+    });
+  });
+});
+
+describe('waha_media (items 1, 9, 11)', () => {
+  it('voice note (PTT): kind voice, ptt true, filename null', () => {
+    const payload = { media: media() };
+    const proto: any = { audioMessage: { ptt: true, seconds: 3 } };
+    expect(WahaMediaOf(payload, proto, reader)).toEqual({
+      kind: 'voice',
+      mimetype: 'audio/ogg; codecs=opus',
+      filename: null,
+      ptt: true,
+      view_once: false,
+      animated: false,
+      lottie: false,
+    });
+  });
+
+  it('audio file (forwarded mp3): kind audio, ptt false', () => {
+    const payload = {
+      media: media({ mimetype: 'audio/mpeg', filename: 'song.mp3' }),
+    };
+    const proto: any = { audioMessage: { ptt: false } };
+    const result = WahaMediaOf(payload, proto, reader);
+    expect(result.kind).toBe('audio');
+    expect(result.ptt).toBe(false);
+    expect(result.filename).toBe('song.mp3');
+  });
+
+  it.each([
+    [{ stickerMessage: {} }, false, false],
+    [{ stickerMessage: { isAnimated: true } }, true, false],
+    [{ stickerMessage: { isLottie: true, isAnimated: true } }, true, true],
+    [{ stickerMessage: { mimetype: 'application/was' } }, false, true],
+  ])('sticker %j: animated %p lottie %p', (proto, animated, lottie) => {
+    const result = WahaMediaOf(
+      { media: media({ mimetype: 'image/webp' }) },
+      proto as any,
+      reader,
+    );
+    expect(result.kind).toBe('sticker');
+    expect(result.animated).toBe(animated);
+    expect(result.lottie).toBe(lottie);
+  });
+
+  it.each([
+    ['imageMessage', 'image/jpeg', 'image'],
+    ['videoMessage', 'video/mp4', 'video'],
+    ['ptvMessage', 'video/mp4', 'video'],
+    ['documentMessage', 'application/pdf', 'document'],
+  ])('%s -> %s', (type, mimetype, kind) => {
+    const result = WahaMediaOf(
+      { media: media({ mimetype }) },
+      { [type]: {} } as any,
+      reader,
+    );
+    expect(result.kind).toBe(kind);
+  });
+
+  it('document with caption is unwrapped', () => {
+    const proto: any = {
+      documentWithCaptionMessage: { message: { documentMessage: {} } },
+    };
