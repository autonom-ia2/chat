--- /dev/null
+++ b/src/apps/chatwoot/messages/to/whatsapp/c2y2.helpers.test.ts
@@ -0,0 +1,133 @@
+import {
+  C2yActionEvent,
+  IsC2yActionEvent,
+  ParseC2yEdit,
+  ParseC2yReaction,
+} from '@waha/apps/chatwoot/messages/to/whatsapp/actions';
+import {
+  WahaFormattedText,
+  WantsMediaAsMedia,
+} from '@waha/apps/chatwoot/messages/to/whatsapp/hints';
+import { JpegFilename } from '@waha/apps/chatwoot/messages/to/whatsapp/media';
+import {
+  BuildWahaNativeRequest,
+  DeterministicMessageId,
+  ParseWahaNative,
+} from '@waha/apps/chatwoot/messages/to/whatsapp/native';
+
+describe('c2y-rich-2 helpers', () => {
+  it('IsC2yActionEvent accepts only the two custom events', () => {
+    expect(IsC2yActionEvent(C2yActionEvent.REACTION)).toBe(true);
+    expect(IsC2yActionEvent(C2yActionEvent.EDIT)).toBe(true);
+    expect(IsC2yActionEvent('message_created')).toBe(false);
+    expect(IsC2yActionEvent('message_updated')).toBe(false);
+    expect(IsC2yActionEvent(undefined)).toBe(false);
+  });
+
+  it('ParseC2yReaction', () => {
+    expect(ParseC2yReaction({ c2y_reaction: { emoji: '👍' } })).toEqual({
+      emoji: '👍',
+    });
+    expect(ParseC2yReaction({ c2y_reaction: { emoji: '' } })).toEqual({
+      emoji: '',
+    });
+    expect(ParseC2yReaction({})).toBeNull();
+    expect(ParseC2yReaction(null)).toBeNull();
+  });
+
+  it('ParseC2yEdit', () => {
+    expect(ParseC2yEdit({ c2y_edit: { waha_text: 'a' } })).toEqual({
+      text: 'a',
+    });
+    expect(ParseC2yEdit({ c2y_edit: { waha_text: '' } })).toBeNull();
+    expect(
+      ParseC2yEdit({ c2y_edit: { waha_text: 'x'.repeat(65537) } }),
+    ).toBeNull();
+  });
+
+  it('WahaFormattedText / WantsMediaAsMedia read only exact types', () => {
+    expect(WahaFormattedText({ content_attributes: { waha_text: '' } })).toBe(
+      '',
+    );
+    expect(WahaFormattedText({ content_attributes: {} })).toBeNull();
+    expect(WahaFormattedText(null)).toBeNull();
+    expect(
+      WantsMediaAsMedia({ content_attributes: { waha_media_as_media: true } }),
+    ).toBe(true);
+    expect(
+      WantsMediaAsMedia({ content_attributes: { waha_media_as_media: 'true' } }),
+    ).toBe(false);
+    expect(WantsMediaAsMedia({})).toBe(false);
+  });
+
+  it('JpegFilename', () => {
+    expect(JpegFilename('foto.webp')).toBe('foto.jpg');
+    expect(JpegFilename('IMG 001.HEIC')).toBe('IMG 001.jpg');
+    expect(JpegFilename('semext')).toBe('semext.jpg');
+    expect(JpegFilename(undefined)).toBe('image.jpg');
+    expect(JpegFilename('')).toBe('image.jpg');
+  });
+});
+
+describe('native sendPoll (c2y-rich-2, item 1)', () => {
+  const chatId = '5511999999999@c.us';
+
+  it('ParseWahaNative accepts sendPoll', () => {
+    const native = ParseWahaNative({
+      content_attributes: {
+        waha_native: { kind: 'sendPoll', payload: { poll: { name: 'x' } } },
+      },
+    });
+    expect(native?.kind).toBe('sendPoll');
+  });
+
+  it('BuildWahaNativeRequest copies only name, options and multipleAnswers', () => {
+    const request = BuildWahaNativeRequest(
+      {
+        kind: 'sendPoll',
+        payload: {
+          chatId: 'attacker@c.us',
+          session: 'x',
+          poll: {
+            name: 'Qual?',
+            options: ['A', 'B'],
+            multipleAnswers: 'yes',
+            extra: 1,
+          },
+        },
+      },
+      chatId,
+      'true_x@c.us_Q',
+      'ID1',
+    );
+    expect(request).toEqual({
+      session: '',
+      chatId: chatId,
+      id: 'ID1',
+      poll: { name: 'Qual?', options: ['A', 'B'], multipleAnswers: true },
+      reply_to: 'true_x@c.us_Q',
+    });
+  });
+
+  it('payload without poll: request still built, WAHA validation refuses it', () => {
+    const request: any = BuildWahaNativeRequest(
+      { kind: 'sendPoll', payload: {} },
+      chatId,
+      undefined,
+      'ID1',
+    );
+    expect(request.poll).toEqual({
+      name: undefined,
+      options: undefined,
+      multipleAnswers: false,
+    });
+  });
+
+  it('deterministic id is stable and depends on the kind', () => {
+    const a = DeterministicMessageId('s', 1, 'sendPoll');
+    expect(a).toBe(DeterministicMessageId('s', 1, 'sendPoll'));
+    expect(a).not.toBe(DeterministicMessageId('s', 1, 'sendLocation'));
+    expect(a.startsWith('3EB0')).toBe(true);
+    expect(a).toHaveLength(22);
+  });
+});
diff --git a/src/apps/chatwoot/messages/to/whatsapp/hints.ts b/src/apps/chatwoot/messages/to/whatsapp/hints.ts
