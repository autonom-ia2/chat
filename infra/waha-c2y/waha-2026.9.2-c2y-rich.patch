+import type { proto } from '@adiwajshing/baileys';
+import { extractWALocation } from '@waha/core/engines/waproto/locaiton';
+import { SimpleVCardInfo } from '@waha/core/vcard';
+import esm from '@waha/vendor/esm';
+
+/**
+ * Autonom.ia patch c2y-rich-3 (autonom-ia2/chat#1709, round 2)
+ *
+ * Structured data the connector puts NEXT TO the message it already creates
+ * (same content, message_type, private and in_reply_to). chat2you always
+ * strips these keys and only changes the presentation with its account flag.
+ *
+ * Pure helpers: no network, no logging, never throw. Message text, phones
+ * and keys never reach a log from here.
+ */
+
+export type WahaMediaKind =
+  | 'voice'
+  | 'audio'
+  | 'image'
+  | 'video'
+  | 'document'
+  | 'sticker';
+
+export interface WahaMedia {
+  kind: WahaMediaKind;
+  mimetype: string | null;
+  filename: string | null;
+  ptt: boolean;
+  view_once: boolean;
+  animated: boolean;
+  lottie: boolean;
+}
+
+export interface WahaMediaFailed {
+  kind: WahaMediaKind;
+  mimetype: string | null;
+  filename: string | null;
+  caption: string | null;
+  reason: string;
+  from_me: boolean;
+}
+
+export interface WahaContext {
+  // null = the message does not say (no contextInfo / no expiration)
+  ephemeral_expiration: number | null;
+  forwarded: boolean;
+  forwarding_score: number;
+}
+
+export interface WahaLocation {
+  latitude: number;
+  longitude: number;
+  name: string | null;
+  address: string | null;
+  url: string | null;
+  live: boolean;
+  caption: string | null;
+}
+
+export interface WahaSharedContact {
+  full_name: string;
+  phones: string[];
+  wa_id: string | null;
+}
+
+export interface WahaQuote {
+  wa_id: string;
+  participant: string | null;
+  from_me: boolean | null;
+  body: string;
+  has_media: boolean;
+  chatwoot_message_id: number | null;
+}
+
+export interface WahaAlbum {
+  expected_images: number;
+  expected_videos: number;
+}
+
+export interface WahaOrder {
+  order_id: string | null;
+  title: string | null;
+  text: string | null;
+  item_count: number | null;
+  total_amount: number | null;
+  currency: string | null;
+  status: string | null;
+  seller_jid: string | null;
+  from_me: boolean;
+}
+
+export const QUOTE_BODY_MAX_CHARS = 280;
+
+/** Lottie stickers come with this mimetype from WhatsApp (see LottieMediaProcessorWrapper) */
+const LOTTIE_MIMETYPE = 'application/was';
+
+const VIEW_ONCE_WRAPPERS = [
+  'viewOnceMessage',
+  'viewOnceMessageV2',
+  'viewOnceMessageV2Extension',
+] as const;
+
+/** whatsmeow unwraps view-once messages and flags them on events.Message */
+const VIEW_ONCE_FLAGS = [
+  'IsViewOnce',
+  'IsViewOnceV2',
+  'IsViewOnceV2Extension',
+] as const;
+
+const KIND_BY_TYPE: Record<string, WahaMediaKind> = {
+  imageMessage: 'image',
+  videoMessage: 'video',
+  ptvMessage: 'video',
+  stickerMessage: 'sticker',
+  documentMessage: 'document',
+  documentWithCaptionMessage: 'document',
+};
+
+const KIND_BY_MIME_FAMILY: Record<string, WahaMediaKind> = {
+  image: 'image',
+  video: 'video',
+  audio: 'audio',
+};
+
+/**
+ * Reads the proto content type. The default uses Baileys (ESM, loaded at
+ * runtime by WAHA); tests inject their own reader.
+ */
+export interface ProtoReader {
+  normalize(
+    message: proto.IMessage | null | undefined,
+  ): proto.IMessage | null | undefined;
+  contentType(message: proto.IMessage | null | undefined): string | undefined;
+}
+
+export const BaileysProtoReader: ProtoReader = {
+  normalize: (message) => esm.b.normalizeMessageContent(message),
+  contentType: (message) => esm.b.getContentType(message),
+};
+
+export interface ReadProto {
+  content: any | null;
+  type: string | null;
+}
+
+/**
+ * Normalized content (ephemeral / view once / document with caption
+ * unwrapped) and its content type. Never throws: when the reader fails the
+ * raw message is used and the type is unknown.
+ */
+export function ReadProtoMessage(
+  protoMessage: proto.IMessage | null | undefined,
+  reader: ProtoReader = BaileysProtoReader,
+): ReadProto {
+  if (!protoMessage || typeof protoMessage !== 'object') {
+    return { content: null, type: null };
+  }
+  let content: any = protoMessage;
+  try {
+    content = reader.normalize(protoMessage) || protoMessage;
+  } catch (err) {
+    content = protoMessage;
+  }
+  let type: string | null = null;
+  try {
+    const value = reader.contentType(content);
+    type = typeof value === 'string' && value ? value : null;
+  } catch (err) {
+    type = null;
+  }
+  return { content: content, type: type };
+}
+
+function isObject(value: unknown): value is Record<string, any> {
+  return Boolean(value) && typeof value === 'object' && !Array.isArray(value);
+}
+
+function textOrNull(value: unknown): string | null {
+  return typeof value === 'string' && value.length > 0 ? value : null;
+}
+
+function finiteNumber(value: unknown): number | null {
+  if (value === null || value === undefined || value === '') {
+    return null;
+  }
+  if (typeof value !== 'number' && typeof value !== 'string') {
+    // Long-like objects from protobuf
+    if (isObject(value) && typeof value.toString === 'function') {
+      return finiteNumber(value.toString());
+    }
+    return null;
+  }
+  const n = Number(value);
+  return Number.isFinite(n) ? n : null;
+}
+
+/** Cuts by characters (code points), never in the middle of an emoji */
+export function TruncateChars(text: string, max: number): string {
+  const chars = Array.from(text);
+  if (chars.length <= max) {
+    return text;
+  }
+  return chars.slice(0, max).join('');
+}
+
+export function MediaKind(read: ReadProto, mimetype: unknown): WahaMediaKind {
+  const type = read.type;
+  if (type === 'audioMessage') {
+    return read.content?.audioMessage?.ptt === true ? 'voice' : 'audio';
+  }
+  if (type && KIND_BY_TYPE[type]) {
+    return KIND_BY_TYPE[type];
+  }
+  if (typeof mimetype === 'string') {
+    const family = mimetype.split('/')[0];
+    if (KIND_BY_MIME_FAMILY[family]) {
+      return KIND_BY_MIME_FAMILY[family];
+    }
+  }
+  return 'document';
+}
+
+export function IsViewOnce(
+  protoMessage: proto.IMessage | null | undefined,
+  data: any,
+  read: ReadProto,
+): boolean {
+  if (isObject(data) && VIEW_ONCE_FLAGS.some((flag) => data[flag] === true)) {
+    return true;
+  }
+  if (isObject(protoMessage)) {
+    const raw = protoMessage as Record<string, any>;
+    if (VIEW_ONCE_WRAPPERS.some((key) => isObject(raw[key]))) {
+      return true;
+    }
+  }
+  const media = read.type ? read.content?.[read.type] : null;
+  return isObject(media) && media.viewOnce === true;
+}
+
+/**
+ * content_attributes.waha_media - only when the message has a downloaded
+ * attachment (payload.media.url).
+ */
+export function WahaMediaOf(
+  payload: any,
+  protoMessage: proto.IMessage | null | undefined,
+  reader: ProtoReader = BaileysProtoReader,
+): WahaMedia | null {
+  const media = payload?.media;
+  if (!isObject(media) || !textOrNull(media.url)) {
+    return null;
+  }
+  const read = ReadProtoMessage(protoMessage, reader);
+  const sticker = read.content?.stickerMessage;
+  return {
+    kind: MediaKind(read, media.mimetype),
+    mimetype: textOrNull(media.mimetype),
+    filename: textOrNull(media.filename),
+    ptt: read.type === 'audioMessage' && read.content?.audioMessage?.ptt === true,
+    view_once: IsViewOnce(protoMessage, payload?._data, read),
+    animated: isObject(sticker) && sticker.isAnimated === true,
+    lottie:
+      isObject(sticker) &&
+      (sticker.isLottie === true || sticker.mimetype === LOTTIE_MIMETYPE),
+  };
+}
+
+function isIdentifier(text: string): boolean {
+  if (text.length === 0 || text.length > 64) {
+    return false;
+  }
+  for (const ch of text) {
+    const code = ch.charCodeAt(0);
+    const digit = code >= 48 && code <= 57;
+    const upper = code >= 65 && code <= 90;
+    const lower = code >= 97 && code <= 122;
+    if (!digit && !upper && !lower && ch !== '_') {
+      return false;
+    }
+  }
+  return true;
+}
+
+/**
+ * Error CLASS of a failed download, never its message or stack.
+ * The error object reaches the connector through the job JSON, where
+ * Error#name is gone and only `details` (the stack) is left: the class is
+ * the text before the first ':' of its first line.
+ */
+export function MediaFailureReason(media: any): string {
+  if (!isObject(media)) {
+    return 'no_media';
+  }
+  const err = media.error;
+  if (!err) {
+    return 'not_downloaded';
+  }
+  const candidates: unknown[] = [];
+  if (err instanceof Error) {
+    candidates.push(err.name, err.constructor?.name);
+  }
+  if (isObject(err)) {
+    candidates.push(err.name);
+    if (typeof err.details === 'string') {
+      candidates.push(err.details.split('\n')[0].split(':')[0].trim());
+    }
+  }
+  for (const candidate of candidates) {
+    if (typeof candidate === 'string' && isIdentifier(candidate)) {
+      return candidate;
+    }
+  }
+  return 'unknown';
+}
+
+/**
+ * The media could not be downloaded: only when the engine says so
+ * (media.error, set by MediaManager.processMedia when the download throws).
+ * Not a failure:
+ * - media skipped on purpose: download off or mimetype filtered come as
+ *   {url: null} without error (MediaManager.processMedia);
+ * - media null or missing: the engine did not try (another engine, or the
+ *   media processor not run), so the main note stays as it is.
+ */
+export function IsMediaDownloadFailure(payload: any): boolean {
+  if (!payload?.hasMedia) {
+    return false;
+  }
+  const media = payload.media;
+  if (!isObject(media)) {
+    return false;
+  }
+  if (textOrNull(media.url)) {
+    return false;
+  }
+  return Boolean(media.error);
+}
+
+/** content_attributes.waha_media_failed */
+export function WahaMediaFailedOf(
+  payload: any,
+  protoMessage: proto.IMessage | null | undefined,
+  reader: ProtoReader = BaileysProtoReader,
+): WahaMediaFailed {
+  const media = isObject(payload?.media) ? payload.media : null;
+  const read = ReadProtoMessage(protoMessage, reader);
+  return {
+    kind: MediaKind(read, media?.mimetype),
+    mimetype: textOrNull(media?.mimetype),
+    filename: textOrNull(media?.filename),
+    caption: textOrNull(payload?.body),
+    reason: MediaFailureReason(media),
+    // The business phone's own media: chat2you keeps the main note
+    from_me: payload?.fromMe === true,
+  };
+}
+
+/**
+ * ephemeral_expiration of the message, in seconds:
+ * - the expiration in the contextInfo, when the message has one (0 only when
+ *   it comes as 0);
+ * - null when the message does not say: no contextInfo (plain `conversation`
+ *   text has none), contextInfo without expiration, or a 0 contradicted by
+ *   the engine (whatsmeow `IsEphemeral` on events.Message, which carries no
+ *   seconds). chat2you only acts on an Integer, so null never flips the
+ *   conversation state.
+ */
+function EphemeralExpiration(
+  ctx: Record<string, any> | null,
+  data: any,
+): number | null {
+  if (!ctx || !Object.prototype.hasOwnProperty.call(ctx, 'expiration')) {
+    return null;
+  }
+  const expiration = finiteNumber(ctx.expiration);
+  if (expiration === null || expiration < 0) {
+    return null;
+  }
+  if (expiration === 0 && isObject(data) && data.IsEphemeral === true) {
+    return null;
+  }
+  return Math.trunc(expiration);
+}
+
+/**
+ * content_attributes.waha_context, on every live message.
+ * ephemeral_expiration is null when the message does not tell (see
+ * EphemeralExpiration): chat2you needs an explicit 0 to say "turned off".
+ */
+export function WahaContextOf(
+  payload: any,
+  protoMessage: proto.IMessage | null | undefined,
+  reader: ProtoReader = BaileysProtoReader,
+): WahaContext {
+  const read = ReadProtoMessage(protoMessage, reader);
+  const media = read.type ? read.content?.[read.type] : null;
+  const contextInfo = isObject(media) ? media.contextInfo : null;
+  const ctx = isObject(contextInfo) ? contextInfo : null;
+  const score = finiteNumber(ctx?.forwardingScore);
+  return {
+    ephemeral_expiration: EphemeralExpiration(ctx, payload?._data),
+    forwarded: ctx?.isForwarded === true,
+    forwarding_score: score !== null && score > 0 ? Math.trunc(score) : 0,
+  };
+}
+
+/** content_attributes.waha_location - null when the coordinates are not numbers */
+export function WahaLocationOf(
+  payload: any,
+  protoMessage: proto.IMessage | null | undefined,
+  reader: ProtoReader = BaileysProtoReader,
+): WahaLocation | null {
+  let location: any = payload?.location;
+  if (!isObject(location)) {
+    const read = ReadProtoMessage(protoMessage, reader);
+    try {
+      location = read.content ? extractWALocation(read.content) : null;
+    } catch (err) {
+      location = null;
+    }
+  }
+  if (!isObject(location)) {
+    return null;
+  }
+  const latitude = finiteNumber(location.latitude);
+  const longitude = finiteNumber(location.longitude);
+  if (latitude === null || longitude === null) {
+    return null;
+  }
+  return {
+    latitude: latitude,
+    longitude: longitude,
+    name: textOrNull(location.name),
+    address: textOrNull(location.address),
+    url: textOrNull(location.url),
+    live: location.live === true,
+    caption: textOrNull(location.description),
+  };
+}
+
+/**
+ * content_attributes.waha_contacts, same order as the .vcf attachments.
+ * null when any vCard could not be parsed.
+ */
+export function WahaContactsOf(
+  contacts: SimpleVCardInfo[],
+  vcardCount: number,
+): WahaSharedContact[] | null {
+  if (!Array.isArray(contacts) || contacts.length === 0) {
+    return null;
+  }
+  if (contacts.length !== vcardCount) {
+    return null;
+  }
+  return contacts.map((contact) => ({
+    full_name: typeof contact?.fullName === 'string' ? contact.fullName : '',
+    phones: Array.isArray(contact?.phoneNumbers)
+      ? contact.phoneNumbers.filter((p) => typeof p === 'string' && p)
+      : [],
+    wa_id: textOrNull(contact?.whatsappId),
+  }));
+}
+
+/** content_attributes.waha_quote - null without a quoted message id */
+export function WahaQuoteOf(
+  replyTo: any,
+  chatwootMessageId: number | null | undefined,
+  fromMe: boolean | null,
+): WahaQuote | null {
+  if (!isObject(replyTo) || !textOrNull(replyTo.id)) {
+    return null;
+  }
+  const body = typeof replyTo.body === 'string' ? replyTo.body : '';
+  return {
+    wa_id: replyTo.id,
+    participant: textOrNull(replyTo.participant),
+    from_me: fromMe === true ? true : null,
+    body: TruncateChars(body, QUOTE_BODY_MAX_CHARS),
+    has_media: replyTo.hasMedia === true,
+    chatwoot_message_id:
+      typeof chatwootMessageId === 'number' ? chatwootMessageId : null,
+  };
+}
+
+/** User part of a JID ("5511...@c.us", "123:4@s.whatsapp.net", "99@lid") */
+export function JidUser(jid: unknown): string | null {
+  if (typeof jid !== 'string' || !jid) {
+    return null;
+  }
+  const user = jid.split('@')[0].split(':')[0];
+  return user || null;
+}
+
+/** content_attributes.waha_album */
+export function WahaAlbumOf(albumMessage: any): WahaAlbum {
+  const images = finiteNumber(albumMessage?.expectedImageCount);
+  const videos = finiteNumber(albumMessage?.expectedVideoCount);
+  return {
+    expected_images: images !== null && images > 0 ? Math.trunc(images) : 0,
+    expected_videos: videos !== null && videos > 0 ? Math.trunc(videos) : 0,
+  };
+}
+
+/** content_attributes.waha_order - null when the message is not an order */
+export function WahaOrderOf(
+  read: ReadProto,
+  fromMe: boolean,
+): WahaOrder | null {
+  const order = read.content?.orderMessage;
+  if (!isObject(order)) {
+    return null;
+  }
+  const total1000 = finiteNumber(order.totalAmount1000);
+  const itemCount = finiteNumber(order.itemCount);
+  const status =
+    typeof order.status === 'string' || typeof order.status === 'number'
+      ? String(order.status)
+      : null;
+  return {
+    order_id: textOrNull(order.orderId),
+    title: textOrNull(order.orderTitle),
+    text: textOrNull(order.message),
+    item_count: itemCount,
+    total_amount: total1000 === null ? null : total1000 / 1000,
+    currency: textOrNull(order.totalCurrencyCode),
+    status: status,
+    seller_jid: textOrNull(order.sellerJid),
+    // The business phone's own order: chat2you keeps the main note
+    from_me: fromMe === true,
+  };
+}
+
+/** waha_unknown.gif - a GIF the connector did not convert */
+export function IsGif(read: ReadProto): boolean {
+  const video = read.content?.videoMessage;
+  return isObject(video) && video.gifPlayback === true;
+}
diff --git a/src/apps/chatwoot/messages/to/whatsapp/actions.ts b/src/apps/chatwoot/messages/to/whatsapp/actions.ts
