+  });
+  const repo = {
+    ConversationByContact: jest.fn().mockResolvedValue(byContact),
+    ConversationById: jest.fn(byId),
+  };
+  const mapping = {
+    // the event itself is never mapped; the target is (or not)
+    getChatWootMessage: jest.fn(async (key: any) =>
+      key.message_id === 'TARGET1' ? target : null,
+    ),
+    map: jest.fn().mockResolvedValue(undefined),
+  };
+  const info: any = { onConversationId: jest.fn(), onMessageType: jest.fn() };
+  const handler = new Cls(
+    { id: 'job-1', queueName: 'q' },
+    mapping,
+    repo,
+    JestLogger(),
+    info,
+    { name: 'hub2you' },
+    i18n.locale('en-US'),
+    {},
+    ChatWootOutgoingMode.PRIVATE_NOTE,
+  );
+  return { handler, repo, mapping, sent, info };
+}
+
+const NOW = Math.floor(Date.now() / 1000);
+
+function reaction() {
+  return {
+    id: `false_${CUSTOMER}_REACT1`,
+    from: CUSTOMER,
+    fromMe: false,
+    timestamp: NOW,
+    reaction: { text: '👍', messageId: `true_${CUSTOMER}_TARGET1` },
+  };
+}
+
+function edit(extra: any = {}) {
+  return {
+    id: `false_${CUSTOMER}_EDIT1`,
+    from: CUSTOMER,
+    fromMe: false,
+    timestamp: NOW,
+    body: 'novo texto',
+    editedMessageId: 'TARGET1',
+    _data: {},
+    ...extra,
+  };
+}
+
+describe.each([
+  ['reaction', MessageReactionHandler, reaction],
+  ['edit', MessageEditedHandler, edit],
+])(
+  'c2y-rich-5: %s goes to the conversation of the target message',
+  (_name, Cls, payload) => {
+    afterEach(() => jest.clearAllMocks());
+
+    it('target mapped in an older conversation -> ConversationById(that one), no new conversation', async () => {
+      const { handler, repo, sent, info } = inboundSetup(Cls, {
+        message_id: 555,
+        conversation_id: 42,
+      });
+      await handler.handle(payload());
+      expect(repo.ConversationById).toHaveBeenCalledWith(42);
+      expect(repo.ConversationByContact).not.toHaveBeenCalled();
+      expect(info.onConversationId).toHaveBeenCalledWith(42);
+      expect(sent).toHaveLength(1);
+      expect(sent[0].conversation).toBe(42);
+      expect(sent[0].body.content_attributes.in_reply_to).toBe(555);
+    });
+
+    it('target not mapped -> the contact conversation, as before', async () => {
+      const { handler, repo, sent } = inboundSetup(Cls, null);
+      await handler.handle(payload());
+      expect(repo.ConversationById).not.toHaveBeenCalled();
+      expect(repo.ConversationByContact).toHaveBeenCalledTimes(1);
+      expect(sent).toHaveLength(1);
+      expect(sent[0].conversation).toBe(99);
+      expect(sent[0].body.content_attributes.in_reply_to).toBeUndefined();
+    });
+
+    it('target mapping without a conversation id -> the contact conversation', async () => {
+      const { handler, repo, sent } = inboundSetup(Cls, {
+        message_id: 555,
+        conversation_id: null,
+      });
+      await handler.handle(payload());
+      expect(repo.ConversationById).not.toHaveBeenCalled();
+      expect(repo.ConversationByContact).toHaveBeenCalledTimes(1);
+      expect(sent[0].conversation).toBe(99);
+    });
+  },
+);
+
+describe('c2y-rich-5: other handlers keep the contact conversation', () => {
+  it('default handler (c2yInTargetConversation = false) uses the contact conversation even with a mapped reply', async () => {
+    class Plain extends MessageBaseHandler<any> {
+      async getMessage() {
+        return { content: 'x', attachments: [], private: undefined };
+      }
+      getReplyToWhatsAppID() {
+        return 'TARGET1';
+      }
+    }
+    const { handler, repo, sent } = inboundSetup(Plain, {
+      message_id: 555,
+      conversation_id: 42,
+    });
+    await handler.handle(edit());
+    expect(repo.ConversationById).not.toHaveBeenCalled();
+    expect(repo.ConversationByContact).toHaveBeenCalledTimes(1);
+    expect(sent[0].conversation).toBe(99);
+    // in_reply_to still found as before
+    expect(sent[0].body.content_attributes.in_reply_to).toBe(555);
+  });
+});
+
+/* ------------------------------------------------------------------ */
+/* C2: waha_edit.timestamp = time of the edit, epoch seconds          */
+/* ------------------------------------------------------------------ */
+
+describe('c2y-rich-5: waha_edit.timestamp', () => {
+  const l = i18n.locale('en-US');
+
+  it('seconds from the edit event itself', () => {
+    const msg = new MessageEdited(l).convert(
+      edit({ timestamp: 1760600000 }) as any,
+      null,
+    );
+    expect(msg.content_attributes.waha_edit).toEqual({
+      text: 'novo texto',
+      edited_wa_id: 'TARGET1',
+      from_me: false,
+      timestamp: 1760600000,
+    });
+    expect(Number.isInteger(msg.content_attributes.waha_edit['timestamp'])).toBe(
+      true,
+    );
+  });
+
+  it('milliseconds are turned into seconds', () => {
+    expect(EditTimestampSeconds({ timestamp: 1760600000123 })).toBe(1760600000);
+  });
+
+  it.each([
+    ['absent', undefined],
+    ['null', null],
+    ['zero', 0],
+    ['negative', -5],
+    ['not a number', 'abc'],
+    ['NaN', NaN],
+  ])('%s -> no timestamp key', (_label, value) => {
+    const msg = new MessageEdited(l).convert(
+      edit({ timestamp: value }) as any,
+      null,
+    );
+    expect(msg.content_attributes.waha_edit).not.toHaveProperty('timestamp');
+    expect(msg.content_attributes.waha_edit).toEqual({
+      text: 'novo texto',
+      edited_wa_id: 'TARGET1',
+      from_me: false,
+    });
+  });
+
+  it('the body sent to Chatwoot by the edit handler carries it', async () => {
+    const { handler, sent } = inboundSetup(MessageEditedHandler, {
+      message_id: 555,
+      conversation_id: 42,
+    });
+    await handler.handle(edit({ timestamp: NOW }));
+    expect(sent[0].body.content_attributes.waha_edit.timestamp).toBe(NOW);
+  });
+});
