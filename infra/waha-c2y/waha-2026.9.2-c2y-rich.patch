+
+const CUSTOMER = '5511999999999@c.us';
+const WA_ID = '3A0123456789ABCDEF';
+
+/* ------------------------------------------------------------------ */
+/* C1: view once notice only for the inboxes that asked for it        */
+/* ------------------------------------------------------------------ */
+
+function viewOnceEvent() {
+  return {
+    event: 'c2y.message.view_once.unavailable',
+    session: 'hub2you',
+    payload: BuildViewOnceUnavailablePayload({
+      Info: {
+        Chat: '5511999999999@s.whatsapp.net',
+        IsFromMe: false,
+        IsGroup: false,
+        ID: WA_ID,
+        Timestamp: new Date().toISOString(),
+      },
+      IsUnavailable: true,
+      UnavailableType: 'view_once',
+    }),
+  };
+}
+
+function consumerWith(appConfig: Record<string, unknown>) {
+  const sent: any[] = [];
+  const conversation = {
+    conversationId: 7,
+    send: jest.fn(async (body: any) => {
+      sent.push(body);
+      return {
+        id: 901,
+        created_at: Math.floor(Date.now() / 1000),
+        conversation_id: 7,
+      };
+    }),
+  };
+  const repo = {
+    ConversationByContact: jest.fn().mockResolvedValue(conversation),
+    ConversationById: jest.fn(() => conversation),
+  };
+  const mapping = {
+    getChatWootMessage: jest.fn().mockResolvedValue(null),
+    map: jest.fn().mockResolvedValue(undefined),
+  };
+  const logger = JestLogger();
+  const container = {
+    ChatWootConfig: jest.fn(() =>
+      ChatWootConfigDefaults(appConfig as unknown as ChatWootAppConfig),
+    ),
+    MessageMappingService: jest.fn(() => mapping),
+    ContactConversationService: jest.fn(() => repo),
+    Logger: jest.fn(() => logger),
+    WAHASelf: jest.fn(() => ({})),
+    Locale: jest.fn(() => i18n.locale('pt-BR')),
+    OutgoingMode: jest.fn(() => ChatWootOutgoingMode.PRIVATE_NOTE),
+  };
+  const pino: any = { logger: { child: () => JestLogger() } };
+  const consumer: any = new WAHAViewOnceUnavailableConsumer(
