@@ -0,0 +1,19 @@
+/**
+ * Autonom.ia patch c2y-rich-2 (autonom-ia2/chat#1709)
+ * Hints chat2you adds to the message_created webhook payload (never stored),
+ * only for accounts with the feature on. Without them the connector keeps
+ * its original behavior.
+ *
+ * - content_attributes.waha_text: text already in WhatsApp format
+ *   (same renderer as the Cloud channel); used as is, no markdown conversion
+ * - content_attributes.waha_media_as_media: true - images and videos in any
+ *   format go as photo / playable video, not as a document
+ */
+export function WahaFormattedText(message: any): string | null {
+  const text = message?.content_attributes?.waha_text;
+  return typeof text === 'string' ? text : null;
+}
+
+export function WantsMediaAsMedia(message: any): boolean {
+  return message?.content_attributes?.waha_media_as_media === true;
+}
diff --git a/src/apps/chatwoot/messages/to/whatsapp/media.test.ts b/src/apps/chatwoot/messages/to/whatsapp/media.test.ts
new file mode 100644
index 00000000..b706c9df
--- /dev/null
+++ b/src/apps/chatwoot/messages/to/whatsapp/media.test.ts
@@ -0,0 +1,104 @@
+import * as http from 'http';
+import { AddressInfo } from 'net';
+import {
+  FetchLimited,
+  MAX_IMAGE_DOWNLOAD_BYTES,
+  MAX_IMAGE_INPUT_PIXELS,
+  SharpToJpeg,
+} from '@waha/apps/chatwoot/messages/to/whatsapp/media';
+
+/**
+ * Autonom.ia c2y-rich-2: the image conversion must not load an unbounded
+ * download or decode an unbounded image in the shared WAHA process.
+ */
+describe('c2y-rich-2 media limits', () => {
+  let server: http.Server;
+  let base: string;
+
+  beforeAll(async () => {
+    server = http.createServer((req, res) => {
+      const size = Number(req.url.split('/').pop());
+      res.writeHead(200, { 'Content-Type': 'image/webp' });
+      // Streamed in chunks, without Content-Length: the limit must hold
+      // while streaming, not only from the header
+      const chunk = Buffer.alloc(1024, 1);
+      let left = size;
+      const write = () => {
+        while (left > 0) {
+          const part = left >= chunk.length ? chunk : chunk.subarray(0, left);
+          left -= part.length;
+          if (!res.write(part)) {
+            res.once('drain', write);
+            return;
+          }
+        }
+        res.end();
+      };
+      res.on('error', () => undefined);
+      write();
+    });
+    await new Promise<void>((resolve) =>
+      server.listen(0, '127.0.0.1', resolve),
+    );
+    const port = (server.address() as AddressInfo).port;
+    base = `http://127.0.0.1:${port}`;
+  });
+
+  afterAll(async () => {
+    server.closeAllConnections?.();
+    await new Promise((resolve) => server.close(resolve));
+  });
+
+  it('download cap is the WhatsApp media limit (16 MB)', () => {
+    expect(MAX_IMAGE_DOWNLOAD_BYTES).toBe(16 * 1024 * 1024);
+  });
+
+  it('downloads a body within the limit', async () => {
+    const body = await FetchLimited(`${base}/img/2048`, 4096);
+    expect(body.length).toBe(2048);
+  });
+
+  it('rejects a body above the limit', async () => {
+    await expect(FetchLimited(`${base}/img/65536`, 4096)).rejects.toThrow(
+      /maxContentLength/,
+    );
+  });
+
+  it('pixel cap is explicit and below the sharp default', () => {
+    expect(MAX_IMAGE_INPUT_PIXELS).toBe(50_000_000);
+    expect(MAX_IMAGE_INPUT_PIXELS).toBeLessThan(0x3fff * 0x3fff);
+  });
+
+  it('converts an image within the pixel limit', async () => {
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const sharp = require('sharp');
+    const png = await sharp({
+      create: {
+        width: 20,
+        height: 20,
+        channels: 3,
+        background: { r: 255, g: 0, b: 0 },
+      },
+    })
+      .png()
+      .toBuffer();
+    const jpeg = await SharpToJpeg(png, 400);
+    expect(jpeg.subarray(0, 2)).toEqual(Buffer.from([0xff, 0xd8]));
+  });
+
+  it('refuses an image above the pixel limit', async () => {
+    // eslint-disable-next-line @typescript-eslint/no-var-requires
+    const sharp = require('sharp');
+    const png = await sharp({
+      create: {
+        width: 30,
+        height: 30,
+        channels: 3,
+        background: { r: 0, g: 0, b: 255 },
+      },
+    })
+      .png()
+      .toBuffer();
+    await expect(SharpToJpeg(png, 400)).rejects.toThrow(/pixel limit/);
+  });
+});
diff --git a/src/apps/chatwoot/messages/to/whatsapp/media.ts b/src/apps/chatwoot/messages/to/whatsapp/media.ts
