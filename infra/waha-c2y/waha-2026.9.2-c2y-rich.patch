--- /dev/null
+++ b/src/apps/chatwoot/consumers/waha/view_once.c2y4.test.ts
@@ -0,0 +1,305 @@
+// The real helper pulls ESM-only Baileys, which jest can not load
+jest.mock('@waha/apps/chatwoot/waha', () => ({
+  EngineHelper: {
+    ChatID: jest.fn((p: any) => p.from),
+    PhoneNumber: jest.fn(() => null),
+    IsReplyToStatus: jest.fn(() => false),
+    ExtractQuotedMedia: jest.fn(() => null),
+  },
+}));
+jest.mock('@waha/apps/chatwoot/messages/to/chatwoot/ListReply', () => ({
+  ExtractListReply: jest.fn(() => null),
+}));
+
+import { JestLogger } from '@waha/apps/app_sdk/jest/JestLogger';
+import { MessageAnyHandler } from '@waha/apps/chatwoot/consumers/waha/message.any';
+import {
+  BuildNoticePayload,
+  ViewOnceNoticeHandler,
+} from '@waha/apps/chatwoot/consumers/waha/view_once.unavailable';
+import { ChatWootOutgoingMode } from '@waha/apps/chatwoot/dto/config.dto';
+import { i18n } from '@waha/apps/chatwoot/i18n';
+import { ProtoReader } from '@waha/apps/chatwoot/messages/to/chatwoot/c2y3';
+import {
+  NoticeMappingKey,
+  RealMappingKey,
+} from '@waha/apps/chatwoot/messages/to/chatwoot/ViewOnceNotice';
+import { BuildViewOnceUnavailablePayload } from '@waha/core/engines/gows/c2y.viewonce';
+
+const CUSTOMER = '5511999999999@c.us';
+const WA_ID = '3A0123456789ABCDEF';
+const REAL_ID = `false_${CUSTOMER}_${WA_ID}`;
+const NOTICE_PT =
+  'Você recebeu uma mensagem de visualização única. Por motivos de privacidade, você só pode abrir essa mensagem no seu celular.';
+
+function engineEvent() {
+  return BuildViewOnceUnavailablePayload({
+    Info: {
+      Chat: '5511999999999@s.whatsapp.net',
+      Sender: '5511999999999@s.whatsapp.net',
+      IsFromMe: false,
+      IsGroup: false,
+      ID: WA_ID,
+      Timestamp: new Date().toISOString(),
+    },
+    IsUnavailable: true,
+    UnavailableType: 'view_once',
+  });
+}
+
+/**
+ * Mapping table double: rows keyed by chat_id + message_id, as the real
+ * MessageMappingService does.
+ */
+function mappingStore(rows: Record<string, number> = {}) {
+  const store: Record<string, number> = { ...rows };
+  return {
+    store,
+    getChatWootMessage: jest.fn(async (key: any) => {
+      const id = store[`${key.chat_id}|${key.message_id}`];
+      return id ? { message_id: id, conversation_id: 7 } : null;
+    }),
+    map: jest.fn(async (chatwoot: any, whatsapp: any) => {
+      store[`${whatsapp.chat_id}|${whatsapp.message_id}`] = chatwoot.message_id;
+    }),
+  };
+}
+
+function rowKey(key: { chat_id: string; message_id: string }) {
+  return `${key.chat_id}|${key.message_id}`;
+}
+
+function noticeSetup(rows: Record<string, number> = {}) {
+  const mapping = mappingStore(rows);
+  const logger = JestLogger();
+  const info: any = { onConversationId: jest.fn(), onMessageType: jest.fn() };
+  const sent: any[] = [];
+  let nextId = 900;
+  const conversation = {
+    conversationId: 7,
+    send: jest.fn(async (body: any) => {
+      sent.push(body);
+      nextId += 1;
+      return {
+        id: nextId,
+        created_at: Math.floor(Date.now() / 1000),
+        conversation_id: 7,
+      };
+    }),
+  };
+  const repo: any = {
+    ConversationByContact: jest.fn().mockResolvedValue(conversation),
+  };
+  const handler = new ViewOnceNoticeHandler(
+    { id: 'job-1', queueName: 'chatwoot.waha | c2y.view_once.unavailable' } as any,
+    mapping as any,
+    repo,
+    logger,
+    info,
+    { name: 'hub2you' } as any,
+    i18n.locale('pt-BR'),
+    {} as any,
+    ChatWootOutgoingMode.PRIVATE_NOTE,
+  );
+  return { handler, mapping, logger, sent, conversation };
+}
+
+describe('view once notice (c2y-rich-4)', () => {
+  afterEach(() => jest.clearAllMocks());
+
+  it('creates an incoming CUSTOMER message with the WhatsApp Web text', async () => {
+    const { handler, sent, mapping } = noticeSetup();
+    await handler.handle(BuildNoticePayload(engineEvent()));
+    expect(sent).toHaveLength(1);
+    const body = sent[0];
+    expect(body.content).toBe(NOTICE_PT);
+    expect(body.message_type).toBe('incoming');
+    expect(body.private).toBe(false);
+    expect(body.attachments).toEqual([]);
+    expect(body.content_attributes.waha_view_once_unavailable).toEqual({
+      from_me: false,
+      id: REAL_ID,
+    });
+    // mapped under the notice id, never under the real one
+    expect(mapping.store[rowKey(NoticeMappingKey(REAL_ID))]).toBe(901);
+    expect(mapping.store[rowKey(RealMappingKey(REAL_ID))]).toBeUndefined();
+  });
+
+  it('same id twice (whatsmeow emits again after the resend request): one notice', async () => {
+    const { handler, sent } = noticeSetup();
+    await handler.handle(BuildNoticePayload(engineEvent()));
+    await handler.handle(BuildNoticePayload(engineEvent()));
+    expect(sent).toHaveLength(1);
+  });
+
+  it('real message already in Chatwoot (content came first): no notice', async () => {
+    const { handler, sent } = noticeSetup({
+      [rowKey(RealMappingKey(REAL_ID))]: 555,
+    });
+    await handler.handle(BuildNoticePayload(engineEvent()));
+    expect(sent).toHaveLength(0);
+  });
+
+  it('english locale uses the english text', async () => {
+    const l = i18n.locale('en-US');
+    expect(l.r('whatsapp.to.chatwoot.message.view_once.unavailable')).toBe(
+      'You received a view once message. For added privacy, you can only open it on your phone.',
+    );
+  });
+
+  it('the notice payload keeps the real id apart from the mapping id', () => {
+    const payload = BuildNoticePayload(engineEvent());
+    expect(payload.c2y_wa_id).toBe(REAL_ID);
+    expect(payload.id).toBe(`${REAL_ID}-C2YVO`);
+    expect(payload.fromMe).toBe(false);
+  });
+});
+
+/** Baileys-like reader (Baileys itself is ESM, see c2y3.test.ts) */
+const reader: ProtoReader = {
+  normalize(message: any) {
+    const inner =
+      message?.viewOnceMessageV2?.message || message?.viewOnceMessage?.message;
+    return inner || message;
+  },
+  contentType(message: any) {
+    if (!message) return undefined;
+    return Object.keys(message).find(
+      (k) => k === 'conversation' || k.endsWith('Message'),
+    );
+  },
+};
+
+function anySetup(rows: Record<string, number> = {}, failLookup = false) {
+  const mapping: any = mappingStore(rows);
+  if (failLookup) {
+    mapping.getChatWootMessage = jest.fn(async (key: any) => {
+      if (key.message_id.endsWith('-C2YVO')) {
+        throw new TypeError(`db down ${CUSTOMER}`);
+      }
+      return null;
+    });
+  }
+  const logger = JestLogger();
+  const handler: any = new MessageAnyHandler(
+    { id: 'job-2', queueName: 'chatwoot.waha | message.any' } as any,
+    mapping,
+    {} as any,
+    logger,
+    { onConversationId: jest.fn(), onMessageType: jest.fn() } as any,
+    {
+      name: 'hub2you',
+      getSessionInfo: jest.fn().mockResolvedValue({ me: {} }),
+      getMessageById: jest.fn().mockResolvedValue(null),
+    } as any,
+    i18n.locale('pt-BR'),
+    { fetch: jest.fn().mockResolvedValue(Buffer.from('bytes')) } as any,
+    ChatWootOutgoingMode.PRIVATE_NOTE,
+  );
+  handler.c2yReader = reader;
+  handler.c2yMediaRetry = { enabled: false, waitsMs: [], timeoutMs: 1 };
+  return { handler, logger };
+}
+
+function viewOnceImage(viewOnce = true) {
+  const image = { mimetype: 'image/jpeg', viewOnce: viewOnce };
+  return {
+    id: REAL_ID,
+    timestamp: Math.floor(Date.now() / 1000),
+    from: CUSTOMER,
+    fromMe: false,
+    body: null,
+    hasMedia: true,
+    media: {
+      url: 'http://localhost:3000/api/files/s/a.jpeg',
+      mimetype: 'image/jpeg',
+      filename: null,
+    },
+    _data: {
+      Info: { Chat: CUSTOMER },
+      Message: viewOnce
+        ? { viewOnceMessageV2: { message: { imageMessage: image } } }
+        : { imageMessage: image },
+    },
+  };
+}
+
+describe('view once media after the notice: waha_view_once_resolved (c2y-rich-4)', () => {
+  afterEach(() => jest.clearAllMocks());
+
+  it('notice exists -> media keeps its attachment + resolved points to the notice', async () => {
+    const { handler } = anySetup({ [rowKey(NoticeMappingKey(REAL_ID))]: 901 });
+    const body = await handler.buildChatWootMessage(viewOnceImage());
+    expect(body.attachments).toHaveLength(1);
+    expect(body.content_attributes.waha_media.view_once).toBe(true);
+    expect(body.content_attributes.waha_view_once_resolved).toEqual({
+      id: REAL_ID,
+      notice_message_id: 901,
+    });
+  });
+
+  it('view once WITHOUT a downloaded media (download failed) also resolves the notice', async () => {
+    const { handler } = anySetup({ [rowKey(NoticeMappingKey(REAL_ID))]: 901 });
+    const payload = {
+      ...viewOnceImage(),
+      media: { url: null, mimetype: 'image/jpeg', filename: null, error: { name: 'Error' } },
+    };
+    const body = await handler.buildChatWootMessage(payload);
+    expect(body.content_attributes).not.toHaveProperty('waha_media');
+    expect(body.content_attributes.waha_view_once_resolved).toEqual({
+      id: REAL_ID,
+      notice_message_id: 901,
+    });
+  });
+
+  it('GOWS form (unwrapped message + IsViewOnce flag, no media) resolves the notice', async () => {
+    const { handler } = anySetup({ [rowKey(NoticeMappingKey(REAL_ID))]: 901 });
+    const payload = {
+      ...viewOnceImage(false),
+      hasMedia: false,
+      media: null,
+      _data: {
+        Info: { Chat: CUSTOMER },
+        IsViewOnceV2: true,
+        Message: { imageMessage: { mimetype: 'image/jpeg' } },
+      },
+    };
+    const body = await handler.buildChatWootMessage(payload);
+    expect(body.content_attributes.waha_view_once_resolved).toEqual({
+      id: REAL_ID,
+      notice_message_id: 901,
+    });
+  });
+
+  it('no notice -> no resolved key', async () => {
+    const { handler } = anySetup();
+    const body = await handler.buildChatWootMessage(viewOnceImage());
+    expect(body.content_attributes.waha_media.view_once).toBe(true);
+    expect(body.content_attributes).not.toHaveProperty(
+      'waha_view_once_resolved',
+    );
+  });
+
+  it('not view once -> no lookup, no resolved key', async () => {
+    const { handler } = anySetup({ [rowKey(NoticeMappingKey(REAL_ID))]: 901 });
+    const body = await handler.buildChatWootMessage(viewOnceImage(false));
+    expect(body.content_attributes.waha_media.view_once).toBe(false);
+    expect(body.content_attributes).not.toHaveProperty(
+      'waha_view_once_resolved',
+    );
+  });
+
+  it('lookup fails -> message goes on without it, short log only', async () => {
+    const { handler, logger } = anySetup({}, true);
+    const body = await handler.buildChatWootMessage(viewOnceImage());
+    expect(body.attachments).toHaveLength(1);
+    expect(body.content_attributes).not.toHaveProperty(
+      'waha_view_once_resolved',
+    );
+    expect(logger.warn).toHaveBeenCalledWith(
+      'WhatsApp => ChatWoot: view once notice not looked up (TypeError)',
+    );
+    const logs = JSON.stringify((logger.warn as jest.Mock).mock.calls);
+    expect(logs).not.toContain(CUSTOMER);
+  });
+});
diff --git a/src/apps/chatwoot/consumers/waha/view_once.unavailable.ts b/src/apps/chatwoot/consumers/waha/view_once.unavailable.ts
