+  EditTimestampSeconds,
+  MessageEdited,
+} from '@waha/apps/chatwoot/messages/to/chatwoot/MessageEdited';
+import { BuildViewOnceUnavailablePayload } from '@waha/core/engines/gows/c2y.viewonce';
+import { plainToInstance } from 'class-transformer';
