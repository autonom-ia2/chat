+  });
+
+  it('poll not mapped in Chatwoot (created on the phone): ignored, as before', async () => {
+    const { handler, conversation, mapping } = setup();
+    await handler.handle(
+      votePayload({
+        poll: { id: `true_${CUSTOMER}_3EB0PHONEPOLL`, fromMe: true },
+      }) as any,
+    );
+    expect(conversation.send).not.toHaveBeenCalled();
+    expect(mapping.map).not.toHaveBeenCalled();
+  });
+
+  it('mapped message that was not a native poll (other id): ignored', async () => {
+    const { handler, conversation, mapping } = setup();
+    // the poll message is mapped, the vote is not
+    mapping.getChatWootMessage.mockImplementation(async (key) =>
+      key.message_id === 'VOTE1'
+        ? null
+        : { conversation_id: 42, message_id: POLL_CW_ID },
+    );
+    await handler.handle(
+      votePayload({
+        poll: { id: `true_${CUSTOMER}_3EB0NOTDETERMINISTIC`, fromMe: true },
+      }) as any,
+    );
+    expect(conversation.send).not.toHaveBeenCalled();
+  });
+
+  it('poll of another session: the deterministic id does not match, ignored', async () => {
+    const other = DeterministicMessageId('other', POLL_CW_ID, 'sendPoll');
+    const { handler, conversation, mapping } = setup();
+    // the poll message is mapped, the vote is not
+    mapping.getChatWootMessage.mockImplementation(async (key) =>
+      key.message_id === 'VOTE1'
+        ? null
+        : { conversation_id: 42, message_id: POLL_CW_ID },
+    );
+    await handler.handle(
+      votePayload({ poll: { id: `true_${CUSTOMER}_${other}` } }) as any,
+    );
+    expect(conversation.send).not.toHaveBeenCalled();
+  });
+
+  it('vote by the business phone (fromMe): ignored', async () => {
+    const { handler, conversation } = setup();
+    await handler.handle(votePayload({}, { fromMe: true }) as any);
+    expect(conversation.send).not.toHaveBeenCalled();
+  });
+
+  it('vote already mapped (retry): not created twice', async () => {
+    const { handler, conversation, mapping } = setup();
+    mapping.getChatWootMessage.mockImplementation(async (key) =>
+      key.message_id === OUR_POLL_ID
+        ? { conversation_id: 42, message_id: POLL_CW_ID }
