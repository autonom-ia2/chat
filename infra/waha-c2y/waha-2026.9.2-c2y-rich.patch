diff --git a/src/apps/chatwoot/api/c2y.signature.test.ts b/src/apps/chatwoot/api/c2y.signature.test.ts
new file mode 100644
index 00000000..5df09544
--- /dev/null
+++ b/src/apps/chatwoot/api/c2y.signature.test.ts
@@ -0,0 +1,196 @@
+import { createHmac } from 'crypto';
+import {
+  C2Y_SIGNATURE_MAX_AGE_SECONDS,
+  C2ySignatureVerifier,
+  IsValidC2ySignature,
+} from '@waha/apps/chatwoot/api/c2y.signature';
+import { keepChatwootWebhookRawBody } from '@waha/apps/chatwoot/api/rawbody';
+
+const SECRET = 's3cr3t-inbox';
+const TS = '1760620000';
+const NOW = 1760620000;
+// Rails JSON (escapes < > as < >, keeps UTF-8): the raw bytes
+// are signed, never a re-serialization
+const RAW = Buffer.from(
+  '{"event":"c2y_message_reaction","c2y_reaction":{"emoji":"👍"},' +
+    '"content":"\\u003cb\\u003eé\\u003c/b\\u003e"}',
+  'utf8',
+);
+// OpenSSL::HMAC.hexdigest('SHA256', SECRET, "#{TS}.#{RAW}") in Ruby, as
+// lib/webhooks/trigger.rb of chat2you signs it
+const RUBY_SIGNATURE =
+  'sha256=290ed9040047d15ce24e931103f1d309a0ecc8b41686d3dac821229145f91d89';
+
+function sign(secret: string, ts: string, raw: Buffer): string {
+  return (
+    'sha256=' +
+    createHmac('sha256', secret)
+      .update(`${ts}.`)
+      .update(raw)
+      .digest('hex')
+  );
+}
+
+function input(extra: any = {}) {
+  return {
+    secret: SECRET,
+    rawBody: RAW,
+    timestamp: TS,
+    signature: RUBY_SIGNATURE,
+    nowSeconds: NOW,
+    ...extra,
+  };
+}
+
+describe('IsValidC2ySignature (c2y-rich-2, review)', () => {
+  it('accepts the signature made by chat2you (Ruby vector)', () => {
+    expect(IsValidC2ySignature(input())).toBe(true);
+  });
+
+  it('accepts within the clock window, both ways', () => {
+    const max = C2Y_SIGNATURE_MAX_AGE_SECONDS;
+    expect(IsValidC2ySignature(input({ nowSeconds: NOW + max }))).toBe(true);
+    expect(IsValidC2ySignature(input({ nowSeconds: NOW - max }))).toBe(true);
+  });
+
+  it.each([
+    ['wrong secret', { secret: 'other' }],
+    ['no secret', { secret: null }],
+    ['empty secret', { secret: '' }],
+    ['tampered body', { rawBody: Buffer.from(RAW.toString() + ' ') }],
+    ['no raw body', { rawBody: undefined }],
+    ['too old', { nowSeconds: NOW + C2Y_SIGNATURE_MAX_AGE_SECONDS + 1 }],
+    [
+      'from the future',
+      { nowSeconds: NOW - C2Y_SIGNATURE_MAX_AGE_SECONDS - 1 },
+    ],
+    ['other timestamp signed', { timestamp: String(NOW + 1) }],
+    ['timestamp not an integer', { timestamp: `${TS}.0` }],
+    ['timestamp with spaces', { timestamp: ` ${TS}` }],
+    ['no timestamp', { timestamp: undefined }],
+    ['no signature', { signature: undefined }],
+    ['without the sha256= prefix', { signature: RUBY_SIGNATURE.slice(7) }],
+    ['truncated signature', { signature: RUBY_SIGNATURE.slice(0, -2) }],
+    [
+      'uppercase hex',
+      { signature: 'sha256=' + RUBY_SIGNATURE.slice(7).toUpperCase() },
+    ],
+    ['header given twice (array)', { signature: [RUBY_SIGNATURE] }],
+  ])('refuses: %s', (_name, extra) => {
+    expect(IsValidC2ySignature(input(extra))).toBe(false);
+  });
+});
+
+describe('C2ySignatureVerifier (c2y-rich-2, review)', () => {
+  const config = {
+    url: 'https://chat.example',
+    accountId: 1,
+    accountToken: 'token',
+    inboxId: 7,
+  };
+
+  function headers(secret = SECRET, ts = TS) {
+    return {
+      'x-chatwoot-timestamp': ts,
+      'x-chatwoot-signature': sign(secret, ts, RAW),
+    };
+  }
+
+  function setup(secrets: Array<string | null | Error>) {
+    let now = NOW * 1000;
+    const loader = jest.fn(async () => {
+      const next = secrets.length > 1 ? secrets.shift() : secrets[0];
+      if (next instanceof Error) {
+        throw next;
+      }
+      return next;
+    });
+    const verifier = new C2ySignatureVerifier(loader, () => now);
+    const advance = (ms: number) => (now += ms);
+    return { verifier, loader, advance };
+  }
+
+  it('ok, and the secret is cached per app', async () => {
+    const { verifier, loader } = setup([SECRET]);
+    expect(await verifier.verify('app_1', config, RAW, headers())).toBe('ok');
+    expect(await verifier.verify('app_1', config, RAW, headers())).toBe('ok');
+    expect(loader).toHaveBeenCalledTimes(1);
+    expect(loader).toHaveBeenCalledWith(config);
+  });
+
+  it('invalid signature: invalid, and Chatwoot is not hammered', async () => {
+    const { verifier, loader } = setup([SECRET]);
+    await verifier.verify('app_1', config, RAW, headers());
+    for (let i = 0; i < 5; i++) {
+      expect(
+        await verifier.verify('app_1', config, RAW, headers('forged')),
+      ).toBe('invalid');
+    }
+    // Inside the 30 s window: no reload
+    expect(loader).toHaveBeenCalledTimes(1);
+  });
+
+  it('rotated secret: reloads once after the window and accepts', async () => {
+    const { verifier, loader, advance } = setup([SECRET, 'rotated']);
+    await verifier.verify('app_1', config, RAW, headers());
+    advance(31 * 1000);
+    expect(
+      await verifier.verify(
+        'app_1',
+        config,
+        RAW,
+        headers('rotated', String(NOW + 31)),
+      ),
+    ).toBe('ok');
+    expect(loader).toHaveBeenCalledTimes(2);
+  });
+
+  it('secret not readable (non-admin token): no-secret', async () => {
+    const { verifier } = setup([null]);
+    expect(await verifier.verify('app_1', config, RAW, headers())).toBe(
+      'no-secret',
+    );
+  });
+
+  it('Chatwoot unreachable: no-secret (fail closed)', async () => {
+    const { verifier } = setup([new Error('ECONNREFUSED token=abc')]);
+    expect(await verifier.verify('app_1', config, RAW, headers())).toBe(
+      'no-secret',
+    );
+  });
+
+  it('the secret is read again after the TTL', async () => {
+    const { verifier, loader, advance } = setup([SECRET]);
+    await verifier.verify('app_1', config, RAW, headers());
+    advance(5 * 60 * 1000);
+    const ts = String(NOW + 300);
+    expect(
+      await verifier.verify('app_1', config, RAW, headers(SECRET, ts)),
+    ).toBe('ok');
+    expect(loader).toHaveBeenCalledTimes(2);
+  });
+
+  it('apps do not share secrets', async () => {
+    const { verifier, loader } = setup([SECRET, 'second-app']);
+    await verifier.verify('app_1', config, RAW, headers());
+    expect(await verifier.verify('app_2', config, RAW, headers())).toBe(
+      'invalid',
+    );
+    expect(loader).toHaveBeenCalledTimes(2);
+  });
+});
+
+describe('keepChatwootWebhookRawBody', () => {
+  it('keeps the raw body only for the Chatwoot webhook routes', () => {
+    const buf = Buffer.from('{}');
+    const webhook: any = { originalUrl: '/webhooks/chatwoot/hub2you/app_1' };
+    const other: any = { originalUrl: '/api/sendText' };
+    const lookalike: any = { originalUrl: '/api/webhooks/chatwoot/x' };
+    keepChatwootWebhookRawBody(webhook, null, buf);
+    keepChatwootWebhookRawBody(other, null, buf);
+    keepChatwootWebhookRawBody(lookalike, null, buf);
+    expect(webhook.rawBody).toBe(buf);
+    expect(other.rawBody).toBeUndefined();
+    expect(lookalike.rawBody).toBeUndefined();
+  });
+});
diff --git a/src/apps/chatwoot/api/c2y.signature.ts b/src/apps/chatwoot/api/c2y.signature.ts
new file mode 100644
index 00000000..395c54ca
--- /dev/null
+++ b/src/apps/chatwoot/api/c2y.signature.ts
@@ -0,0 +1,160 @@
+import ChatwootClient from '@figuro/chatwoot-sdk';
+import { createHmac, timingSafeEqual } from 'crypto';
+
+/**
+ * Autonom.ia patch c2y-rich-2 (autonom-ia2/chat#1709)
+ * The c2y_message_reaction / c2y_message_edit events change messages that
+ * were already delivered, so they are accepted only with the signature
+ * chat2you puts on the inbox webhook (Webhooks::Trigger):
+ *
+ *   X-Chatwoot-Timestamp: <unix seconds>
+ *   X-Chatwoot-Signature: sha256=<hex HMAC-SHA256(inbox secret, "<ts>.<raw body>")>
+ *
+ * The secret is the API inbox `secret`, read with the app token (Chatwoot
+ * shows it to administrators). Only the c2y_* events are checked; every
+ * other event keeps the behaviour it had before the patch.
+ * Nothing here logs the secret, the signature or the body.
+ */
+export const C2Y_SIGNATURE_HEADER = 'x-chatwoot-signature';
+export const C2Y_TIMESTAMP_HEADER = 'x-chatwoot-timestamp';
+/** Accepted clock difference between chat2you and WAHA, both ways */
+export const C2Y_SIGNATURE_MAX_AGE_SECONDS = 300;
+const SIGNATURE_PREFIX = 'sha256=';
+/** The secret is read again after this time (rotation in Chatwoot) */
+const SECRET_TTL_MS = 5 * 60 * 1000;
+/** A failed check reloads the secret at most once in this window */
+const SECRET_MIN_RELOAD_MS = 30 * 1000;
+
+export interface C2ySignatureInput {
+  secret: string | null | undefined;
+  rawBody: Buffer | null | undefined;
+  timestamp: unknown;
+  signature: unknown;
+  nowSeconds: number;
+}
+
+export function IsValidC2ySignature(input: C2ySignatureInput): boolean {
+  const { secret, rawBody, timestamp, signature, nowSeconds } = input;
+  if (typeof secret !== 'string' || secret.length === 0) {
+    return false;
+  }
+  if (!Buffer.isBuffer(rawBody)) {
+    return false;
+  }
+  if (typeof timestamp !== 'string' || typeof signature !== 'string') {
+    return false;
+  }
+  const ts = Number(timestamp);
+  if (!Number.isInteger(ts) || String(ts) !== timestamp) {
+    return false;
+  }
+  if (Math.abs(nowSeconds - ts) > C2Y_SIGNATURE_MAX_AGE_SECONDS) {
+    return false;
+  }
+  if (!signature.startsWith(SIGNATURE_PREFIX)) {
+    return false;
+  }
+  const expected = createHmac('sha256', secret)
+    .update(`${timestamp}.`)
+    .update(rawBody)
+    .digest('hex');
+  const given = Buffer.from(signature.slice(SIGNATURE_PREFIX.length), 'utf8');
+  const wanted = Buffer.from(expected, 'utf8');
+  return given.length === wanted.length && timingSafeEqual(given, wanted);
+}
+
+export interface C2yAppConfig {
+  url: string;
+  accountId: number;
+  accountToken: string;
+  inboxId: number;
+}
+
+export type InboxSecretLoader = (
+  config: C2yAppConfig,
+) => Promise<string | null>;
+
+/** GET /api/v1/accounts/:account/inboxes/:inbox -> secret (admin token) */
+export const ChatwootInboxSecret: InboxSecretLoader = async (config) => {
+  const client = new ChatwootClient({
+    config: {
+      basePath: config.url,
+      with_credentials: true,
+      credentials: 'include',
+      token: config.accountToken,
+    },
+  });
+  const inbox: any = await client.inboxes.get({
+    accountId: config.accountId,
+    id: config.inboxId,
+  });
+  const secret = inbox?.secret;
+  return typeof secret === 'string' && secret.length > 0 ? secret : null;
+};
+
+interface SecretEntry {
+  secret: string | null;
+  loadedAt: number;
+}
+
+export type C2yVerdict = 'ok' | 'invalid' | 'no-secret';
+
+export class C2ySignatureVerifier {
+  private secrets = new Map<string, SecretEntry>();
+
+  constructor(
+    private readonly loader: InboxSecretLoader = ChatwootInboxSecret,
+    private readonly nowMs: () => number = () => Date.now(),
+  ) {}
+
+  async verify(
+    appId: string,
+    config: C2yAppConfig,
+    rawBody: Buffer | null | undefined,
+    headers: Record<string, unknown>,
+  ): Promise<C2yVerdict> {
+    const check = (secret: string | null) =>
+      IsValidC2ySignature({
+        secret: secret,
+        rawBody: rawBody,
+        timestamp: headers?.[C2Y_TIMESTAMP_HEADER],
+        signature: headers?.[C2Y_SIGNATURE_HEADER],
+        nowSeconds: Math.floor(this.nowMs() / 1000),
+      });
+
+    let entry = await this.secret(appId, config, false);
+    if (check(entry.secret)) {
+      return 'ok';
+    }
+    // The secret may have been rotated in Chatwoot: read it again, rarely
+    if (this.nowMs() - entry.loadedAt >= SECRET_MIN_RELOAD_MS) {
+      entry = await this.secret(appId, config, true);
+      if (check(entry.secret)) {
+        return 'ok';
+      }
+    }
+    return entry.secret ? 'invalid' : 'no-secret';
+  }
+
+  private async secret(
+    appId: string,
+    config: C2yAppConfig,
+    reload: boolean,
+  ): Promise<SecretEntry> {
+    const now = this.nowMs();
+    const cached = this.secrets.get(appId);
+    if (!reload && cached && now - cached.loadedAt < SECRET_TTL_MS) {
+      return cached;
+    }
+    let secret: string | null = null;
+    try {
+      secret = await this.loader(config);
+    } catch (err) {
+      // Fail closed. The error is not kept: it may carry the request
+      secret = null;
+    }
+    const entry = { secret: secret, loadedAt: now };
+    this.secrets.set(appId, entry);
+    return entry;
+  }
+}
