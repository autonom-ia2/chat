+});
+
+describe('MessageHandler - media as media (c2y-rich-2, item 2)', () => {
+  const asMedia = { waha_media_as_media: true };
+
+  it.each([
+    ['foto.webp'],
+    ['foto.bmp'],
+    ['foto.tiff'],
+    ['foto.avif'],
+    ['foto.heic'],
+  ])('%s with the flag: converted to JPEG and sent as image', async (name) => {
+    const { handler, session, media } = setup();
+    await handler.handle(
+      chatwootMessage({
+        content: 'veja',
+        content_attributes: asMedia,
+        attachments: [attachment(name, 'image')],
+      }),
+    );
+    expect(media.fetch).toHaveBeenCalledWith(
+      expect.stringContaining(`/${name}`),
+    );
+    expect(session.sendFile).not.toHaveBeenCalled();
+    const request = session.sendImage.mock.calls[0][0];
+    expect(request.file).toEqual({
+      data: Buffer.from('jpeg-bytes').toString('base64'),
+      mimetype: 'image/jpeg',
+      filename: 'foto.jpg',
+    });
+    expect(request.caption).toBe('veja');
+    expect(request.chatId).toBe(CHAT_ID);
+  });
+
+  it('webp WITHOUT the flag: sent as a file, exactly as before', async () => {
+    const { handler, session, media } = setup();
+    await handler.handle(
+      chatwootMessage({ attachments: [attachment('foto.webp', 'image')] }),
+    );
+    expect(media.fetch).not.toHaveBeenCalled();
+    expect(session.sendImage).not.toHaveBeenCalled();
+    expect(session.sendFile).toHaveBeenCalledTimes(1);
+    expect(session.sendFile.mock.calls[0][0].file).toMatchObject({
+      filename: 'foto.webp',
+      mimetype: 'image/webp',
+    });
+  });
