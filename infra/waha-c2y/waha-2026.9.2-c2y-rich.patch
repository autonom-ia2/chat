+++ b/src/apps/chatwoot/messages/to/whatsapp/actions.ts
@@ -0,0 +1,47 @@
+/**
+ * Autonom.ia patch c2y-rich-2 (autonom-ia2/chat#1709)
+ * Custom events chat2you posts to the inbox webhook when an agent reacts to
+ * or edits a message in the panel. A connector without the patch ignores
+ * them (unknown event).
+ *
+ *   {event:'c2y_message_reaction', ...message.webhook_data, c2y_reaction:{emoji}}
+ *   {event:'c2y_message_edit', ...message.webhook_data, c2y_edit:{waha_text}}
+ */
+export enum C2yActionEvent {
+  REACTION = 'c2y_message_reaction',
+  EDIT = 'c2y_message_edit',
+}
+
+/** A reaction is one emoji; this only bounds the size of the field */
+const MAX_REACTION_LENGTH = 32;
+
+/** WhatsApp text limit */
+const MAX_EDIT_TEXT_LENGTH = 65536;
+
+export function IsC2yActionEvent(event: unknown): boolean {
+  return event === C2yActionEvent.REACTION || event === C2yActionEvent.EDIT;
+}
+
+/** {emoji} - '' removes the reaction. null when the payload is invalid. */
+export function ParseC2yReaction(body: any): { emoji: string } | null {
+  const emoji = body?.c2y_reaction?.emoji;
+  if (typeof emoji !== 'string') {
+    return null;
+  }
+  if (emoji.length > MAX_REACTION_LENGTH) {
+    return null;
+  }
+  return { emoji: emoji };
+}
+
+/** {text} already in WhatsApp format. null when the payload is invalid. */
+export function ParseC2yEdit(body: any): { text: string } | null {
+  const text = body?.c2y_edit?.waha_text;
+  if (typeof text !== 'string') {
+    return null;
+  }
+  if (text.trim().length === 0 || text.length > MAX_EDIT_TEXT_LENGTH) {
+    return null;
+  }
+  return { text: text };
+}
diff --git a/src/apps/chatwoot/messages/to/whatsapp/c2y2.helpers.test.ts b/src/apps/chatwoot/messages/to/whatsapp/c2y2.helpers.test.ts
