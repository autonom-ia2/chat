@@ -0,0 +1,154 @@
+import { Processor } from '@nestjs/bullmq';
+import { JOB_CONCURRENCY } from '@waha/apps/app_sdk/constants';
+import { WAHASessionAPI } from '@waha/apps/app_sdk/waha/WAHASelf';
+import { QueueName } from '@waha/apps/chatwoot/consumers/QueueName';
+import { EventData } from '@waha/apps/chatwoot/consumers/types';
+import {
+  ChatWootMessagePartial,
+  ChatWootWAHABaseConsumer,
+  IMessageInfo,
+  MessageBaseHandler,
+} from '@waha/apps/chatwoot/consumers/waha/base';
+import { ChatWootConfig } from '@waha/apps/chatwoot/dto/config.dto';
+import {
+  NoticeWhatsAppId,
+  RealMappingKey,
+  VIEW_ONCE_NOTICE_KEY,
+  WahaViewOnceUnavailable,
+} from '@waha/apps/chatwoot/messages/to/chatwoot/ViewOnceNotice';
+import { EngineHelper } from '@waha/apps/chatwoot/waha';
+import { SessionManager } from '@waha/core/abc/manager.abc';
+import { ViewOnceUnavailablePayload } from '@waha/core/engines/gows/c2y.viewonce';
+import { RMutexService } from '@waha/modules/rmutex/rmutex.service';
+import { WAHAEvents } from '@waha/structures/enums.dto';
+import { Job } from 'bullmq';
+import { PinoLogger } from 'nestjs-pino';
+
+/**
+ * Autonom.ia patch c2y-rich-4 (autonom-ia2/chat#1709)
+ * View once message from a contact whose media never reaches a linked device
+ * -> incoming message (from the customer) with the WhatsApp Web notice and
+ * content_attributes.waha_view_once_unavailable.
+ */
+export type ViewOnceNoticePayload = Omit<
+  ViewOnceUnavailablePayload,
+  'timestamp'
+> & {
+  timestamp: number;
+  // real serialized WhatsApp id of the view once message
+  c2y_wa_id: string;
+};
+
+export function BuildNoticePayload(
+  payload: ViewOnceUnavailablePayload,
+): ViewOnceNoticePayload {
+  return {
+    ...payload,
+    // the mapping needs a date; the engine always sends one in practice
+    timestamp: payload.timestamp ?? Math.floor(Date.now() / 1000),
+    id: NoticeWhatsAppId(payload.id),
+    c2y_wa_id: payload.id,
+  };
+}
+
+/**
+ * c2y-rich-5: app config `c2yViewOnceNotice`, off unless exactly true
+ */
+export function ViewOnceNoticeEnabled(
+  config: Pick<ChatWootConfig, 'c2yViewOnceNotice'> | null | undefined,
+): boolean {
+  return config?.c2yViewOnceNotice === true;
+}
+
+@Processor(QueueName.WAHA_C2Y_VIEW_ONCE_UNAVAILABLE, {
+  concurrency: JOB_CONCURRENCY,
+})
+export class WAHAViewOnceUnavailableConsumer extends ChatWootWAHABaseConsumer {
+  constructor(
+    protected readonly manager: SessionManager,
+    log: PinoLogger,
+    rmutex: RMutexService,
+  ) {
+    super(manager, log, rmutex, 'WAHAViewOnceUnavailableConsumer');
+  }
+
+  // Same chat key as message.any, so the notice and a later real message
+  // never run at the same time
+  GetChatId(event: any): string {
+    return EngineHelper.ChatID(event.payload);
+  }
+
+  async Process(
+    job: Job<EventData, any, WAHAEvents>,
+    info: IMessageInfo,
+  ): Promise<any> {
+    const container = await this.DIContainer(job, job.data.app);
+    // c2y-rich-5: only the inboxes that asked for it. Off = the base WAHA:
+    // the engine logs it and nothing reaches Chatwoot (no contact, no
+    // conversation, no message). Read from the saved app config on every
+    // job, so turning it on or off needs no session restart.
+    if (!ViewOnceNoticeEnabled(container.ChatWootConfig())) {
+      container.Logger().debug('View once notice is off for this inbox');
+      return null;
+    }
+    const event: any = job.data.event;
+    const handler = new ViewOnceNoticeHandler(
+      job,
+      container.MessageMappingService(),
+      container.ContactConversationService(),
+      container.Logger(),
+      info,
+      new WAHASessionAPI(event.session, container.WAHASelf()),
+      container.Locale(),
+      container.WAHASelf(),
+      container.OutgoingMode(),
+    );
+    return await handler.handle(BuildNoticePayload(event.payload));
+  }
+}
+
+export class ViewOnceNoticeHandler extends MessageBaseHandler<ViewOnceNoticePayload> {
+  protected get shouldAddFromTag() {
+    return false;
+  }
+
+  protected c2yQuoteEnabled(payload: ViewOnceNoticePayload): boolean {
+    void payload;
+    return false;
+  }
+
+  /**
+   * One notice per message: skip when the notice is already mapped (whatsmeow
+   * may emit again after the resend request) or when the real message is
+   * already in Chatwoot (the content came first).
+   */
+  async ShouldProcessMessage(payload: ViewOnceNoticePayload): Promise<boolean> {
+    if (!(await super.ShouldProcessMessage(payload))) {
+      return false;
+    }
+    const real = await this.mappingService.getChatWootMessage(
+      RealMappingKey(payload.c2y_wa_id),
+    );
+    return !real;
+  }
+
+  protected async getMessage(
+    payload: ViewOnceNoticePayload,
+  ): Promise<ChatWootMessagePartial> {
+    const notice: WahaViewOnceUnavailable = {
+      from_me: false,
+      id: payload.c2y_wa_id,
+    };
+    return {
+      content: this.l.r(VIEW_ONCE_NOTICE_KEY),
+      attachments: [],
+      private: false,
+      content_attributes: { waha_view_once_unavailable: notice },
+    };
+  }
+
+  getReplyToWhatsAppID(payload: ViewOnceNoticePayload): string | undefined {
+    void payload;
+    return undefined;
+  }
+}
