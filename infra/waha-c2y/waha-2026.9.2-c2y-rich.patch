+
+  it('WAHA error propagates (the reporter posts the error note)', async () => {
+    const { session, mapping, logger } = setup();
+    session.editMessage.mockRejectedValue(new Error('500'));
+    const handler = new C2yEditHandler(mapping, logger, session, config);
+    await expect(
+      handler.handle(body({ c2y_edit: { waha_text: 'novo' } })),
+    ).rejects.toThrow('500');
