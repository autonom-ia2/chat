+import { JestLogger } from '@waha/apps/app_sdk/jest/JestLogger';
+import { ExtractListReply } from '@waha/apps/chatwoot/messages/to/chatwoot/ListReply';
+
+/**
+ * Baileys is ESM-only and is not loaded under jest.
+ * Same unwrapping as Baileys normalizeMessageContent (ephemeral, view once),
+ * used only to exercise ExtractListReply. The real Baileys function is
+ * checked against the built dist separately (see README of the patch).
+ */
+function unwrap(message: any): any {
+  let content = message;
+  for (let i = 0; i < 5; i++) {
+    const inner =
+      content?.ephemeralMessage ||
+      content?.viewOnceMessage ||
+      content?.viewOnceMessageV2 ||
+      content?.viewOnceMessageV2Extension ||
+      content?.documentWithCaptionMessage;
+    if (!inner) {
+      break;
+    }
+    content = inner.message;
+  }
+  return content;
+}
+
+const NOWEB_REPLY = {
+  listResponseMessage: {
+    title: 'Básico',
+    listType: 1,
+    singleSelectReply: { selectedRowId: 'auto_basico' },
+  },
+};
+
+describe('ExtractListReply', () => {
+  it('NOWEB: plain list reply', () => {
+    const data = { message: NOWEB_REPLY };
+    expect(ExtractListReply(data, undefined, unwrap)).toEqual({
+      row_id: 'auto_basico',
+      title: 'Básico',
+    });
+  });
+
+  it('NOWEB: ephemeral (disappearing messages)', () => {
+    const data = { message: { ephemeralMessage: { message: NOWEB_REPLY } } };
+    expect(ExtractListReply(data, undefined, unwrap)).toEqual({
+      row_id: 'auto_basico',
+      title: 'Básico',
+    });
+  });
+
+  it('NOWEB: view once', () => {
+    const data = {
+      message: { viewOnceMessageV2: { message: NOWEB_REPLY } },
+    };
+    expect(ExtractListReply(data, undefined, unwrap)?.row_id).toBe('auto_basico');
+  });
+
+  it('GOWS: Go field names are camel cased before reading', () => {
+    const data = {
+      Message: {
+        EphemeralMessage: {
+          Message: {
+            ListResponseMessage: {
+              Title: 'Básico',
+              ListType: 1,
+              SingleSelectReply: { SelectedRowID: 'auto_basico' },
+            },
+          },
+        },
+      },
+    };
+    expect(ExtractListReply(data, undefined, unwrap)).toEqual({
+      row_id: 'auto_basico',
+      title: 'Básico',
+    });
+  });
+
+  it('title missing becomes null', () => {
+    const data = {
+      message: {
+        listResponseMessage: { singleSelectReply: { selectedRowId: 'x' } },
+      },
+    };
+    expect(ExtractListReply(data, undefined, unwrap)).toEqual({
+      row_id: 'x',
+      title: null,
+    });
+  });
+
+  it.each([
+    [undefined],
+    [null],
+    [{}],
+    [{ message: { conversation: 'oi' } }],
+    [{ message: { listResponseMessage: { title: 'sem row' } } }],
+    [{ Message: { Conversation: 'oi' } }],
+  ])('no list reply in %j', (data) => {
+    expect(ExtractListReply(data, undefined, unwrap)).toBeNull();
+  });
+});
+
+describe('ExtractListReply never breaks the incoming message', () => {
+  const PHONE = '5511988887777';
+  const data = {
+    message: {
+      ephemeralMessage: { message: NOWEB_REPLY },
+      extendedTextMessage: { text: `meu telefone ${PHONE}` },
+    },
+  };
+
+  function logged(logger: any): string {
+    return ['fatal', 'error', 'warn', 'info', 'debug', 'trace']
+      .flatMap((level) => logger[level].mock.calls)
+      .map((args) => args.join(' '))
+      .join('\n');
+  }
+
+  it('extractor throws: returns null and logs only the error class', () => {
+    const logger = JestLogger();
+    const boom = () => {
+      throw new TypeError(`unexpected shape near ${PHONE} Básico`);
+    };
+    expect(ExtractListReply(data, logger, boom)).toBeNull();
+    expect(logger.warn).toHaveBeenCalledTimes(1);
+    const text = logged(logger);
+    expect(text).toContain('TypeError');
+    expect(text).not.toContain(PHONE);
+    expect(text).not.toContain('Básico');
+    expect(text).not.toContain('auto_basico');
+  });
+
+  it('Baileys not loaded (esm.b null): returns null instead of throwing', () => {
+    const logger = JestLogger();
+    // default extractor uses esm.b, which is never loaded under jest
+    expect(ExtractListReply(data, logger)).toBeNull();
+    expect(logger.warn).toHaveBeenCalledTimes(1);
+    expect(logged(logger)).not.toContain(PHONE);
+  });
+
+  it('malformed engine data (throwing getter): returns null', () => {
+    const logger = JestLogger();
+    const bad = {
+      get message() {
+        throw new Error(PHONE);
+      },
+    };
+    expect(ExtractListReply(bad, logger, unwrap)).toBeNull();
+    expect(logged(logger)).not.toContain(PHONE);
+  });
+
+  it('works without a logger', () => {
+    const boom = () => {
+      throw new Error('x');
+    };
+    expect(ExtractListReply(data, undefined, boom)).toBeNull();
+  });
+});
diff --git a/src/apps/chatwoot/messages/to/chatwoot/ListReply.ts b/src/apps/chatwoot/messages/to/chatwoot/ListReply.ts
