@@ -0,0 +1,47 @@
+import type { proto } from '@adiwajshing/baileys';
+import { ILogger } from '@waha/apps/app_sdk/ILogger';
+import esm from '@waha/vendor/esm';
+
+/**
+ * Autonom.ia patch c2y-rich-2 (autonom-ia2/chat#1709)
+ * Message type the connector does not convert -> content_attributes.waha_unknown
+ */
+export interface WahaUnknown {
+  content_type: string | null;
+  from_me: boolean;
+}
+
+export type ContentTypeOf = (
+  message: proto.IMessage | null | undefined,
+) => string | null | undefined;
+
+function baileysContentType(
+  message: proto.IMessage | null | undefined,
+): string | null | undefined {
+  return esm.b.getContentType(esm.b.normalizeMessageContent(message));
+}
+
+/**
+ * Proto content type (e.g. "stickerPackMessage"), or null.
+ * It never throws: the unsupported note must reach Chatwoot anyway.
+ * Only the error class is logged - no content, no phone.
+ */
+export function UnknownContentType(
+  protoMessage: proto.IMessage | null | undefined,
+  logger?: ILogger,
+  contentTypeOf: ContentTypeOf = baileysContentType,
+): string | null {
+  if (!protoMessage) {
+    return null;
+  }
+  try {
+    const type = contentTypeOf(protoMessage);
+    return typeof type === 'string' && type ? type : null;
+  } catch (err) {
+    const kind = err?.name || err?.constructor?.name || typeof err;
+    logger?.warn(
+      `WhatsApp => ChatWoot: unsupported message type not read (${kind})`,
+    );
+    return null;
+  }
+}
