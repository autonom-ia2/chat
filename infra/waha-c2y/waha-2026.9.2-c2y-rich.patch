+import { WAHAEvents } from '@waha/structures/enums.dto';
+import { DeterministicMessageId } from '@waha/apps/chatwoot/messages/to/whatsapp/native';
+
+const SESSION = 'hub2you';
+const CUSTOMER = '5511999999999@c.us';
+const POLL_CW_ID = 900;
+const OUR_POLL_ID = DeterministicMessageId(SESSION, POLL_CW_ID, 'sendPoll');
+
+function votePayload(extra: any = {}, vote: any = {}) {
+  return {
+    poll: {
+      id: `true_${CUSTOMER}_${OUR_POLL_ID}`,
+      to: CUSTOMER,
+      from: 'me@c.us',
+      fromMe: true,
+    },
+    vote: {
+      id: `false_${CUSTOMER}_VOTE1`,
+      from: CUSTOMER,
+      to: CUSTOMER,
+      fromMe: false,
+      selectedOptions: ['Sim'],
+      timestamp: 1760620000000,
+      ...vote,
+    },
+    _data: { Info: { Chat: CUSTOMER, PushName: 'Maria' } },
+    ...extra,
+  };
+}
+
+function setup(locale = 'en-US') {
+  const pollRow = {
+    id: 1,
+    conversation_id: 42,
+    message_id: POLL_CW_ID,
+    timestamp: new Date(0),
+  };
+  const mapping: any = {
+    getChatWootMessage: jest.fn(async (key) =>
+      key.message_id === OUR_POLL_ID ? pollRow : null,
+    ),
+    map: jest.fn().mockResolvedValue(undefined),
+  };
+  const conversation: any = {
+    send: jest.fn().mockResolvedValue({
+      id: 1001,
+      conversation_id: 42,
+      created_at: 1760620001,
+    }),
+  };
+  const repo: any = {
+    ConversationById: jest.fn().mockReturnValue(conversation),
+  };
+  const info: any = {
+    onConversationId: jest.fn(),
+    onMessageType: jest.fn(),
+  };
+  const logger = JestLogger();
+  const handler = new PollVoteHandler(
+    mapping,
+    repo,
+    logger,
+    i18n.locale(locale),
+    info,
+    SESSION,
+  );
+  return { handler, mapping, conversation, repo, info, logger };
+}
+
+function allLogs(logger: any): string {
+  return ['fatal', 'error', 'warn', 'info', 'debug', 'trace']
+    .flatMap((level) => logger[level].mock.calls)
+    .map((args) => args.map((a) => String(a)).join(' '))
+    .join('\n');
+}
+
+afterEach(() => jest.clearAllMocks());
+
+describe('PollVoteHandler (c2y-rich-2, item 1)', () => {
+  it('vote on our native poll: incoming message in the poll conversation', async () => {
+    const { handler, conversation, repo, info, mapping } = setup();
+    await handler.handle(votePayload() as any);
+
+    expect(repo.ConversationById).toHaveBeenCalledWith(42);
+    expect(info.onConversationId).toHaveBeenCalledWith(42);
+    expect(conversation.send).toHaveBeenCalledTimes(1);
+    const body = conversation.send.mock.calls[0][0];
+    expect(body).toEqual({
+      content: 'Sim',
+      message_type: 'incoming',
+      private: false,
+      content_attributes: {
+        in_reply_to: POLL_CW_ID,
+        waha_poll_vote: {
+          poll_message_id: POLL_CW_ID,
+          options: ['Sim'],
+          vote_id: `false_${CUSTOMER}_VOTE1`,
+          timestamp: 1760620000000,
+        },
+      },
+    });
+    // the vote is mapped, so a retry does not create it twice
+    expect(mapping.map).toHaveBeenCalledTimes(1);
