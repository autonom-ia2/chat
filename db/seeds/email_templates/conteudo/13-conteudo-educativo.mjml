<mjml>
  <mj-head>
    <mj-title>3 dicas simples para ganhar tempo no dia</mj-title>
  </mj-head>
  <mj-body width="600px" background-color="#eef2e3">
    <mj-section background-color="#1f2a14" padding="22px 24px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="20px" font-weight="700" color="#f4f7ec" align="left" line-height="1.2" letter-spacing="1px" padding="0">Sua marca</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#f4f7ec" padding="44px 24px 32px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" font-weight="700" color="#4d7c0f" align="left" line-height="1.3" letter-spacing="2px" padding="0 0 12px">GUIA RÁPIDO</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="34px" font-weight="800" color="#1f2a14" align="left" line-height="1.2" padding="0">3 dicas para ganhar tempo no seu dia</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" color="#4a5a3a" align="left" line-height="1.6" padding="12px 0 0">{{ nome }}, separamos ideias simples. Dá para começar hoje.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#f4f7ec" padding="0 24px 0">
      <mj-column>
        <mj-image src="/email-templates/biblioteca/13-educativo.jpg" alt="Ilustração de uma pessoa organizando tarefas na mesa" border-radius="12px" padding="0"></mj-image>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="40px 24px 28px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="22px" font-weight="700" color="#1f2a14" align="left" line-height="1.3" padding="0">Leia em 2 minutos</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 24px 28px">
      <mj-group>
        <mj-column width="17%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="36px" font-weight="800" color="#4d7c0f" align="left" line-height="1" padding="0">01</mj-text>
        </mj-column>
        <mj-column width="83%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" font-weight="700" color="#1f2a14" align="left" line-height="1.3" padding="0">Comece pelo mais importante</mj-text>
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#4a5a3a" align="left" line-height="1.6" padding="6px 0 0">Escolha uma tarefa só. Faça ela primeiro, antes de abrir mensagens.</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 24px 28px">
      <mj-group>
        <mj-column width="17%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="36px" font-weight="800" color="#4d7c0f" align="left" line-height="1" padding="0">02</mj-text>
        </mj-column>
        <mj-column width="83%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" font-weight="700" color="#1f2a14" align="left" line-height="1.3" padding="0">Junte tarefas parecidas</mj-text>
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#4a5a3a" align="left" line-height="1.6" padding="6px 0 0">Responda e-mails de uma vez. Faça ligações em sequência.</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 24px 28px">
      <mj-group>
        <mj-column width="17%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="36px" font-weight="800" color="#4d7c0f" align="left" line-height="1" padding="0">03</mj-text>
        </mj-column>
        <mj-column width="83%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" font-weight="700" color="#1f2a14" align="left" line-height="1.3" padding="0">Use lembretes</mj-text>
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#4a5a3a" align="left" line-height="1.6" padding="6px 0 0">Anote prazos num só lugar. Assim, nada fica para trás.</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#f4f7ec" padding="36px 24px 40px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="20px" font-weight="700" color="#1f2a14" align="center" line-height="1.3" padding="0">Quer mais dicas como essas?</mj-text>
        <mj-button href="https://seusite.com.br" background-color="#4d7c0f" color="#ffffff" font-family="Arial, Helvetica, sans-serif" font-size="16px" font-weight="700" line-height="20px" border-radius="8px" inner-padding="15px 32px" align="center" padding="20px 0 0">Ler o guia completo</mj-button>
      </mj-column>
    </mj-section>
    <mj-section css-class="footer-locked" background-color="#f4f4f4" padding="20px 16px"><mj-column><mj-text font-family="Arial, Helvetica, sans-serif" font-size="12px" color="#4b5563" align="center" line-height="1.6">Nome da sua empresa · Endereço da empresa<br/>Você recebeu este e-mail porque está em nossa lista de contatos.<br/><a href="{{ unsubscribe_url }}" style="color:#4b5563;text-decoration:underline;">Cancelar inscrição</a></mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
