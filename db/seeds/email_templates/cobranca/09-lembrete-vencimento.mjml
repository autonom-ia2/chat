<mjml>
  <mj-head>
    <mj-title>{{ nome }}, sua assinatura vence em breve</mj-title>
  </mj-head>
  <mj-body width="600px" background-color="#f3f4f6">
    <mj-section background-color="#1f2937" padding="22px 24px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="20px" font-weight="700" color="#ffffff" align="left" line-height="1.2" letter-spacing="1px" padding="0">Sua marca</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="44px 24px 28px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" font-weight="700" color="#92400e" align="left" line-height="1.3" letter-spacing="2px" padding="0 0 12px">LEMBRETE</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="30px" font-weight="800" color="#1f2937" align="left" line-height="1.2" padding="0">{{ nome }}, sua assinatura vence em breve</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" color="#4b5563" align="left" line-height="1.6" padding="12px 0 0">Renove agora e continue usando tudo sem parar.</mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper background-color="#ffffff" padding="0 24px">
      <mj-section background-color="#fff7e0" padding="16px 20px" border-top="4px solid #f59e0b" border-bottom="1px solid #f3e2b3">
        <mj-group>
          <mj-column width="40%" vertical-align="middle">
            <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" color="#4b5563" align="left" line-height="1.4" padding="0">Item</mj-text>
          </mj-column>
          <mj-column width="60%" vertical-align="middle">
            <mj-text font-family="Arial, Helvetica, sans-serif" font-size="17px" font-weight="700" color="#1f2937" align="right" line-height="1.4" padding="0">Nome do plano ou serviço</mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
      <mj-section background-color="#fff7e0" padding="16px 20px" border-bottom="1px solid #f3e2b3">
        <mj-group>
          <mj-column width="40%" vertical-align="middle">
            <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" color="#4b5563" align="left" line-height="1.4" padding="0">Vencimento</mj-text>
          </mj-column>
          <mj-column width="60%" vertical-align="middle">
            <mj-text font-family="Arial, Helvetica, sans-serif" font-size="17px" font-weight="700" color="#1f2937" align="right" line-height="1.4" padding="0">DD/MM/AAAA</mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
      <mj-section background-color="#fff7e0" padding="16px 20px">
        <mj-group>
          <mj-column width="40%" vertical-align="middle">
            <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" color="#4b5563" align="left" line-height="1.4" padding="0">Valor</mj-text>
          </mj-column>
          <mj-column width="60%" vertical-align="middle">
            <mj-text font-family="Arial, Helvetica, sans-serif" font-size="17px" font-weight="700" color="#1f2937" align="right" line-height="1.4" padding="0">R$ 0,00</mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>
    <mj-section background-color="#ffffff" padding="32px 24px 44px">
      <mj-column>
        <mj-button href="https://seusite.com.br" background-color="#92400e" color="#ffffff" font-family="Arial, Helvetica, sans-serif" font-size="16px" font-weight="700" line-height="20px" border-radius="8px" inner-padding="15px 32px" align="left" padding="0">Renovar agora</mj-button>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" color="#4b5563" align="left" line-height="1.6" padding="20px 0 0">Já renovou? Pode ignorar este aviso.</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" color="#4b5563" align="left" line-height="1.6" padding="4px 0 0">Dúvidas? Responda este e-mail. A gente ajuda.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="footer-locked" background-color="#f4f4f4" padding="20px 16px"><mj-column><mj-text font-family="Arial, Helvetica, sans-serif" font-size="12px" color="#4b5563" align="center" line-height="1.6">Nome da sua empresa · Endereço da empresa<br/>Você recebeu este e-mail porque está em nossa lista de contatos.<br/><a href="{{ unsubscribe_url }}" style="color:#4b5563;text-decoration:underline;">Cancelar inscrição</a></mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
