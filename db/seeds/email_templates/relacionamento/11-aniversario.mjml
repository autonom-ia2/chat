<mjml>
  <mj-head>
    <mj-title>Feliz aniversário, {{ nome }}! Tem presente</mj-title>
  </mj-head>
  <mj-body width="600px" background-color="#fff8e1">
    <mj-section background-color="#1a1a1a" padding="22px 24px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="20px" font-weight="700" color="#ffffff" align="center" line-height="1.2" letter-spacing="1px" padding="0">Sua marca</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffd23f" padding="40px 24px 0">
      <mj-group width="60%">
        <mj-column width="16.66%" padding="0 6px" inner-background-color="#1a1a1a" inner-border-radius="5px">
          <mj-spacer height="10px"></mj-spacer>
        </mj-column>
        <mj-column width="16.66%" padding="0 6px" inner-background-color="#ff6b4a" inner-border-radius="5px">
          <mj-spacer height="10px"></mj-spacer>
        </mj-column>
        <mj-column width="16.66%" padding="0 6px" inner-background-color="#ffffff" inner-border-radius="5px">
          <mj-spacer height="10px"></mj-spacer>
        </mj-column>
        <mj-column width="16.66%" padding="0 6px" inner-background-color="#2b8a6e" inner-border-radius="5px">
          <mj-spacer height="10px"></mj-spacer>
        </mj-column>
        <mj-column width="16.66%" padding="0 6px" inner-background-color="#1a1a1a" inner-border-radius="5px">
          <mj-spacer height="10px"></mj-spacer>
        </mj-column>
        <mj-column width="16.66%" padding="0 6px" inner-background-color="#ff6b4a" inner-border-radius="5px">
          <mj-spacer height="10px"></mj-spacer>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#ffd23f" padding="28px 24px 48px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="40px" font-weight="800" color="#1a1a1a" align="center" line-height="1.2" padding="0">Feliz aniversário, {{ nome }}!</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" color="#1a1a1a" align="center" line-height="1.6" padding="12px 0 0">Hoje o dia é seu. E a gente preparou um presente.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="44px 24px 40px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" font-weight="700" color="#4a4a4a" align="center" line-height="1.3" letter-spacing="2px" padding="0">SEU PRESENTE</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="36px" font-weight="800" color="#1a1a1a" align="center" line-height="1.2" padding="10px 0 0">15% de desconto</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#4a4a4a" align="center" line-height="1.6" padding="8px 0 0">Válido por 7 dias, em qualquer compra.</mj-text>
        <mj-button href="https://seusite.com.br" background-color="#1a1a1a" color="#ffd23f" font-family="Arial, Helvetica, sans-serif" font-size="16px" font-weight="700" line-height="20px" border-radius="8px" inner-padding="15px 32px" align="center" padding="28px 0 0">Pegar meu presente</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 24px 44px">
      <mj-column>
        <mj-divider border-color="#e5e5e5" border-width="1px" padding="0 0 28px"></mj-divider>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="17px" color="#1a1a1a" align="center" line-height="1.6" padding="0">Que o seu novo ano seja leve e cheio de coisas boas.</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#4a4a4a" align="center" line-height="1.6" padding="12px 0 0">Um abraço,<br/>Equipe Sua marca</mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="footer-locked" background-color="#f4f4f4" padding="20px 16px"><mj-column><mj-text font-family="Arial, Helvetica, sans-serif" font-size="12px" color="#4b5563" align="center" line-height="1.6">Nome da sua empresa · Endereço da empresa<br/>Você recebeu este e-mail porque está em nossa lista de contatos.<br/><a href="{{ unsubscribe_url }}" style="color:#4b5563;text-decoration:underline;">Cancelar inscrição</a></mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
