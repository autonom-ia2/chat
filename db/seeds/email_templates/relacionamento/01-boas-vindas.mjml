<mjml>
  <mj-head>
    <mj-title>Boas-vindas, {{ nome }}! Que bom ter você aqui</mj-title>
  </mj-head>
  <mj-body width="600px" background-color="#f3f7f6">
    <mj-section background-color="#083d3a" padding="22px 24px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="20px" font-weight="700" color="#ffffff" align="left" line-height="1.2" letter-spacing="1px" padding="0">Sua marca</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#e7f5f2" padding="44px 24px 36px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" font-weight="700" color="#0f766e" align="left" line-height="1.3" letter-spacing="2px" padding="0 0 12px">BOAS-VINDAS</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="34px" font-weight="800" color="#0b2b29" align="left" line-height="1.2" padding="0">Que bom ter você aqui, {{ nome }}!</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" color="#3d5a57" align="left" line-height="1.6" padding="12px 0 0">A partir de agora, você recebe nossas novidades em primeira mão.</mj-text>
        <mj-divider border-color="#ff7a59" border-width="4px" width="56px" align="left" padding="24px 0 0"></mj-divider>
      </mj-column>
    </mj-section>
    <mj-section background-color="#e7f5f2" padding="0 24px 0">
      <mj-column>
        <mj-image src="/email-templates/biblioteca/01-boas-vindas.jpg" alt="Pessoa sorrindo ao ler uma mensagem no celular" border-radius="12px" padding="0"></mj-image>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="40px 24px 24px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="22px" font-weight="700" color="#0b2b29" align="left" line-height="1.3" padding="0">O que acontece agora</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 24px 24px">
      <mj-group>
        <mj-column width="12%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="28px" font-weight="800" color="#0f766e" align="left" line-height="1" padding="0">1</mj-text>
        </mj-column>
        <mj-column width="88%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" font-weight="700" color="#0b2b29" align="left" line-height="1.3" padding="0">Conheça o que fazemos</mj-text>
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#3d5a57" align="left" line-height="1.6" padding="6px 0 0">Em poucos minutos, você entende como podemos ajudar.</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 24px 24px">
      <mj-group>
        <mj-column width="12%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="28px" font-weight="800" color="#0f766e" align="left" line-height="1" padding="0">2</mj-text>
        </mj-column>
        <mj-column width="88%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" font-weight="700" color="#0b2b29" align="left" line-height="1.3" padding="0">Fale com a gente</mj-text>
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#3d5a57" align="left" line-height="1.6" padding="6px 0 0">Ficou com dúvida? Responda este e-mail. Uma pessoa vai ler.</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 24px 24px">
      <mj-group>
        <mj-column width="12%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="28px" font-weight="800" color="#0f766e" align="left" line-height="1" padding="0">3</mj-text>
        </mj-column>
        <mj-column width="88%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" font-weight="700" color="#0b2b29" align="left" line-height="1.3" padding="0">Fique por dentro</mj-text>
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#3d5a57" align="left" line-height="1.6" padding="6px 0 0">Você recebe dicas e novidades. Sem exagero.</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#ffffff" padding="8px 24px 44px">
      <mj-column>
        <mj-button href="https://seusite.com.br" background-color="#0f766e" color="#ffffff" font-family="Arial, Helvetica, sans-serif" font-size="16px" font-weight="700" line-height="20px" border-radius="8px" inner-padding="15px 32px" align="left" padding="0">Conhecer agora</mj-button>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#3d5a57" align="left" line-height="1.6" padding="28px 0 0">Um abraço,<br/>Equipe Sua marca</mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="footer-locked" background-color="#f4f4f4" padding="20px 16px"><mj-column><mj-text font-family="Arial, Helvetica, sans-serif" font-size="12px" color="#4b5563" align="center" line-height="1.6">Nome da sua empresa · Endereço da empresa<br/>Você recebeu este e-mail porque está em nossa lista de contatos.<br/><a href="{{ unsubscribe_url }}" style="color:#4b5563;text-decoration:underline;">Cancelar inscrição</a></mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
