<mjml>
  <mj-head>
    <mj-title>{{ nome }}, 20% de desconto até domingo</mj-title>
  </mj-head>
  <mj-body width="600px" background-color="#fbe7f0">
    <mj-section background-color="#1f1115" padding="22px 24px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="20px" font-weight="700" color="#ffffff" align="left" line-height="1.2" letter-spacing="1px" padding="0">Sua marca</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#be185d" padding="48px 24px 56px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" font-weight="700" color="#ffffff" align="center" line-height="1.3" letter-spacing="2px" padding="0 0 12px">SÓ ATÉ DOMINGO</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="40px" font-weight="800" color="#ffffff" align="center" line-height="1.2" padding="0">20% de desconto para você</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" color="#ffe4ef" align="center" line-height="1.6" padding="12px 0 0">{{ nome }}, é um presente nosso por fazer parte da nossa lista.</mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper background-color="#ffffff" padding="32px 24px 8px">
      <mj-section background-color="#fdf2f8" padding="32px 24px" border="2px dashed #be185d" border-radius="12px">
        <mj-column>
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" font-weight="700" color="#5b3a47" align="center" line-height="1.3" letter-spacing="2px" padding="0">SEU CUPOM</mj-text>
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="34px" font-weight="800" color="#1f1115" align="center" line-height="1.2" letter-spacing="4px" padding="10px 0 0">BEMVINDO20</mj-text>
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#5b3a47" align="center" line-height="1.6" padding="8px 0 0">Use na hora de finalizar a compra.</mj-text>
          <mj-button href="https://seusite.com.br" background-color="#be185d" color="#ffffff" font-family="Arial, Helvetica, sans-serif" font-size="16px" font-weight="700" line-height="20px" border-radius="8px" inner-padding="15px 32px" align="center" padding="24px 0 0">Usar meu cupom</mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section background-color="#ffffff" padding="8px 24px 32px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" color="#5b3a47" align="center" line-height="1.6" padding="0">Válido até 30/11. Não vale com outras promoções.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="8px 24px 16px" border-top="1px solid #f5d0e0">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="22px" font-weight="700" color="#1f1115" align="left" line-height="1.3" padding="0">Como usar</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 24px 16px">
      <mj-group>
        <mj-column width="10%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="24px" font-weight="800" color="#be185d" align="left" line-height="1.2" padding="0">1</mj-text>
        </mj-column>
        <mj-column width="90%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#1f1115" align="left" line-height="1.5" padding="2px 0 0">Escolha o que quiser.</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 24px 16px">
      <mj-group>
        <mj-column width="10%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="24px" font-weight="800" color="#be185d" align="left" line-height="1.2" padding="0">2</mj-text>
        </mj-column>
        <mj-column width="90%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#1f1115" align="left" line-height="1.5" padding="2px 0 0">Digite o cupom no fim da compra.</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0 24px 16px">
      <mj-group>
        <mj-column width="10%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="24px" font-weight="800" color="#be185d" align="left" line-height="1.2" padding="0">3</mj-text>
        </mj-column>
        <mj-column width="90%">
          <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#1f1115" align="left" line-height="1.5" padding="2px 0 0">Pronto. O desconto aparece na hora.</mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0">
      <mj-column>
        <mj-spacer height="24px"></mj-spacer>
      </mj-column>
    </mj-section>
    <mj-section css-class="footer-locked" background-color="#f4f4f4" padding="20px 16px"><mj-column><mj-text font-family="Arial, Helvetica, sans-serif" font-size="12px" color="#4b5563" align="center" line-height="1.6">Nome da sua empresa · Endereço da empresa<br/>Você recebeu este e-mail porque está em nossa lista de contatos.<br/><a href="{{ unsubscribe_url }}" style="color:#4b5563;text-decoration:underline;">Cancelar inscrição</a></mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
