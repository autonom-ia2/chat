<mjml>
  <mj-head>
    <mj-title>Em breve: algo novo está chegando</mj-title>
  </mj-head>
  <mj-body width="600px" background-color="#0b1736">
    <mj-section background-color="#0b1736" padding="22px 24px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="20px" font-weight="700" color="#ffffff" align="center" line-height="1.2" letter-spacing="1px" padding="0">Sua marca</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#0b1736" padding="40px 24px 48px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" font-weight="700" color="#f5b301" align="center" line-height="1.3" letter-spacing="2px" padding="0 0 12px">EM BREVE</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="38px" font-weight="800" color="#ffffff" align="center" line-height="1.2" padding="0">Algo novo está chegando.</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" color="#c9d3ea" align="center" line-height="1.6" padding="12px 0 0">{{ nome }}, você vai saber antes de todo mundo.</mj-text>
        <mj-divider border-color="#2a3a63" border-width="1px" padding="32px 0 24px"></mj-divider>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" font-weight="700" color="#c9d3ea" align="center" line-height="1.3" letter-spacing="2px" padding="0">DATA DE LANÇAMENTO</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="36px" font-weight="800" color="#f5b301" align="center" line-height="1.2" padding="8px 0 0">20 de novembro</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#eef1f8" padding="44px 24px">
      <mj-column>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="22px" font-weight="700" color="#0b1736" align="left" line-height="1.3" padding="0 0 24px">Por que entrar na lista</mj-text>
        <mj-divider border-color="#f5b301" border-width="4px" width="40px" align="left" padding="0 0 12px"></mj-divider>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" font-weight="700" color="#0b1736" align="left" line-height="1.3" padding="0">Acesso antes de todos</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#3b4766" align="left" line-height="1.6" padding="6px 0 28px">Você conhece primeiro, com calma.</mj-text>
        <mj-divider border-color="#f5b301" border-width="4px" width="40px" align="left" padding="0 0 12px"></mj-divider>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" font-weight="700" color="#0b1736" align="left" line-height="1.3" padding="0">Condição especial de estreia</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#3b4766" align="left" line-height="1.6" padding="6px 0 28px">Só para quem estiver na lista.</mj-text>
        <mj-divider border-color="#f5b301" border-width="4px" width="40px" align="left" padding="0 0 12px"></mj-divider>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="18px" font-weight="700" color="#0b1736" align="left" line-height="1.3" padding="0">Aviso no dia certo</mj-text>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="16px" color="#3b4766" align="left" line-height="1.6" padding="6px 0 0">A gente lembra você. Sem precisar anotar.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-button href="https://seusite.com.br" background-color="#f5b301" color="#0b1736" font-family="Arial, Helvetica, sans-serif" font-size="16px" font-weight="700" line-height="20px" border-radius="8px" inner-padding="15px 32px" align="center" padding="0">Quero ser avisado</mj-button>
        <mj-text font-family="Arial, Helvetica, sans-serif" font-size="15px" color="#3b4766" align="center" line-height="1.6" padding="16px 0 0">É grátis. Você pode sair da lista quando quiser.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section css-class="footer-locked" background-color="#f4f4f4" padding="20px 16px"><mj-column><mj-text font-family="Arial, Helvetica, sans-serif" font-size="12px" color="#4b5563" align="center" line-height="1.6">Nome da sua empresa · Endereço da empresa<br/>Você recebeu este e-mail porque está em nossa lista de contatos.<br/><a href="{{ unsubscribe_url }}" style="color:#4b5563;text-decoration:underline;">Cancelar inscrição</a></mj-text></mj-column></mj-section>
  </mj-body>
</mjml>
